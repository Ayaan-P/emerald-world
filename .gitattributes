*.pal text eol=crlf
*.sh text eol=lf
*.s text eol=lf
*.txt text eol=lf
Makefile text eol=lf
*.mk text eol=lf
*.c text eol=lf
*.h text eol=lf
*.pl text eol=lf
*.inc text eol=lf
*.sha1 text eol=lf
*.json text eol=lf
*.sed text eol=lf
*.cpp text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.hpp text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.yml text eol=lf

*.png binary
*.bin binary

*.h linguist-language=C
*.inc linguist-language=Assembly

# Pinned DexNav inputs retain upstream bytes across checkout on every host.
vendor/expansion-dexnav/upstream/** -text whitespace=-blank-at-eol
graphics/dexnav/*.pal -text
graphics/field_effects/palettes/cave_dust.pal -text
graphics/text_window/dexnav_pal.pal -text

# Unified patches preserve upstream context indentation and blank-line spaces.
# Check the applied engine source separately for newly introduced whitespace.
port/kanto-on-rc9/*.patch whitespace=-space-before-tab,-blank-at-eol
