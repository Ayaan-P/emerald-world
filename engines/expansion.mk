WORLD_CHARACTER_CAPTURE_EXPERIMENT ?= 0
# Run in the pinned donor directory; this integration may live elsewhere.
EW_INTEGRATION_DIR := $(dir $(realpath $(lastword $(MAKEFILE_LIST))))
EW_ROOT := $(abspath $(EW_INTEGRATION_DIR)/..)
# Propagate the exact same feature cohort to recursive pointer4 reference builds.
# Appending CPPFLAGS only after inclusion leaves the ABI checker comparing two
# different games (vanilla scripts against world scripts).
# Connected-place admission is opt-in until full native acceptance.
GENERATED_WORLD_REGIONS ?= 0
EW_REGION_STATE ?= 1
EW_KANTO_CONTENT ?= 1
MAP_VERSION ?= combined
EW_REGIONAL_COMPLETION ?= 0
EW_REGIONAL_BADGES ?= 0
EW_REGIONAL_STARTERS ?= 0
EW_KANTO_REMATCHES ?= 0
EW_ROUTE5_CUSTODY ?= 0
export NATIVE_EXTRA_CPPFLAGS := -DGENERATED_WORLD_REGIONS=$(GENERATED_WORLD_REGIONS) -DPORTABLE=1 -DCOOP_FULL_SIX_READY=1 -DGENERATED_MAP_READY=1 -DGENERATED_MAP_AUTOTILE=1 -DGENERATED_MAP_LARGE=1 -DGENERATED_MAP_WILDS=1 -DGENERATED_CAVE_PROFILES=1 -DGENERATED_CAVE_BIOMES=1 -DGENERATED_CAVE_WILDLIFE=1 -DWORLD_EXTENDED_OBJECTS=1 -DWORLD_EXTENDED_SPRITES=1 -DWORLD_NATIVE_OAM=1 -DWORLD_NATIVE_TILEBANK=1 -DWORLD_MATCHED_TRAINERS=1 -DWORLD_SMOOTH_PRESENCE=1 -DGENERATED_WILDS_GUIDE=1 -DGENERATED_WILDS_CAST=1 -DGENERATED_WILDS_EVENTS=1 -DGENERATED_WORLD_XL=1 -DGENERATED_WILDS_SHARED_TERRAIN=1 -DGENERATED_WILDS_SHARED_GEOMETRY=1 -DGENERATED_WILDS_LARGE_TERRAIN=1
# Experimental recovery and its complete nested regional reader cohort.
EW_ROXANNE_CONTINUATION ?= 0
EW_BIRCH_RESEARCH ?= 0
EW_HOENN_MARKETS ?= 0
EW_SHARED_CONTEST ?= 0
EW_SHARED_STRENGTH ?= 0
export NATIVE_EXTRA_CPPFLAGS += -DEW_BIRCH_RESEARCH=$(EW_BIRCH_RESEARCH) -DEW_HOENN_MARKETS=$(EW_HOENN_MARKETS) -DEW_SHARED_CONTEST=$(EW_SHARED_CONTEST) -DEW_SHARED_STRENGTH=$(EW_SHARED_STRENGTH) -DEW_REGION_STATE=$(EW_REGION_STATE) -DEW_KANTO_CONTENT=$(EW_KANTO_CONTENT)
EW_COOP_TURN_PLAN ?= 0
EW_COOP_HOLD_BACK ?= 0
EW_DUAL_TRAINERS ?= 0
EW_COOP_DISCOVERY ?= 0
EW_COOP_RETREAT ?= 0
EW_SHARED_CUT ?= 0
EW_COOP_PREPARATION ?= 0
EW_PARTNER_MEDICINE ?= 0
EW_TRAINER_CHOICE ?= 0
EW_WOODS_CONTINUATION ?= 0
EW_RUSTURF_RECOVERY ?= 0
export NATIVE_EXTRA_CPPFLAGS += -DEW_COOP_TURN_PLAN=$(EW_COOP_TURN_PLAN) -DEW_COOP_HOLD_BACK=$(EW_COOP_HOLD_BACK) -DEW_DUAL_TRAINERS=$(EW_DUAL_TRAINERS) -DEW_COOP_DISCOVERY=$(EW_COOP_DISCOVERY) -DEW_COOP_RETREAT=$(EW_COOP_RETREAT) -DEW_SHARED_CUT=$(EW_SHARED_CUT) -DEW_COOP_PREPARATION=$(EW_COOP_PREPARATION) -DEW_PARTNER_MEDICINE=$(EW_PARTNER_MEDICINE) -DEW_TRAINER_CHOICE=$(EW_TRAINER_CHOICE) -DEW_WOODS_CONTINUATION=$(EW_WOODS_CONTINUATION) -DEW_ROXANNE_CONTINUATION=$(EW_ROXANNE_CONTINUATION) -DEW_RUSTURF_RECOVERY=$(EW_RUSTURF_RECOVERY) -DEW_REGIONAL_BADGES=$(EW_REGIONAL_BADGES) -DEW_REGIONAL_COMPLETION=$(EW_REGIONAL_COMPLETION) -DEW_ROUTE5_CUSTODY=$(EW_ROUTE5_CUSTODY) -DEW_KANTO_REMATCHES=$(EW_KANTO_REMATCHES) -DEW_REGIONAL_STARTERS=$(EW_REGIONAL_STARTERS)
include Makefile.native
WORLD_NATURE_CHALLENGES ?= 0
export NATIVE_EXTRA_CPPFLAGS += -DWORLD_NATURE_CHALLENGES=$(WORLD_NATURE_CHALLENGES)
WORLD_TRADE_OFFERS ?= 0
export NATIVE_EXTRA_CPPFLAGS += -DWORLD_TRADE_OFFERS=$(WORLD_TRADE_OFFERS)
WORLD_FLOORPLANS ?= 0
export NATIVE_EXTRA_CPPFLAGS += -DWORLD_FLOORPLANS=$(WORLD_FLOORPLANS)
WORLD_COMBINED_PRESENCE ?= 0
export NATIVE_EXTRA_CPPFLAGS += -DWORLD_COMBINED_PRESENCE=$(WORLD_COMBINED_PRESENCE)
# A relocated multilib sysroot does not contain the host's SDL dependencies.
# Resolve those at link time only; do not bake a private runtime search path.
NATIVE_LDFLAGS += -Wl,--defsym=gba_native_vram_size=0x20000 -Wl,-rpath-link,/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/pulseaudio

# Offline first-throw experiment only. Requires separate exact-binary linked QA.
export NATIVE_EXTRA_CPPFLAGS += -DWORLD_CHARACTER_CAPTURE_EXPERIMENT=$(WORLD_CHARACTER_CAPTURE_EXPERIMENT)

