+void WorldCoop_ApplyPublicBattleController(u8 battler, u8 sender, const u8 *data, u16 size)
+{
+    struct BattlePokemon *mon;
+    u8 slot, request;
+    u16 value;
+    if (sCoop.state != COOP_BATTLE || sCoop.generation != NativeLink_Generation()
+     || sCoop.publicBattleGeneration != sCoop.generation || sCoop.local != 1 || sender != 0
+     || battler >= MAX_BATTLERS_COUNT
+     || data == NULL || size < 3)
+        return;
+    if (data[0] == CONTROLLER_GETMONDATA)
+    {
+        if (data[1] == REQUEST_ALL_BATTLE)
+        {
+            u8 mask = data[2];
+            u8 requestedSlot = gBattlerPartyIndexes[battler];
+            if (mask != 0)
+            {
+                if (mask & (mask - 1)) return;
+                requestedSlot = 0;
+                while (!(mask & 1)) { mask >>= 1; requestedSlot++; }
+            }
+            if (requestedSlot < PARTY_SIZE && requestedSlot == gBattlerPartyIndexes[battler])
+            {
+                sCoop.publicBattlePendingPartyIndex[battler] = requestedSlot;
+                sCoop.publicBattleSnapshotPending[battler] = TRUE;
+                sCoop.publicBattleReady[battler] = FALSE;
+            }
+        }
+        return;
+    }
+    if (!sCoop.publicBattleReady[battler] || data[0] != CONTROLLER_SETMONDATA)
+        return;
+    slot = gBattlerPartyIndexes[battler];
+    if (slot >= PARTY_SIZE || (data[2] && !(data[2] & (1u << slot))))
+        return;
+    request = data[1];
+    mon = &gBattleMons[battler];
+    switch (request)
+    {
+    case REQUEST_ALL_BATTLE:
+        if (size == 3 + sizeof(*mon))
+        {
+            struct BattlePokemon update;
+            memcpy(&update, data + 3, sizeof(update));
+            if (WorldCoop_PublicBattleMonValid(&update))
+            {
+                /* Keep volatile battle state; the data-transfer snapshot owns
+                 * canonical defaults, while this is an ordered party delta. */
+                enum Species oldSpecies = mon->species;
+                u8 oldAbilityNum = mon->abilityNum;
+                mon->species = update.species;
+                mon->item = update.item;
+                mon->abilityNum = update.abilityNum;
+                mon->hp = update.hp;
+                mon->maxHP = update.maxHP;
+                mon->status1 = update.status1;
+                mon->level = update.level;
+                mon->attack = update.attack; mon->defense = update.defense;
+                mon->speed = update.speed; mon->spAttack = update.spAttack;
+                mon->spDefense = update.spDefense;
+                memcpy(mon->moves, update.moves, sizeof(mon->moves));
+                memcpy(mon->pp, update.pp, sizeof(mon->pp));
+                if (oldSpecies != update.species || oldAbilityNum != update.abilityNum)
+                {
+                    mon->types[0] = GetSpeciesType(mon->species, 0);
+                    mon->types[1] = GetSpeciesType(mon->species, 1);
+                    mon->types[2] = TYPE_MYSTERY;
+                    mon->ability = GetAbilityBySpecies(mon->species, mon->abilityNum);
+                }
+            }
+        }
+        break;
+    case REQUEST_SPECIES_BATTLE:
+    case REQUEST_HELDITEM_BATTLE:
+    case REQUEST_MOVE1_BATTLE: case REQUEST_MOVE2_BATTLE:
+    case REQUEST_MOVE3_BATTLE: case REQUEST_MOVE4_BATTLE:
+    case REQUEST_HP_BATTLE: case REQUEST_MAX_HP_BATTLE:
+    case REQUEST_ATK_BATTLE: case REQUEST_DEF_BATTLE:
+    case REQUEST_SPEED_BATTLE: case REQUEST_SPATK_BATTLE: case REQUEST_SPDEF_BATTLE:
+        if (size < 5) return;
+        value = data[3] | (data[4] << 8);
+        if (request == REQUEST_SPECIES_BATTLE)
+        {
+            if (value == SPECIES_NONE || value >= NUM_SPECIES) return;
+            mon->species = value;
+            mon->types[0] = GetSpeciesType(value, 0);
+            mon->types[1] = GetSpeciesType(value, 1);
+            mon->types[2] = TYPE_MYSTERY;
+            mon->ability = GetAbilityBySpecies(value, mon->abilityNum);
+        }
+        else if (request == REQUEST_HELDITEM_BATTLE)
+        {
+            if (value >= ITEMS_COUNT) return;
+            mon->item = value;
+        }
+        else if (request >= REQUEST_MOVE1_BATTLE && request <= REQUEST_MOVE4_BATTLE)
+        {
+            u8 index = request - REQUEST_MOVE1_BATTLE;
+            if (value >= MOVES_COUNT) return;
+            mon->moves[index] = value;
+        }
+        else if (request == REQUEST_HP_BATTLE) { if (value > mon->maxHP) return; mon->hp = value; }
+        else if (request == REQUEST_MAX_HP_BATTLE) { if (value < mon->hp) return; mon->maxHP = value; }
+        else if (request == REQUEST_ATK_BATTLE) mon->attack = value;
+        else if (request == REQUEST_DEF_BATTLE) mon->defense = value;
+        else if (request == REQUEST_SPEED_BATTLE) mon->speed = value;
+        else if (request == REQUEST_SPATK_BATTLE) mon->spAttack = value;
+        else if (request == REQUEST_SPDEF_BATTLE) mon->spDefense = value;
+        break;
+    case REQUEST_MOVES_PP_BATTLE:
+        if (size < 3 + sizeof(struct MovePPInfo)) return;
+        memcpy(mon->moves, data + 3, sizeof(mon->moves));
+        memcpy(mon->pp, data + 3 + sizeof(mon->moves), sizeof(mon->pp));
+        break;
+    case REQUEST_PP_DATA_BATTLE:
+        if (size < 3 + MAX_MON_MOVES + 1) return;
+        memcpy(mon->pp, data + 3, sizeof(mon->pp));
+        break;
+    case REQUEST_PPMOVE1_BATTLE: case REQUEST_PPMOVE2_BATTLE:
+    case REQUEST_PPMOVE3_BATTLE: case REQUEST_PPMOVE4_BATTLE:
+        if (size < 4) return;
+        mon->pp[request - REQUEST_PPMOVE1_BATTLE] = data[3];
+        break;
+    case REQUEST_STATUS_BATTLE:
+        if (size < 7) return;
+        mon->status1 = (u32)data[3] | ((u32)data[4] << 8) | ((u32)data[5] << 16) | ((u32)data[6] << 24);
+        break;
+    case REQUEST_LEVEL_BATTLE:
+        if (size < 4 || !data[3] || data[3] > MAX_LEVEL) return;
+        mon->level = data[3];
+        break;
+    default:
+        break;
+    }
+}
