+static int sync_chat_layout(void)
+{
+    const unsigned chat = chat_height();
+    if (chat == state.chat_height)
+        return 0;
+
+    const unsigned old_logical_height = VIDEO_HEIGHT + state.chat_height;
+    const unsigned new_logical_height = VIDEO_HEIGHT + chat;
+    const Uint32 flags = SDL_GetWindowFlags(state.window);
+    const bool fullscreen = (flags & (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_FULLSCREEN_DESKTOP)) != 0;
+    int window_width = 0, window_height = 0;
+    if (!fullscreen)
+        SDL_GetWindowSize(state.window, &window_width, &window_height);
+
+    if (SDL_RenderSetLogicalSize(state.renderer, (int)VIDEO_WIDTH, (int)new_logical_height) != 0)
+        return sdl_error("SDL_RenderSetLogicalSize(chat layout)");
+
+    if (!fullscreen) {
+        unsigned scale_x = window_width > 0 ? (unsigned)window_width / VIDEO_WIDTH : 1;
+        unsigned scale_y = window_height > 0 ? (unsigned)window_height / old_logical_height : 1;
+        unsigned scale = scale_x < scale_y ? scale_x : scale_y;
+        if (scale == 0) scale = 1;
+        const int resized_height = window_height + ((int)chat - (int)state.chat_height) * (int)scale;
+        SDL_SetWindowSize(state.window, window_width, resized_height);
+    }
+    state.chat_height = chat;
+    return 0;
