+
+static void NativeBattle_RecordStateRequest(enum BattlerId battler, u8 sender,
+                                           const u8 *data, u16 size)
+{
+    u8 mask, slot;
+    if (!NativeBattle_IsStateGuest() || sender != 0
+     || sNativePublicGeneration != NativeLink_Generation()
+     || battler >= gBattlersCount || battler >= MAX_BATTLERS_COUNT
+     || size < 3 || data[0] != CONTROLLER_GETMONDATA
+     || data[1] != REQUEST_ALL_BATTLE)
+        return;
+    mask = data[2];
+    slot = gBattlerPartyIndexes[battler];
+    if (mask)
+    {
+        if (mask & (mask - 1))
+            return;
+        slot = 0;
+        while (!(mask & 1)) { mask >>= 1; ++slot; }
+        /* A reserve query must not replace the visible active battler. */
+        if (slot != gBattlerPartyIndexes[battler])
+            return;
+    }
+    if (slot >= PARTY_SIZE)
+        return;
+    sNativePublicPartyIndex[battler] = slot;
+    sNativePublicPending |= 1u << battler;
+    sNativePublicReady &= ~(1u << battler);
+}
+
+static int NativeBattle_ApplyStateResponse(enum BattlerId battler, u8 sender,
