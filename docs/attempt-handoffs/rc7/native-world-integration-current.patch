+    const struct ObjectEvent *player = NULL;
+    bool overworld = gMain.callback1 == CB1_Overworld && gMain.callback2 == CB2_Overworld;
+    bool locked = ArePlayerFieldControlsLocked();
+    bool script = ScriptContext_IsEnabled();
+    bool battle = gMain.inBattle;
+    bool fade = gPaletteFade.active;
+
+    if (inspect_get("callback2", callback, sizeof callback) != 0) strcpy(callback, "unknown");
+    if (inspect_get("battle_main", battle_main, sizeof battle_main) != 0) strcpy(battle_main, "unknown");
+    if (inspect_get("map_name", map_name, sizeof map_name) != 0) strcpy(map_name, "unknown");
+    if (inspect_get("task_count", value, sizeof value) == 0)
+        task_count = player_control_decimal(value, NUM_TASKS, 0);
+    if (inspect_get("party_count", value, sizeof value) == 0)
+        party_count = player_control_decimal(value, PARTY_SIZE, 0);
+    if (inspect_get("party0_species", value, sizeof value) == 0)
+        party_species = player_control_decimal(value, NUM_SPECIES - 1, 0);
+    if (inspect_get("party0_name", party_name, sizeof party_name) != 0) strcpy(party_name, "none");
+    if (gSaveBlock1Ptr) {
+        map_group = gSaveBlock1Ptr->location.mapGroup;
+        map_num = gSaveBlock1Ptr->location.mapNum;
+        pos_x = gSaveBlock1Ptr->pos.x;
+        pos_y = gSaveBlock1Ptr->pos.y;
+    }
+    if (gSaveBlock1Ptr && gPlayerAvatar.objectEventId < OBJECT_EVENTS_COUNT
