+        player ? player->facingDirection : 0,
+        player && gPlayerAvatar.tileTransitionState == T_TILE_TRANSITION
+            ? "true" : "false");
+    WorldBridge_WriteJSON(out, frame);
+    fputs(",\"activity\":{\"phase\":", out);
