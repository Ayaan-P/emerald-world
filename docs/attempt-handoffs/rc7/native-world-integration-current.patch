+bool8 WorldCoop_PublicBattleReady(u8 battler)
+{
+    u8 target;
+    if (sCoop.state != COOP_BATTLE || sCoop.local != 1 || battler != sCoop.local * 2)
+        return TRUE;
+    if (sCoop.generation != NativeLink_Generation()
+     || sCoop.publicBattleGeneration != sCoop.generation)
+        return FALSE;
+    for (target = 0; target < MAX_BATTLERS_COUNT; ++target)
+        if (!(gAbsentBattlerFlags & (1u << target)) && !sCoop.publicBattleReady[target])
+            return FALSE;
+    return TRUE;
+}
