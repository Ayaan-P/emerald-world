+    fputs(",\"map_name\":", out);
+    player_control_json_string(out, map_name);
+    fprintf(out, ",\"map\":[%d,%d],\"pos\":[%d,%d],\"task_count\":%u,\"party_count\":%u,\"party0_species\":%u,\"party0_name\":",
