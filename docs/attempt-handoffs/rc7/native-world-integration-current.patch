+    u8 partnerSpriteId = gBattlerSpriteIds[partnerBattler];
+    u8 shadowSpriteId = gBattleSpritesDataPtr->healthBoxesData[partnerBattler].shadowSpriteIdPrimary;
+    u8 secondaryShadowSpriteId = gBattleSpritesDataPtr->healthBoxesData[partnerBattler].shadowSpriteIdSecondary;
+
+    // Each client keeps only its own co-op battler visible for private rewards.
+    if (partnerSpriteId < MAX_SPRITES)
+        gSprites[partnerSpriteId].invisible = TRUE;
+    if (shadowSpriteId < MAX_SPRITES)
+        gSprites[shadowSpriteId].invisible = TRUE;
+    if (secondaryShadowSpriteId < MAX_SPRITES)
+        gSprites[secondaryShadowSpriteId].invisible = TRUE;
+    gBattlerSpriteIds[0] = gBattlerSpriteIds[localBattler];
