+static bool player_control_screenshot(FILE *out)
+{
+    const uint16_t *pixels = frame_pixels();
+    if (fprintf(out, "P6\n240 160\n255\n") < 0) return false;
+    for (size_t i = 0; i < 240u * 160u; ++i) {
+        const uint16_t pixel = pixels[i];
+        const unsigned r = pixel & 31u;
+        const unsigned g = (pixel >> 5) & 31u;
+        const unsigned b = (pixel >> 10) & 31u;
+        const unsigned char rgb[3] = {
+            (unsigned char)((r << 3) | (r >> 2)),
+            (unsigned char)((g << 3) | (g >> 2)),
+            (unsigned char)((b << 3) | (b >> 2)),
+        };
+        if (fwrite(rgb, 1, sizeof rgb, out) != sizeof rgb) return false;
+    }
+    return !ferror(out);
+}
