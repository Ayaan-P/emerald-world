+void BattleRebuildPrivateRewardHealthbox(void)
+{
+    u8 battler;
+
+    // The shared co-op battle always allocated four double-format battlers.
+    // Retire each composite (including its Expansion gimmick indicator) before
+    // releasing its tagged sheets; then rebuild the local, single-battle HUD.
+    for (battler = 0; battler < MAX_BATTLERS_COUNT; battler++)
+    {
+        HidePrivateRewardShadows(battler);
+        DestroyHealthboxSprite(gHealthboxSpriteIds[battler]);
+        gHealthboxSpriteIds[battler] = MAX_SPRITES;
+    }
+
+    FreeSpriteTilesByTag(TAG_HEALTHBOX_PLAYER1_TILE);
+    FreeSpriteTilesByTag(TAG_HEALTHBOX_PLAYER2_TILE);
+    FreeSpriteTilesByTag(TAG_HEALTHBOX_OPPONENT1_TILE);
+    FreeSpriteTilesByTag(TAG_HEALTHBOX_OPPONENT2_TILE);
+    FreeSpriteTilesByTag(TAG_HEALTHBAR_PLAYER1_TILE);
+    FreeSpriteTilesByTag(TAG_HEALTHBAR_PLAYER2_TILE);
+    FreeSpriteTilesByTag(TAG_HEALTHBAR_OPPONENT1_TILE);
+    FreeSpriteTilesByTag(TAG_HEALTHBAR_OPPONENT2_TILE);
+
+    LoadCompressedSpriteSheet(&sSpriteSheet_SinglesPlayerHealthbox);
+#if B_HP_PERCENTAGE_DISPLAY
+    LoadCompressedSpriteSheet(&sSpriteSheet_SinglesOpponentLargeHealthbox);
+#else
+    LoadCompressedSpriteSheet(&sSpriteSheet_SinglesOpponentHealthbox);
+#endif
+    LoadCompressedSpriteSheet(&sSpriteSheets_HealthBar[B_POSITION_PLAYER_LEFT]);
+    LoadCompressedSpriteSheet(&sSpriteSheets_HealthBar[B_POSITION_OPPONENT_LEFT]);
+
+    HidePrivateRewardBattler(3);
+    PositionPrivateRewardBattler(0);
+    PositionPrivateRewardBattler(1);
+
+    gHealthboxSpriteIds[0] = CreateBattlerHealthboxSprites(0);
+    gHealthboxSpriteIds[1] = CreateBattlerHealthboxSprites(1);
+    if (gHealthboxSpriteIds[0] < MAX_SPRITES)
+        InitBattlerHealthboxCoords(0);
+    if (gHealthboxSpriteIds[1] < MAX_SPRITES)
+        InitBattlerHealthboxCoords(1);
+    BattleUpdatePrivateRewardHealthboxes();
+    if (gHealthboxSpriteIds[0] < MAX_SPRITES)
+        SetHealthboxSpriteVisible(gHealthboxSpriteIds[0]);
+    if (gHealthboxSpriteIds[1] < MAX_SPRITES)
