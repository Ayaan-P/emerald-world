+static void NativeBattle_RecordStateRequest(enum BattlerId battler, u8 sender,
+                                           const u8 *data, u16 size)
+{
+    u8 mask, slot;
+    if (!NativeBattle_IsStateGuest() || sender != 0
+     || sNativePublicGeneration != NativeLink_Generation()
+     || battler >= gBattlersCount || battler >= MAX_BATTLERS_COUNT
+     || size < 3 || data[0] != CONTROLLER_GETMONDATA
+     || data[1] != REQUEST_ALL_BATTLE)
+        return;
+    mask = data[2];
+    slot = gBattlerPartyIndexes[battler];
+    if (mask)
+    {
+        if (mask & (mask - 1))
+            return;
+        slot = 0;
+        while (!(mask & 1)) { mask >>= 1; ++slot; }
+        /* A reserve query must not replace the visible active battler. */
+        if (slot != gBattlerPartyIndexes[battler])
+            return;
+    }
+    if (slot >= PARTY_SIZE)
+        return;
+    sNativePublicPartyIndex[battler] = slot;
+    sNativePublicPending |= 1u << battler;
+    sNativePublicReady &= ~(1u << battler);
+}
+
+static int NativeBattle_ApplyStateResponse(enum BattlerId battler, u8 sender,
+                                          const u8 *data, u16 size)
+{
+    struct BattlePokemon mon;
+    u16 bodySize;
+    u8 owner, move;
+    if (!NativeBattle_IsStateGuest()
+     || sNativePublicGeneration != NativeLink_Generation()
+     || battler >= gBattlersCount || battler >= MAX_BATTLERS_COUNT
+     || !(sNativePublicPending & (1u << battler))
+     || size < 4 || data[0] != CONTROLLER_DATATRANSFER
+     || data[1] != CONTROLLER_DATATRANSFER)
+        return 0;
+    owner = IsOnPlayerSide(battler) ? NativeLink_LocalId() : 0;
+    if (sender != owner)
+        return 0;
+    bodySize = data[2] | ((u16)data[3] << 8);
+    /* The local emitter is unpadded; the link emitter appends 1..4 bytes. */
+    if (bodySize != sizeof(mon) || size < bodySize + 4 || size > bodySize + 8)
+        return -1;
+    memcpy(&mon, data + 4, sizeof(mon));
+    if (mon.species <= SPECIES_NONE || mon.species >= NUM_SPECIES
+     || !mon.level || mon.level > MAX_LEVEL || mon.abilityNum >= NUM_ABILITY_SLOTS
+     || !mon.maxHP || mon.hp > mon.maxHP || mon.item >= ITEMS_COUNT
+     || (mon.status1 & ~(STATUS1_ANY | STATUS1_TOXIC_COUNTER)))
+        return -1;
