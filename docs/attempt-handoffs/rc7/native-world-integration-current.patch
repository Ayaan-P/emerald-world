diff --git a/src/world/xl_progress_store.c b/src/world/xl_progress_store.c
new file mode 100644
index 0000000000..77e0cef4c4
--- /dev/null
+++ b/src/world/xl_progress_store.c
@@ -0,0 +1,63 @@
+#include "platform/xl_progress_store.h"
+#include <string.h>
+#if defined(PORTABLE) && !defined(_WIN32)
+#include "platform/native_save.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <errno.h>
+#define PAYLOAD_SIZE (1 + 64 * (6 + 64))
+#define HEADER_SIZE 12
+#define SNAPSHOT_SIZE (HEADER_SIZE + PAYLOAD_SIZE)
+static FILE *sFile;
+static unsigned char sJournal[2][SNAPSHOT_SIZE];
+static unsigned sCurrent;
+static uint32_t get32(const unsigned char *p){return (uint32_t)p[0]|((uint32_t)p[1]<<8)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24);}
+static void put32(unsigned char *p,uint32_t v){p[0]=v;p[1]=v>>8;p[2]=v>>16;p[3]=v>>24;}
+static uint32_t checksum(const unsigned char *p){uint32_t h=2166136261u;size_t i;for(i=0;i<SNAPSHOT_SIZE;i++)if(i<8||i>=12){h^=p[i];h*=16777619u;}return h;}
+static bool valid(const unsigned char *p){return !memcmp(p,"XLP2",4) && get32(p+8)==checksum(p);}
+void XLProgressStore_Close(void){if(sFile){fclose(sFile);sFile=NULL;}memset(sJournal,0,sizeof(sJournal));sCurrent=0;}
+bool XLProgressStore_Init(const char *savePath,bool enabled,void *payload,size_t size)
+{
+    char path[4096];struct stat info;bool a,b;
+    if(!enabled || !savePath || !payload || size!=PAYLOAD_SIZE || sFile)return false;
+    if(snprintf(path,sizeof(path),"%s.generated-story",savePath)>=(int)sizeof(path))return false;
+    sFile=NativeSave_Open(path);if(!sFile)return false;
+    if(fstat(fileno(sFile),&info)!=0 || (info.st_mode&077)!=0)goto fail;
+    memset(sJournal,0,sizeof(sJournal));sCurrent=0;
+    if(info.st_size==0){memset(payload,0,size);return true;}
+    if(info.st_size!=(off_t)sizeof(sJournal) || !NativeSave_Read(sFile,0,sJournal,sizeof(sJournal)))goto fail;
+    a=valid(sJournal[0]);b=valid(sJournal[1]);if(!a&&!b)goto fail;
+    sCurrent=b && (!a || (int32_t)(get32(sJournal[1]+4)-get32(sJournal[0]+4))>0);
+    memcpy(payload,sJournal[sCurrent]+HEADER_SIZE,size);return true;
+fail:
+    XLProgressStore_Close();return false;
+}
+static bool write_slot(unsigned slot,const unsigned char *data)
+{
+    size_t done=0;int fd=fileno(sFile);struct stat info;
+    if(fstat(fd,&info)!=0 || !S_ISREG(info.st_mode) || info.st_nlink!=1 || info.st_uid!=geteuid() || (info.st_mode&077)!=0)return false;
+    while(done<SNAPSHOT_SIZE){ssize_t n=pwrite(fd,data+done,SNAPSHOT_SIZE-done,(off_t)(slot*SNAPSHOT_SIZE+done));
+        if(n<0 && errno==EINTR)continue;
+        if(n<=0)return false;
+        done+=(size_t)n;
+    }
+    while(fsync(fd)!=0)if(errno!=EINTR)return false;
+    return true;
+}
+bool XLProgressStore_Save(const void *payload,size_t size)
+{
+    unsigned next;struct stat info;uint32_t sequence;
+    if(!sFile || !payload || size!=PAYLOAD_SIZE)return false;
+    if(fstat(fileno(sFile),&info)!=0 || (info.st_mode&077)!=0){XLProgressStore_Close();return false;}
+    next=sCurrent^1;sequence=valid(sJournal[sCurrent])?get32(sJournal[sCurrent]+4)+1:1;
+    memset(sJournal[next],0,SNAPSHOT_SIZE);memcpy(sJournal[next],"XLP2",4);put32(sJournal[next]+4,sequence);memcpy(sJournal[next]+HEADER_SIZE,payload,size);put32(sJournal[next]+8,checksum(sJournal[next]));
+    if(!write_slot(next,sJournal[next])){XLProgressStore_Close();return false;}
+    sCurrent=next;return true;
+}
+#else
+bool XLProgressStore_Init(const char *path,bool enabled,void *payload,size_t size){(void)path;(void)enabled;(void)payload;(void)size;return false;}
+bool XLProgressStore_Save(const void *payload,size_t size){(void)payload;(void)size;return false;}
+void XLProgressStore_Close(void){}
+#endif
diff --git a/tests/check_coop_private_completion_cleanup.py b/tests/check_coop_private_completion_cleanup.py
new file mode 100644
index 0000000000..b2f4a366f3
--- /dev/null
+++ b/tests/check_coop_private_completion_cleanup.py
@@ -0,0 +1,52 @@
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+WORLD = (ROOT / "src/world/world_coop.c").read_text()
+UTIL = (ROOT / "src/battle_util.c").read_text()
+
+
+def body(text: str, signature: str) -> str:
+    start = text.index(signature)
+    opening = text.index("{", start)
+    depth = 0
+    for end in range(opening, len(text)):
+        if text[end] == "{":
+            depth += 1
+        elif text[end] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[opening + 1:end]
+    raise AssertionError(f"unterminated function: {signature}")
+
+
+build = body(WORLD, "static bool8 BuildPrivateParty(")
+assert "RestoreCoopPrivatePartyMon(" in WORLD, "missing identity-checked private completion cleanup"
+cleanup = body(WORLD, "static bool8 RestoreCoopPrivatePartyMon(")
+method_guard = body(WORLD, "static bool8 IsBattleFormChangeMethod(")
+revert = body(UTIL, "bool32 TryRevertPartyMonFormChange(")
+
+completion = body(WORLD, "int WorldCoop_ReceiveCompletion(")
+ready = body(WORLD, "bool8 WorldCoop_ReadyForPrivateRewards(")
+assert "restoreItemMask" in WORLD, "completion handshake must carry host-owned item restore decisions"
+assert "lostItem->stolen || lostItem->restoreAfterBattle" in WORLD
+assert "peerRestoreItemMask" in completion
+assert "packet.restoreItemMask & ~((1 << MULTI_PARTY_SIZE) - 1)" in completion
+assert "packet.restoreItemMask != sCoop.peerRestoreItemMask" in completion
+assert "if (sCoop.local != 0 && !sCoop.peerReady)" in ready, "guest must wait for the master's restore decision"
+assert ready.index("if (sCoop.local != 0 && !sCoop.peerReady)") < ready.index("SendBlock("), "guest must apply host restore mask before its READY"
+
+identity = build.index("mon.box.personality != original->box.personality")
+restore = build.index("RestoreCoopPrivatePartyMon(")
+final_species_check = build.index("GetMonData(&mon, MON_DATA_SPECIES) != GetMonData(original, MON_DATA_SPECIES)")
+assert identity < restore < final_species_check, "validate identity, clean temporary state, then validate final species"
+assert "MonValid(&originalCopy, FALSE)" in cleanup, "original snapshot must be valid before it authorizes repair"
+assert "GetSpeciesFormChanges(originalSpecies)" in cleanup, "form cleanup must use the baseline species' source form table"
+assert "formChanges[i].targetSpecies == currentSpecies" in cleanup, "only a form reachable from this original is eligible"
+assert "TryRevertPartyMonFormChange" in cleanup, "reuse native battle-end cleanup for moves and derived stats"
+assert "B_RESTORE_HELD_BATTLE_ITEMS >= GEN_9 || B_TRAINERS_KNOCK_OFF_ITEMS" in cleanup
+assert "GetItemPocket(originalItem) != POCKET_BERRIES" in cleanup
+assert "FORM_CHANGE_BATTLE_GIGANTAMAX" in method_guard
+assert "FORM_CHANGE_BATTLE_TERASTALLIZATION" in method_guard
+assert "FORM_CHANGE_ITEM_HOLD" not in method_guard, "non-battle form changes must not be treated as temporary battle forms"
+assert "partyState[B_SIDE_PLAYER][partyIndex].changedSpecies" in revert
+print("private completion cleanup source-contract checks passed")
diff --git a/tests/rc8/generated_options_test.c b/tests/rc8/generated_options_test.c
new file mode 100644
index 0000000000..224fe9fba5
--- /dev/null
+++ b/tests/rc8/generated_options_test.c
@@ -0,0 +1,16 @@
+#include <assert.h>
+#include <string.h>
+#include "options.h"
+int main(void) {
+    struct options out;
+    char *normal[] = {"game", "--generated-map", "area.bin", "--generated-progress", "on"};
+    char *no_map[] = {"game", "--generated-progress", "on"};
+    char *off[] = {"game", "--generated-map", "area.bin", "--generated-progress", "off"};
+    char *bad[] = {"game", "--generated-progress", "maybe"};
+    assert(options_parse(5, normal, &out) == OPTIONS_OK);
+    assert(out.generated_progress && strcmp(out.generated_map_path, "area.bin") == 0);
+    assert(options_parse(3, no_map, &out) == OPTIONS_ERR_USAGE);
+    assert(options_parse(5, off, &out) == OPTIONS_OK && !out.generated_progress);
+    assert(options_parse(3, bad, &out) == OPTIONS_ERR_USAGE);
+    return 0;
+}
