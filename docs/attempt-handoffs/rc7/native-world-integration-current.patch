+static u32 sNativePublicGeneration;
+static u8 sNativePublicPending;
+static u8 sNativePublicReady;
+static u8 sNativePublicPartyIndex[MAX_BATTLERS_COUNT];
+
+static bool8 NativeBattle_IsStateGuest(void)
+{
+    return NativeLink_IsActive() && !WorldCoop_IsBattle()
+        && (gBattleTypeFlags & BATTLE_TYPE_LINK)
+        && !(gBattleTypeFlags & BATTLE_TYPE_IS_MASTER)
+        && NativeLink_LocalId() == 1;
