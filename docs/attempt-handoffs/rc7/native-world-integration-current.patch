+    if (battler >= gBattlersCount || sNativePublicGeneration != NativeLink_Generation())
+        return FALSE;
+    required = ((1u << gBattlersCount) - 1) & ~gAbsentBattlerFlags;
+    return (sNativePublicReady & required) == required;
+}
