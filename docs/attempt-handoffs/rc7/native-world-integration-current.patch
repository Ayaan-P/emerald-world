+    fputs(",\"map_name\":", out);
+    player_control_json_string(out, map_name);
+    fprintf(out, ",\"map\":[%d,%d],\"pos\":[%d,%d],\"task_count\":%u,\"party_count\":%u,\"party0_species\":%u,\"party0_name\":",
+            map_group, map_num, pos_x, pos_y, task_count, party_count, party_species);
+    player_control_json_string(out, party_name);
+    fputs(",\"party0_progress\":", out);
+    if (inspect_get("party0_progress", value, sizeof value) == 0)
