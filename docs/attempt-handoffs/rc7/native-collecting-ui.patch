 static bool8 DexNav_DoGfxSetup(void)
 {
     u8 taskId;

     switch (gMain.state)
     {
     case 0:
         SetVBlankHBlankCallbacksToNull();
         ClearScheduledBgCopiesToVram();
         gMain.state++;
         break;
     case 1:
         ScanlineEffect_Stop();
         gMain.state++;
         break;
     case 2:
         FreeAllSpritePalettes();
         gMain.state++;
         break;
     case 3:
         ResetPaletteFade();
         ResetSpriteData();
         ResetTasks();
         gMain.state++;
         break;
     case 4:
         if (DexNav_InitBgs())
         {
             sDexNavUiDataPtr->state = 0;
             gMain.state++;
         }
         else
         {
             DexNavFadeAndExit();
             return TRUE;
         }
         break;
     case 5:
         if (DexNav_LoadGraphics() == TRUE)
             gMain.state++;
         break;
     case 6:
         DexNav_InitWindows();
         sDexNavUiDataPtr->cursorRow = ROW_LAND_TOP;
         sDexNavUiDataPtr->cursorCol = 0;
         sDexNavUiDataPtr->environment = ENCOUNTER_TYPE_LAND;
         gMain.state++;
         break;
     case 7:
         PrintSearchableSpecies(VarGet(DN_VAR_SPECIES) & DEXNAV_MASK_SPECIES);
         DexNavLoadEncounterData();
         gMain.state++;
         break;
     case 8:
         taskId = CreateTask(Task_DexNavWaitFadeIn, 0);
         gTasks[taskId].tSpecies = 0;
         gTasks[taskId].tEnvironment = sDexNavUiDataPtr->environment;
         gMain.state++;
         break;
     case 9:
         sDexNavUiDataPtr->typeIconSpriteIds[0] = 0xFF;
         sDexNavUiDataPtr->typeIconSpriteIds[1] = 0xFF;
         CreateTypeIconSprites();
         gMain.state++;
         break;
     case 10:
         LoadMonIconPalettes();
         DrawSpeciesIcons();
         CreateSelectionCursor();
         DexNavLoadCapturedAllSymbols();
         gMain.state++;
         break;
     case 11:
         BlendPalettes(0xFFFFFFFF, 16, RGB_BLACK);
         gMain.state++;
         break;
     case 12:
         BeginNormalPaletteFade(0xFFFFFFFF, 0, 16, 0, RGB_BLACK);
         gMain.state++;
         break;
     default:
         SetVBlankCallback(DexNav_VBlankCB);
         SetMainCallback2(DexNav_MainCB);
         return TRUE;
     }

     return FALSE;
 }

 static void DexNav_RunSetup(void)
 {
 #if PLATFORM_NATIVE
     // On the GBA the VBlank interrupt drains the DMA3 queue while this loop spins on
     // IsDma3ManagerBusyWithBgCopy; natively a frame passes only in VBlankIntrWait.
     while (!DexNav_DoGfxSetup())
         VBlankIntrWait();
 #else
     while (!DexNav_DoGfxSetup()) {}
