+    sWorld.eventHead = sWorld.eventCount = 0; sWorld.eventSetSeq = 0;
+#endif
+#endif
+#endif
+#endif
+#endif
+#endif
+#endif
+    sWorld.caveState = CAVE_DISABLED;
