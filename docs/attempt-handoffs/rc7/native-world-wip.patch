+/* The RC7 wire protocol numbers selected allies in two three-slot ranges.
+ * Expansion's battle engine instead owns separate six-slot trainer parties.
+ * Translate at this boundary; never overlay the partner onto the private party. */
+static enum BattleTrainer StageTrainer(u8 stage)
+{
+    return stage / MULTI_PARTY_SIZE == sCoop.local ? B_TRAINER_PLAYER : B_TRAINER_PARTNER;
+}
+
+static struct Pokemon *StageMon(u8 stage)
+{
+    return &gParties[StageTrainer(stage)][stage % MULTI_PARTY_SIZE];
+}
+
+u8 WorldCoop_StageSlot(u8 battler)
+{
+    return (battler & BIT_SIDE) ? gBattlerPartyIndexes[battler]
+        : (battler / 2) * MULTI_PARTY_SIZE + gBattlerPartyIndexes[battler];
+}
+
+static u8 StagedKnockOffMask(void)
+{
+    u8 stage, result = 0;
+    for (stage = 0; stage < PARTY_SIZE; ++stage)
+        if (gBattleStruct->partyState[StageTrainer(stage)][stage % MULTI_PARTY_SIZE].isKnockedOff)
+            result |= 1u << stage;
+    return result;
+}
+
+static void SetStagedKnockOff(u8 stage, bool8 knockedOff)
+{
+    gBattleStruct->partyState[StageTrainer(stage)][stage % MULTI_PARTY_SIZE].isKnockedOff = knockedOff;
+}
