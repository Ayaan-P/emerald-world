+bool8 BattleSetup_CanShareWorldTrainerCredit(u16 trainerId)
+{
+    if (trainerId <= TRAINER_NONE || trainerId >= TRAINERS_COUNT)
+        return FALSE;
+
+    /* Gym teams (including rematches) and the League belong to the player
+     * whose script started the encounter. A guest must still beat their own
+     * boss, even when its local trainerbattle continuation is directly visible. */
+    switch (GetTrainerClassFromId(trainerId))
+    {
+    case TRAINER_CLASS_LEADER:
+    case TRAINER_CLASS_ELITE_FOUR:
+    case TRAINER_CLASS_CHAMPION:
+        return FALSE;
+    default:
+        return TRUE;
+    }
+}
+
+bool8 BattleSetup_ResumeWorldTrainerScript(u16 trainerId)
+{
+    u8 i;
+    if (!BattleSetup_CanShareWorldTrainerCredit(trainerId) || HasTrainerBeenFought(trainerId))
+        return FALSE;
+    /* Only a locally present, direct trainerbattle command can authorize a
+     * local story continuation. No script address is supplied by the peer.
+     * Conditional wrappers and remote-map scripts are deliberately not run. */
+    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+    {
+        const u8 *script;
+        TrainerBattleParameter candidate;
+        if (!gObjectEvents[i].active || gObjectEvents[i].isPlayer
+         || gObjectEvents[i].mapNum != gSaveBlock1Ptr->location.mapNum
+         || gObjectEvents[i].mapGroup != gSaveBlock1Ptr->location.mapGroup)
+            continue;
+        script = GetObjectEventScriptPointerByObjectEventId(i);
+        if (script == NULL || script[0] != 0x5C /* trainerbattle */
+         || (script[2] | ((u16)script[3] << 8)) != trainerId)
+            continue;
+        // Expansion uses a complete packed parameter record, not vanilla's
+        // variable-length trainer-mode byte. This is trusted local map data.
+        memcpy(candidate.data, script + TRAINERBATTLE_OPCODE_OFFSET, sizeof(candidate));
+        if (!candidate.params.continueScript || candidate.params.isRematch
+            || candidate.params.skipFlagCheck || candidate.params.opponentB
+            || candidate.params.battleScriptRetAddrA == NULL)
+            continue;
+        gApproachingTrainerId = gNoOfApproachingTrainers = 0;
+        gSelectedObjectEvent = i;
+        gSpecialVar_LastTalked = gObjectEvents[i].localId;
+        TrainerBattleLoadArgs(script + TRAINERBATTLE_OPCODE_OFFSET);
+        SetMapVarsToTrainerA();
+        if (TRAINER_BATTLE_PARAM.battleScriptRetAddrA == NULL)
+            return FALSE;
+        sNoOfPossibleTrainerRetScripts = 0;
+        sShouldCheckTrainerBScript = FALSE;
+        gWhichTrainerToFaceAfterBattle = 0;
+        RegisterTrainerInMatchCall();
+        SetTrainerFlag(trainerId);
+        ScriptContext_SetupScript(TRAINER_BATTLE_PARAM.battleScriptRetAddrA);
+        LockPlayerFieldControls();
+        FreezeObjectEvents();
+        SetMainCallback2(CB2_ReturnToFieldContinueScriptPlayMapMusic);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+void BattleSetup_RegisterWorldTrainerInMatchCall(u16 trainerId)
+{
+    /* A guest without a recognized story continuation still defeated this
+     * trainer locally. Never borrow the owner's selected trainer context. */
+    if (BattleSetup_CanShareWorldTrainerCredit(trainerId) && FlagGet(FLAG_HAS_MATCH_CALL))
+    {
+        u32 matchCallFlagId = GetTrainerMatchCallFlag(trainerId);
+        if (matchCallFlagId != 0xFFFF)
+            FlagSet(matchCallFlagId);
+    }
+}
+
+void BattleSetup_EndWorldWildBattle(void)
+{
+    unsigned i;
+    /* A shared victory does not prevent a private whiteout when this trainer
+     * has no usable Pokemon. Do not change the partner's battle result. */
+    for (i = 0; i < PARTY_SIZE; ++i)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES)
+            && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG)
+            && GetMonData(&gPlayerParty[i], MON_DATA_HP)) break;
+    if (i == PARTY_SIZE) SetMainCallback2(CB2_WhiteOut);
+    else CB2_EndWildBattle();
+}
+
+void BattleSetup_RecordWorldTrainerBattle(void)
+{
+    IncrementGameStat(GAME_STAT_TOTAL_BATTLES);
+    IncrementGameStat(GAME_STAT_TRAINER_BATTLES);
+    TryUpdateGymLeaderRematchFromTrainer();
+}
+
+void BattleSetup_RecordWorldWildBattle(void)
+{
+    IncrementGameStat(GAME_STAT_TOTAL_BATTLES);
+    IncrementGameStat(GAME_STAT_WILD_BATTLES);
+    IncrementDailyWildBattles();
+    TryUpdateGymLeaderRematchFromWild();
+}
