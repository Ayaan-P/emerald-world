+    WORLD_RALLY_FAIL };
+struct WorldRallyMember { char name[25]; unsigned state, slot; };
+struct WorldRallySnapshot {
+    unsigned id, phase, scene, scope, count;
+    char owner[25];
+    struct WorldRallyMember members[WORLD_RALLY_ROSTER];
