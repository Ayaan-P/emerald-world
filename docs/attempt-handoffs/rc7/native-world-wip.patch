 /* GBATEK "GBA Memory Map", External Memory: 0E000000-0E00FFFF "Game Pak SRAM
  * (max 64 KBytes)", the window the cartridge's backup chip answers in.
diff --git a/platform/gba_regions.ld b/platform/gba_regions.ld
index e37b44579d..d0063e495c 100644
--- a/platform/gba_regions.ld
+++ b/platform/gba_regions.ld
@@ -18,6 +18,8 @@
  * GNU ld sorts the segments by address, so the ELF and program headers end up
  * in the page below EWRAM (0x01FFF000), in GBATEK's unused 0x00004000-0x01FFFFFF.
  */
+/* RC7 may select a larger, checked native OBJ tile bank at link time. */
+PROVIDE(gba_native_vram_size = 0x18000);
 SECTIONS
 {
     HIDDEN(gba_regions_saved_dot = .);
@@ -101,7 +103,7 @@ SECTIONS
     .gba_vram 0x06000000 (NOLOAD) :
     {
         gba_linked_vram_start = .;
-        . += 0x18000;
+        . += gba_native_vram_size;
