+    WORLD_RALLY_ACTIVE, WORLD_RALLY_RETURN };
+enum WorldRallyMemberState { WORLD_RALLY_INVITED = 1, WORLD_RALLY_READY,
+    WORLD_RALLY_NOT_YET, WORLD_RALLY_MOVING, WORLD_RALLY_ARRIVED,
