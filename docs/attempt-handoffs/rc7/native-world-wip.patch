+    sLink.tagRange = 0;
+    memset(&sLink.tagPending, 0, sizeof(sLink.tagPending));
+}
+
+static int Identifier(const char *p)
+{
+    size_t n = 0;
+    if (!p || !*p) return 0;
+    for (; *p; p++, n++)
+        if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z')
+           || (*p >= '0' && *p <= '9') || *p == '_' || *p == '-')) return 0;
+    return n <= 24;
+}
+static int Decimal(const char *p, uint64_t max, uint64_t *value)
+{
+    uint64_t n = 0;
+    if (!*p) return 0;
+    for (; *p; p++) {
+        unsigned digit = (unsigned char)*p - '0';
+        if (digit > 9 || n > (max - digit) / 10 || digit > max) return 0;
+        n = n * 10 + digit;
+    }
+    *value = n;
+    return 1;
+}
+static int Hex(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    return -1;
+}
+static int Token(const char *p)
+{
+    unsigned i;
+    if (strlen(p) != 64) return 0;
+    for (i = 0; i < 64; i++)
+        if (Hex(p[i]) < 0 && !(p[i] >= 'A' && p[i] <= 'F')) return 0;
+    return 1;
+}
+static int SocketOpen(void)
+{
+#ifdef _WIN32
+    return sLink.initialized && sLink.fd != INVALID_SOCKET;
+#else
+    return sLink.initialized && sLink.fd >= 0;
+#endif
+}
+static void Disconnect(void)
+{
+    if (SocketOpen()) {
+#ifdef _WIN32
+        closesocket(sLink.fd);
+#else
+        close(sLink.fd);
+#endif
+    }
+#ifdef _WIN32
+    sLink.fd = INVALID_SOCKET;
+#else
+    sLink.fd = -1;
+#endif
+    sLink.enabled = sLink.ready = sLink.connecting = 0;
+    sLink.queued = sLink.sent = sLink.used = 0;
+    NativeLink_EndSession(sLink.session);
+    sLink.session = sLink.accepting = 0;
+    sLink.offered = 0;
+    sLink.mode = sLink.slot = 0;
+    sLink.coopOwner = 0;
+    ClearTag();
+    memset(&sLink.pending, 0, sizeof(sLink.pending));
+}
+void LinkTransport_Close(void)
+{
+    if (!sLink.initialized) return;
+    Disconnect();
+    NativeLink_Init(NULL, NULL);
+#ifdef _WIN32
+    if (sLink.winsock) WSACleanup();
+#endif
+    memset(&sLink, 0, sizeof(sLink));
+}
+static int Queue(const char *line)
+{
+    size_t n = strlen(line), remaining = sLink.queued - sLink.sent;
+    if (n > QUEUE_CAP - remaining) return 0;
+    if (sLink.sent) memmove(sLink.output, sLink.output + sLink.sent, remaining);
+    sLink.sent = 0;
+    memcpy(sLink.output + remaining, line, n);
+    sLink.queued = remaining + n;
+    return 1;
+}
+static int Emit(void *context, const struct NativeLinkEvent *e)
+{
+    static const char hex[] = "0123456789abcdef";
+    char words[33], line[256];
+    unsigned i;
+    (void)context;
+    if (!sLink.ready || !e || e->kind < 1 || e->kind > 5
+     || !e->session || e->session != sLink.session || e->mode != sLink.mode
+     || e->slot != sLink.slot) return 0;
+    for (i = 0; i < 16; i++) {
+        unsigned byte = (e->command[i / 2] >> ((i % 2) * 8)) & 255;
+        words[2*i] = hex[byte >> 4]; words[2*i+1] = hex[byte & 15];
+    }
+    words[32] = 0;
+    snprintf(line, sizeof(line), "L EVENT %u %" PRIu64 " %u %u %" PRIu32 " %" PRIu32 " %u %s\n",
+        e->kind, e->session, e->mode, e->slot, e->generation, e->round, e->linkType, words);
+    return Queue(line);
+}
+/* Same config allowlist, field bounds and whitespace grammar as presence.
+ * Validate the entire byte stream before C-string parsing (including comments). */
+static int Config(const char *path)
+{
+    FILE *f = NativeFile_Open(path, "rb");
+    char line[1200];
+    unsigned seen = 0;
+    int c, good = 0;
+    uint32_t code = 0, minimum = 0;
+    unsigned continuation = 0;
+    if (!f) return 0;
+    while ((c = fgetc(f)) != EOF) {
+        if (continuation) {
+            if (c < 0x80 || c > 0xbf) goto done;
+            code = (code << 6) | (c & 63);
+            if (!--continuation && (code < minimum || code > 0x10ffff || (code >= 0xd800 && code <= 0xdfff))) goto done;
+        } else if (c >= 0x80) {
+            if (c >= 0xc2 && c <= 0xdf) { continuation = 1; code = c & 31; minimum = 0x80; }
+            else if (c >= 0xe0 && c <= 0xef) { continuation = 2; code = c & 15; minimum = 0x800; }
+            else if (c >= 0xf0 && c <= 0xf4) { continuation = 3; code = c & 7; minimum = 0x10000; }
+            else goto done;
+        } else if ((c < 32 && c != '\t' && c != '\r' && c != '\n') || c == 127) goto done;
+    }
+    if (continuation || ferror(f) || fseek(f, 0, SEEK_SET)) goto done;
+    while (fgets(line, sizeof(line), f)) {
+        char *p = line, *key, *value, *end, *dest;
+        unsigned bit;
+        size_t size;
+        if ((!strchr(line, '\n') && !feof(f)) || strlen(line) > 1150) goto done;
+        if (line[0] == '#' || line[0] == '\n') continue;
+        while (*p == ' ' || *p == '\t') p++;
+        key = p;
+        while (*p && *p != ' ' && *p != '\t' && *p != '\r' && *p != '\n') p++;
+        if (!*p || p - key > 31) goto done;
+        *p++ = 0;
+        while (*p == ' ' || *p == '\t') p++;
+        value = p; end = p + strlen(p);
+        while (end > p && (end[-1] == '\n' || end[-1] == '\r')) *--end = 0;
+#ifndef _WIN32
+        while (end > p && (end[-1] == ' ' || end[-1] == '\t')) *--end = 0;
+#endif
+        if (!*value || strlen(value) > 1099) goto done;
+        for (p = value; *p; p++)
+            if (*p == '\r' || *p == '\n'
+#ifdef _WIN32
+             || (strcmp(key, "telemetry") && (*p == ' ' || *p == '\t'))
+#else
+             || *p == ' ' || *p == '\t'
+#endif
+            ) goto done;
+#ifdef _WIN32
+        if (!strcmp(key, "loopback_port")) {
+            uint64_t port;
+            if ((seen & 1) || !Decimal(value, 65535, &port) || !port) goto done;
+            sLink.port = (unsigned)port; seen |= 1; continue;
+        }
+        if (!strcmp(key, "loopback_token")) { bit = 16; dest = sLink.capability; size = sizeof(sLink.capability); }
+#else
+        if (!strcmp(key, "socket")) { bit = 1; dest = sLink.path; size = sizeof(sLink.path); }
+#endif
+        else if (!strcmp(key, "trainer")) { bit = 2; dest = sLink.trainer; size = sizeof(sLink.trainer); }
+        else if (!strcmp(key, "token")) { bit = 4; dest = sLink.token; size = sizeof(sLink.token); }
+        else if (!strcmp(key, "telemetry")) { bit = 8; dest = sLink.telemetry; size = sizeof(sLink.telemetry); }
+        else goto done;
+        if ((seen & bit) || strlen(value) >= size) goto done;
+        strcpy(dest, value); seen |= bit;
+    }
+#ifdef _WIN32
+    if (seen != 31 || !Token(sLink.capability)) goto done;
+#else
+    if (seen != 15 || sLink.path[0] != '/') goto done;
+#endif
+    good = !ferror(f) && Identifier(sLink.trainer) && Token(sLink.token);
+done:
+    fclose(f);
+    return good;
+}
+static int WouldBlock(void)
+{
+#ifdef _WIN32
+    int error = WSAGetLastError();
+    return error == WSAEWOULDBLOCK || error == WSAEINTR;
+#else
+    return errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR;
+#endif
+}
+static void RetryDisconnect(void)
+{
+    Disconnect();
+    /* Reconnect the channel only. No invitations, consent, or queued commands
+     * survive loss of the authenticated presence binding. */
+    sLink.enabled = 1;
+    sLink.retry = 60;
+}
+static int Connect(void)
+{
+    int result;
+    char hello[256];
+#ifdef _WIN32
+    {
+        struct sockaddr_in addr;
+        u_long nonblock = 1;
+        sLink.fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+        if (!SocketOpen() || ioctlsocket(sLink.fd, FIONBIO, &nonblock)) goto fail;
+        memset(&addr, 0, sizeof(addr)); addr.sin_family = AF_INET;
+        addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK); addr.sin_port = htons(sLink.port);
+        result = connect(sLink.fd, (struct sockaddr *)&addr, sizeof(addr));
+        if (result && WSAGetLastError() != WSAEWOULDBLOCK && WSAGetLastError() != WSAEINPROGRESS) goto fail;
+        snprintf(hello, sizeof(hello), "EWLOCAL1 %s\n", sLink.capability);
+        Queue(hello);
+    }
+#else
+    {
+        struct sockaddr_un addr;
+        int flags;
+        sLink.fd = socket(AF_UNIX, SOCK_STREAM, 0);
+        if (!SocketOpen()) goto fail;
+        flags = fcntl(sLink.fd, F_GETFL, 0);
+        if (flags < 0 || fcntl(sLink.fd, F_SETFL, flags | O_NONBLOCK) < 0) goto fail;
+        memset(&addr, 0, sizeof(addr)); addr.sun_family = AF_UNIX;
+        if (strlen(sLink.path) >= sizeof(addr.sun_path)) goto fail;
+        strcpy(addr.sun_path, sLink.path);
+        result = connect(sLink.fd, (struct sockaddr *)&addr, sizeof(addr));
+        if (result && errno != EINPROGRESS) goto fail;
+    }
+#endif
+    sLink.connecting = result != 0;
+    sLink.handshakeStarted = MonotonicMilliseconds();
+    sLink.enabled = 1;
+    snprintf(hello, sizeof(hello), "HELLO 1 %s %s LINK\n", sLink.trainer, sLink.token);
+    Queue(hello);
+    return 1;
+fail:
+    RetryDisconnect();
+    return 0;
+}
+int LinkTransport_Init(const char *configPath)
+{
+    LinkTransport_Close();
+    if (!configPath) return 1;
+    memset(&sLink, 0, sizeof(sLink));
+    sLink.initialized = 1;
+#ifdef _WIN32
+    sLink.fd = INVALID_SOCKET;
+#else
+    sLink.fd = -1;
+#endif
+    if (!Config(configPath)) { LinkTransport_Close(); return 0; }
+#ifdef _WIN32
+    {
+        WSADATA data;
+        if (WSAStartup(MAKEWORD(2,2), &data)) { LinkTransport_Close(); return 0; }
+        sLink.winsock = 1;
+        if (data.wVersion != MAKEWORD(2,2)) { LinkTransport_Close(); return 0; }
+    }
+#endif
+    NativeLink_Init(Emit, NULL);
+    sLink.enabled = 1;
+    Connect();
+    return 1;
+}
+int LinkTransport_Ready(void) { return sLink.ready; }
+unsigned LinkTransport_Mode(void) { return sLink.session ? sLink.mode : 0; }
+int LinkTransport_CoopOwner(void) { return sLink.session && sLink.mode == 4 && sLink.coopOwner; }
+int LinkTransport_OfferPending(void) { return sLink.offered != 0; }
+int LinkTransport_TagOfferPending(void) { return sLink.tagOffered[0] != 0; }
+const LinkTransportInvitation *LinkTransport_PendingTag(void)
+{
+    return sLink.tagPending.id ? &sLink.tagPending : NULL;
+}
+const char *LinkTransport_TagPeer(void) { return sLink.tagPeer[0] ? sLink.tagPeer : NULL; }
+int LinkTransport_TagInRange(void) { return sLink.tagPeer[0] && sLink.tagRange; }
+int LinkTransport_TagOffer(const char *target)
+{
+    char line[64];
+    if (!sLink.ready || sLink.tag || sLink.tagOffered[0] || !Identifier(target)
+     || !strcmp(target, sLink.trainer)) return 0;
+    snprintf(line, sizeof(line), "T OFFER %s\n", target);
+    if (!Queue(line)) return 0;
+    strcpy(sLink.tagOffered, target);
+    return 1;
+}
+int LinkTransport_TagAccept(uint64_t id)
+{
+    char line[64];
+    if (!sLink.ready || !id || id != sLink.tagPending.id || sLink.tagAccepting) return 0;
+    snprintf(line, sizeof(line), "T ACCEPT %" PRIu64 "\n", id);
+    if (!Queue(line)) return 0;
+    sLink.tagAccepting = id;
+    return 1;
+}
+int LinkTransport_TagReject(uint64_t id)
+{
+    char line[64];
+    if (!sLink.ready || !id || id != sLink.tagPending.id || sLink.tagAccepting) return 0;
+    snprintf(line, sizeof(line), "T REJECT %" PRIu64 "\n", id);
+    if (!Queue(line)) return 0;
+    memset(&sLink.tagPending, 0, sizeof(sLink.tagPending));
+    return 1;
+}
+int LinkTransport_TagEnd(void)
+{
+    char line[64];
+    if (!sLink.ready || !sLink.tag) return 0;
+    snprintf(line, sizeof(line), "T END %" PRIu64 "\n", sLink.tag);
+    return Queue(line);
+}
+const struct LinkTransportInvitation *LinkTransport_PendingInvitation(void)
+{
+    /* Mode four already has tag consent, including across fragmented reads. */
+    return sLink.pending.id && sLink.pending.mode != 4 ? &sLink.pending : NULL;
+}
+int LinkTransport_Offer(const char *target, unsigned mode)
+{
+    char line[64];
+    if (!sLink.ready || sLink.session || sLink.pending.id || sLink.offered
+     || !Identifier(target) || !strcmp(target, sLink.trainer) || mode < 1 || mode > 4) return 0;
+    if (mode == 4 && (!sLink.tagPeer[0] || strcmp(target, sLink.tagPeer) || !sLink.tagRange)) return 0;
+    snprintf(line, sizeof(line), "L OFFER %u %s\n", mode, target);
+    if (!Queue(line)) return 0;
+    sLink.offered = mode;
+    return 1;
+}
+int LinkTransport_Accept(uint64_t session)
+{
+    char line[64];
+    if (!sLink.ready || !session || session != sLink.pending.id || sLink.accepting || sLink.session) return 0;
+    snprintf(line, sizeof(line), "L ACCEPT %" PRIu64 "\n", session);
+    if (!Queue(line)) return 0;
+    sLink.accepting = session;
+    return 1;
+}
+int LinkTransport_Reject(uint64_t session)
+{
+    char line[64];
+    if (!sLink.ready || !session || session != sLink.pending.id || sLink.accepting) return 0;
+    snprintf(line, sizeof(line), "L REJECT %" PRIu64 "\n", session);
+    if (!Queue(line)) return 0;
+    memset(&sLink.pending, 0, sizeof(sLink.pending));
+    return 1;
+}
+static int Words(const char *hex, uint16_t words[8])
+{
+    unsigned i;
+    if (strlen(hex) != 32) return 0;
+    memset(words, 0, 16);
+    for (i = 0; i < 16; i++) {
+        int hi = Hex(hex[2*i]), lo = Hex(hex[2*i+1]);
+        if (hi < 0 || lo < 0) return 0;
+        words[i/2] |= (uint16_t)((hi*16+lo) << ((i%2)*8));
+    }
+    return 1;
+}
+static int Line(char *line)
+{
+    char *t[10], *p = line;
+    unsigned n = 0;
+    uint64_t sid, a, b, c;
+    while (*p) {
+        if (n == 10 || *p == ' ') return 0;
+        t[n++] = p;
+        while (*p && *p != ' ') p++;
+        if (*p) { *p++ = 0; if (!*p) return 0; }
+    }
+    if (n == 2 && !strcmp(t[0], "ERROR") && !strcmp(t[1], "PRESENCE")) return 2;
+    if (!sLink.ready) {
+        if (n != 5 || strcmp(t[0], "WELCOME") || strcmp(t[1], "1")
+         || strcmp(t[2], sLink.trainer) || !Decimal(t[3], UINT32_MAX, &a) || strcmp(t[4], "LINK")) return 0;
+        sLink.ready = 1; return 1;
+    }
+    if (n < 3 || (strcmp(t[0], "L") && strcmp(t[0], "T"))) return 0;
+    if (!strcmp(t[1], "ERROR")) {
+        /* Fixed protocol codes, never arbitrary server-provided UI text. */
+        static const char *const codes[] = {
+            "busy", "capacity", "offline", "invalid", "denied", "not_found", "conflict", "expired", "unavailable", "rate_limited",
+            "clock_regressed", "conflicting_duplicate", "invalid_actor", "invalid_commands", "invalid_generation",
+            "invalid_kind", "invalid_link_generation", "invalid_link_type", "invalid_max_steps", "invalid_presence",
+            "invalid_session", "invalid_state", "invalid_step", "invalid_time", "invalid_timeout", "link_type_mismatch",
+            "not_adjacent", "not_host", "not_member", "not_ready", "not_target", "self_offer", "unknown_session",
+            "not_in_range", "malformed", "mode", "slot"
+        };
+        unsigned i;
+        char code[41];
+        size_t j;
+        if (n != 3 || strlen(t[2]) >= sizeof(code)) return 0;
+        for (j = 0; t[2][j]; j++) {
+            char ch = t[2][j];
+            code[j] = ch >= 'A' && ch <= 'Z' ? ch + ('a' - 'A') : ch;
+        }
+        code[j] = 0;
+        for (i = 0; i < sizeof(codes)/sizeof(codes[0]); i++) if (!strcmp(code, codes[i])) {
+            if (!strcmp(t[0], "T")) {
+                /* Crossed offers: the server reserved this incoming offer
+                 * first. BUSY rejects only our outgoing intent, not consent
+                 * the player has yet to give (or just explicitly gave). */
+                if (!strcmp(code, "busy") && sLink.tagOffered[0] && sLink.tag && !sLink.tagPeer[0]) {
+                    sLink.tagOffered[0] = 0;
+                    return 1;
+                }
+                if (!sLink.tagPeer[0]) ClearTag();
+                return 1;
+            }
+            if (sLink.session) return 0;
+            sLink.offered = 0;
+            sLink.accepting = 0;
+            memset(&sLink.pending, 0, sizeof(sLink.pending));
+            return 1;
+        }
+        return 0;
+    }
+    if (!strcmp(t[0], "T")) {
+        if (!Decimal(t[2], UINT64_MAX, &sid) || !sid) return 0;
+        /* A pending-consent keepalive never creates or accepts an invitation.
+         * It may already be in flight when the player declines locally. */
+        if (!strcmp(t[1], "WAIT")) return n == 3;
+        if (!strcmp(t[1], "OFFER")) {
+            if (n != 4 || !Identifier(t[3]) || !strcmp(t[3], sLink.trainer)
+             || sLink.tagPeer[0] || sLink.tag) return 0;
+            sLink.tag = sid;
+            sLink.tagPending.id = sid;
+            strcpy(sLink.tagPending.name, t[3]);
+            return 1;
+        }
+        if (!strcmp(t[1], "ACTIVE")) {
+            if (n != 5 || !Identifier(t[3]) || !strcmp(t[3], sLink.trainer)
+             || !Decimal(t[4], 1, &a)) return 0;
+            if (sLink.tagPeer[0])
+                return sid == sLink.tag && !strcmp(t[3], sLink.tagPeer) && a == (unsigned)sLink.tagRange;
+            if (!((sLink.tagAccepting == sid && sLink.tagPending.id == sid
+                   && !strcmp(t[3], sLink.tagPending.name))
+               || (!sLink.tag && sLink.tagOffered[0] && !strcmp(t[3], sLink.tagOffered)))) return 0;
+            sLink.tag = sid;
+            strcpy(sLink.tagPeer, t[3]);
+            sLink.tagRange = (int)a;
+            sLink.tagAccepting = 0; sLink.tagOffered[0] = 0;
+            memset(&sLink.tagPending, 0, sizeof(sLink.tagPending));
+            return 1;
+        }
+        if (!strcmp(t[1], "RANGE")) {
+            if (n != 4 || sid != sLink.tag || !sLink.tagPeer[0] || !Decimal(t[3], 1, &a)) return 0;
+            sLink.tagRange = (int)a;
+            return 1;
+        }
+        if (!strcmp(t[1], "END") && n == 3) {
+            if (sid != sLink.tag && !sLink.tagOffered[0]) return 0;
+            ClearTag();
+            return 1;
+        }
+        return 0;
+    }
+    if (!strcmp(t[1], "COMMIT")) {
+        uint16_t matrix[2][8];
+        if (n != 8 || !Decimal(t[2], 3, &a) || !a || !Decimal(t[3], UINT64_MAX, &sid) || !sid
+         || sid != sLink.session || !Decimal(t[4], UINT32_MAX, &b) || !Decimal(t[5], UINT32_MAX, &c)
+         || !Words(t[6], matrix[0]) || !Words(t[7], matrix[1])) return 0;
+        return NativeLink_Feed((unsigned)a, sid, (uint32_t)b, (uint32_t)c, matrix) >= 0;
+    }
+    if (!Decimal(t[2], UINT64_MAX, &sid) || !sid) return 0;
+    if (!strcmp(t[1], "OFFER")) {
+        if (n != 5 || !Decimal(t[3], 4, &a) || !a || !Identifier(t[4]) || !strcmp(t[4], sLink.trainer)
+         || sLink.session) return 0;
+        if (a == 4 && (!sLink.tagPeer[0] || strcmp(t[4], sLink.tagPeer))) return 0;
+        if (sLink.offered && !(a == 4 && sLink.offered == 4)) return 0;
+        if (sLink.pending.id && (sLink.pending.id != sid || sLink.pending.mode != a || strcmp(sLink.pending.name,t[4]))) return 0;
+        sLink.pending.id = sid; sLink.pending.mode = (unsigned)a; strcpy(sLink.pending.name,t[4]); return 1;
+    }
+    if (!strcmp(t[1], "ADMIT")) {
+        if (n != 5 || !Decimal(t[3], 4, &a) || !a || !Decimal(t[4], 1, &b)) return 0;
+        if (sLink.session) return sid == sLink.session && a == sLink.mode && b == sLink.slot;
+        if (a == 4 && !sLink.tagPeer[0]) return 0;
+        if (!((sLink.accepting == sid && sLink.pending.mode == a) || sLink.offered == a
+           || (a == 4 && sLink.tagPeer[0] && sLink.pending.id == sid
+               && sLink.pending.mode == 4 && !strcmp(sLink.pending.name, sLink.tagPeer)))) return 0;
+        sLink.coopOwner = a == 4 && sLink.pending.id != sid;
+        sLink.session = sid; sLink.mode = (unsigned)a; sLink.slot = (unsigned)b;
+        if (!NativeLink_Admit(sid, (unsigned)a, (unsigned)b)) return 0;
+        sLink.offered = 0; sLink.accepting = 0; memset(&sLink.pending, 0, sizeof(sLink.pending)); return 1;
+    }
+    if (!strcmp(t[1], "ABORT") && n == 3) {
+        /* An outgoing offer has no session ID yet. An unrelated terminal
+         * record must not cancel it before its own ADMIT or ERROR arrives. */
+        if (sid == sLink.pending.id && sLink.offered == 4) sLink.offered = 0;
+        if (sid == sLink.session) {
+            NativeLink_EndSession(sid);
+            sLink.session = 0; sLink.mode = sLink.slot = 0;
+            sLink.coopOwner = 0;
+        }
+        if (sid == sLink.pending.id) { sLink.accepting = 0; memset(&sLink.pending, 0, sizeof(sLink.pending)); }
+        return 1;
+    }
+    return 0;
+}
+void LinkTransport_Pump(void)
+{
+    unsigned budget;
+    if (!sLink.enabled) return;
+    if (!SocketOpen()) {
+        if (sLink.retry) { sLink.retry--; return; }
+        if (!Connect()) return;
+    }
+    /* Bound the whole unauthenticated attempt, not each incoming byte. A
+     * silent or trickling endpoint must not strand the native cable forever.
+     * Ready channels retain their existing session and inactivity semantics. */
+    if (!sLink.ready) {
+        /* SDL can pump far faster than frames without renderer vsync.
+         * Network admission is bounded by elapsed time, never poll count. */
+        uint64_t now = MonotonicMilliseconds();
+        if (now == UINT64_MAX || sLink.handshakeStarted == UINT64_MAX
+            || now < sLink.handshakeStarted
+            || now - sLink.handshakeStarted >= HANDSHAKE_MILLISECONDS)
+        { RetryDisconnect(); return; }
+    }
+    if (sLink.connecting) {
+        int error = 0;
+#ifdef _WIN32
+        fd_set writes, errors;
+        struct timeval timeout = {0,0};
+        int size = sizeof(error), result;
+        FD_ZERO(&writes); FD_ZERO(&errors); FD_SET(sLink.fd, &writes); FD_SET(sLink.fd, &errors);
+        result = select(0, NULL, &writes, &errors, &timeout);
+        if (result < 0) { Disconnect(); return; }
+        if (!result) return;
+        if (getsockopt(sLink.fd, SOL_SOCKET, SO_ERROR, (char *)&error, &size) || error) { RetryDisconnect(); return; }
+#else
+        struct pollfd fd = {sLink.fd, POLLOUT, 0};
+        socklen_t size = sizeof(error);
+        int result = poll(&fd, 1, 0);
+        if (result < 0) { if (errno != EINTR) Disconnect(); return; }
+        if (!result) return;
+        if (getsockopt(sLink.fd, SOL_SOCKET, SO_ERROR, &error, &size) || error) { RetryDisconnect(); return; }
+#endif
+        sLink.connecting = 0;
+    }
+    for (budget = 0; sLink.sent < sLink.queued && budget < 64; budget++) {
+        int count;
+#ifdef _WIN32
+        count = send(sLink.fd, sLink.output+sLink.sent, (int)(sLink.queued-sLink.sent), 0);
+#else
+        count = (int)send(sLink.fd, sLink.output+sLink.sent, sLink.queued-sLink.sent, MSG_NOSIGNAL);
+#endif
+        if (count < 0 && WouldBlock()) break;
+        if (count <= 0) { RetryDisconnect(); return; }
+        sLink.sent += (size_t)count;
+    }
+    if (sLink.sent == sLink.queued) sLink.sent = sLink.queued = 0;
+    for (budget = 0; budget < 8192; budget++) {
+        char ch;
+        int count = (int)recv(sLink.fd, &ch, 1, 0);
+        if (count < 0 && WouldBlock()) break;
+        if (count <= 0) { RetryDisconnect(); return; }
+        if (ch == '\n') {
+            int parsed;
+            sLink.input[sLink.used] = 0;
+            parsed = Line(sLink.input);
+            if (parsed == 2) { RetryDisconnect(); return; }
+            if (!parsed) { Disconnect(); return; }
+            sLink.used = 0;
+        } else {
+            if ((unsigned char)ch < 32 || (unsigned char)ch > 126 || sLink.used == 512) { Disconnect(); return; }
+            sLink.input[sLink.used++] = ch;
+        }
+    }
+    if (sLink.ready) NativeLink_Pump();
+}
+#endif
diff --git a/src/world/native_link.c b/src/world/native_link.c
new file mode 100644
index 0000000000..950687377b
--- /dev/null
+++ b/src/world/native_link.c
@@ -0,0 +1,289 @@
+#ifdef PORTABLE
+#include "platform/native_link.h"
+#include <string.h>
+#include <limits.h>
+
+#define COMMAND_CAPACITY 50
+/* Cover WAN latency without changing the engine's one-matrix-per-tick seam. */
+#define ROUND_CAPACITY 16
+static NativeLinkEmit sEmit;
+static void *sContext;
+static const uint16_t *sSource;
+static struct
+{
+    uint64_t session, nextRound;
+    unsigned mode, slot, open, paired, connected, advance;
+    uint32_t generation, round;
+    unsigned inTick, consumed, prepared, haveLast;
+    uint16_t last[2][8];
+    struct
+    {
+        unsigned sent, received;
+        uint16_t command[8], matrix[2][8];
+    } wire[ROUND_CAPACITY];
+    uint16_t commands[COMMAND_CAPACITY][8];
+    unsigned head, count;
+} s;
+static struct NativeLinkEvent sQueue[8];
+static unsigned sCount;
+
+static struct NativeLinkEvent Event(unsigned kind)
+{
+    struct NativeLinkEvent e;
+    memset(&e, 0, sizeof(e));
+    e.kind = kind; e.session = s.session; e.mode = s.mode; e.slot = s.slot;
+    e.generation = s.generation;
+    e.round = kind == NATIVE_LINK_COMMAND ? s.round : 0;
+    return e;
+}
+void NativeLink_Init(NativeLinkEmit emit, void *context)
+{
+    memset(&s, 0, sizeof(s)); sCount = 0; sSource = 0;
+    sEmit = emit; sContext = context;
+}
+void NativeLink_Reset(void)
+{
+    if (s.session) NativeLink_Abort();
+    memset(&s, 0, sizeof(s));
+}
+int NativeLink_Admit(uint64_t session, unsigned mode, unsigned slot)
+{
+    if (!session || mode < NATIVE_LINK_SINGLE || mode > NATIVE_LINK_COOP || slot > 1 || s.session || sCount || !sEmit)
+        return 0;
+    memset(&s, 0, sizeof(s));
+    s.session = session; s.mode = mode; s.slot = slot;
+    return 1;
+}
+int NativeLink_IsActive(void) { return s.session != 0; }
+int NativeLink_IsOpen(void) { return s.session && s.open; }
+int NativeLink_IsConnected(void) { return NativeLink_IsOpen() && s.connected; }
+unsigned NativeLink_LocalId(void) { return s.slot; }
+uint32_t NativeLink_Generation(void) { return s.generation; }
+static int Nonzero(const uint16_t *words, unsigned count)
+{
+    unsigned i;
+    for (i = 0; i < count; ++i) if (words[i]) return 1;
+    return 0;
+}
+unsigned NativeLink_RecvQueueCount(void)
+{
+    uint64_t round;
+    unsigned count = 0;
+    if (!s.open) return 0;
+    for (round = s.round; round < s.nextRound; ++round)
+    {
+        unsigned index = round % ROUND_CAPACITY;
+        if (round == s.round && s.consumed) continue;
+        if (s.wire[index].received
+            && (Nonzero(s.wire[index].matrix[0], 8) || Nonzero(s.wire[index].matrix[1], 8))) ++count;
+    }
+    return count;
+}
+unsigned NativeLink_SendQueueCount(void)
+{
+    uint64_t round;
+    unsigned count = s.count;
+    if (!s.open) return 0;
+    for (round = s.round; round < s.nextRound; ++round)
+    {
+        unsigned index = round % ROUND_CAPACITY;
+        if (!s.wire[index].received && Nonzero(s.wire[index].command, 8)) ++count;
+    }
+    return count;
+}
+void NativeLink_SetCommandSource(const uint16_t send[8]) { sSource = send; }
+void NativeLink_Pump(void)
+{
+    uint64_t round;
+    while (sCount && sEmit && sEmit(sContext, &sQueue[0]))
+    {
+        --sCount;
+        memmove(sQueue, sQueue + 1, sCount * sizeof(sQueue[0]));
+    }
+    if (sCount || !s.open || !sEmit) return;
+    for (round = s.round; round < s.nextRound; ++round)
+    {
+        unsigned index = round % ROUND_CAPACITY;
+        if (!s.wire[index].sent)
+        {
+            struct NativeLinkEvent e = Event(NATIVE_LINK_COMMAND);
+            e.round = (uint32_t)round;
+            memcpy(e.command, s.wire[index].command, sizeof(e.command));
+            if (!sEmit(sContext, &e)) break;
+            s.wire[index].sent = 1;
+        }
+    }
+}
+void NativeLink_EndSession(uint64_t session)
+{
+    unsigned i, kept = 0;
+    if (!session) return;
+    /* Only an authoritative remote end or lost channel invalidates undelivered
+     * events. Do not echo ABORT into a session the transport has already ended. */
+    if (s.session == session) memset(&s, 0, sizeof(s));
+    for (i = 0; i < sCount; ++i)
+        if (sQueue[i].session != session) sQueue[kept++] = sQueue[i];
+    sCount = kept;
+}
+void NativeLink_Abort(void)
+{
+    struct NativeLinkEvent e = Event(NATIVE_LINK_ABORT);
+    if (!e.session) return; /* Keep any previously queued terminal event. */
+    memset(&s, 0, sizeof(s));
+    sCount = 0;
+    if (e.session) { sQueue[sCount++] = e; NativeLink_Pump(); }
+}
+static int Fail(void) { NativeLink_Abort(); return -1; }
+static int Queue(struct NativeLinkEvent e)
+{
+    if (sCount == sizeof(sQueue) / sizeof(sQueue[0])) return Fail();
+    sQueue[sCount++] = e; NativeLink_Pump(); return 1;
+}
+void NativeLink_Open(uint16_t linkType)
+{
+    struct NativeLinkEvent e;
+    if (!s.session) return;
+    if (s.open || s.generation == UINT32_MAX) { NativeLink_Abort(); return; }
+    ++s.generation;
+    s.round = 0; s.nextRound = 0;
+    s.open = 1; s.paired = s.connected = s.advance = 0;
+    s.head = s.count = 0;
+    s.inTick = s.consumed = s.prepared = s.haveLast = 0;
+    memset(s.wire, 0, sizeof(s.wire));
+    e = Event(NATIVE_LINK_OPEN); e.linkType = linkType; Queue(e);
+}
+int NativeLink_TryClose(void)
+{
+    NativeLink_Pump();
+    if (sCount || NativeLink_SendQueueCount() || NativeLink_RecvQueueCount()) return 0;
+    NativeLink_Close();
+    return !sCount;
+}
+void NativeLink_Close(void)
+{
+    struct NativeLinkEvent e;
+    if (!NativeLink_IsOpen()) return;
+    e = Event(NATIVE_LINK_CLOSE);
+    s.open = s.paired = s.connected = 0;
+    s.head = s.count = 0;
+    s.inTick = s.consumed = s.prepared = 0;
+    /* Retain the bounded emitted window to validate late echoes. They cannot
+     * reach the engine after close or contaminate the next generation. */
+    Queue(e);
+}
+int NativeLink_Feed(unsigned kind, uint64_t session, uint32_t generation,
+                    uint32_t round, const uint16_t matrix[2][8])
+{
+    static const uint16_t zero[2][8] = {{0}};
+    unsigned index;
+    if (!s.session || session != s.session || generation < s.generation) return 0;
+    if (generation != s.generation || !matrix) return Fail();
+    if (kind == NATIVE_LINK_PAIR || kind == NATIVE_LINK_HANDSHAKE)
+    {
+        if (!s.open || round || memcmp(matrix, zero, sizeof(zero))) return Fail();
+        if (kind == NATIVE_LINK_PAIR) s.paired = 1;
+        else
+        {
+            if (!s.paired || (s.slot == 0 && !s.advance)) return Fail();
+            s.connected = 1;
+        }
+        return 1;
+    }
+    if (kind != NATIVE_LINK_ROUND) return Fail();
+    if (s.haveLast && s.round && round == s.round - 1)
+        return memcmp(matrix, s.last, sizeof(s.last)) ? Fail() : 1;
+    if (round < s.round || (uint64_t)round >= s.nextRound) return Fail();
+    index = round % ROUND_CAPACITY;
+    if (!s.wire[index].sent || memcmp(matrix[s.slot], s.wire[index].command, sizeof(s.wire[index].command))) return Fail();
+    if (s.wire[index].received)
+        return memcmp(matrix, s.wire[index].matrix, sizeof(s.wire[index].matrix)) ? Fail() : 1;
+    if (s.open && (!s.paired || (!s.connected && memcmp(matrix, zero, sizeof(zero))))) return Fail();
+    memcpy(s.wire[index].matrix, matrix, sizeof(s.wire[index].matrix));
+    s.wire[index].received = 1;
+    return s.open ? 1 : 0;
+}
+int NativeLink_FrameReady(void)
+{
+    if (s.session && s.open && s.paired && !s.prepared
+        && s.nextRound - s.round < ROUND_CAPACITY)
+    {
+        unsigned index;
+        if (s.nextRound > UINT32_MAX) { NativeLink_Abort(); return 1; }
+        index = s.nextRound % ROUND_CAPACITY;
+        memset(&s.wire[index], 0, sizeof(s.wire[index]));
+        if (s.nextRound && s.connected && s.count)
+        {
+            memcpy(s.wire[index].command, s.commands[s.head], sizeof(s.wire[index].command));
+            s.head = (s.head + 1) % COMMAND_CAPACITY;
+            --s.count;
+        }
+        ++s.nextRound;
+        s.prepared = 1;
+    }
+    NativeLink_Pump();
+    return 1;
+}
+int NativeLink_BeforeFrame(const uint16_t send[8])
+{
+    if (!sSource) sSource = send;
+    if (s.inTick) return 0;
+    if (s.open && s.paired)
+    {
+        unsigned i, sentinel = 1;
+        for (i = 0; i < 8; ++i) if (send[i] != 0xefff) sentinel = 0;
+        if (s.connected && !sentinel && Nonzero(send, 8))
+        {
+            if (NativeLink_SendQueueCount() >= COMMAND_CAPACITY)
+            {
+                NativeLink_Abort();
+                return 1;
+            }
+            memcpy(s.commands[(s.head + s.count) % COMMAND_CAPACITY], send,
+                   sizeof(s.commands[0]));
+            ++s.count;
+        }
+        s.inTick = 1; s.consumed = 0;
+    }
+    return NativeLink_FrameReady();
+}
+void NativeLink_AfterFrame(void)
+{
+    if (!s.inTick) return;
+    s.inTick = s.prepared = 0;
+    if (!s.consumed) return;
+    if (s.round == UINT32_MAX) { NativeLink_Abort(); return; }
+    memcpy(s.last, s.wire[s.round % ROUND_CAPACITY].matrix, sizeof(s.last));
+    s.haveLast = 1;
+    memset(&s.wire[s.round % ROUND_CAPACITY], 0, sizeof(s.wire[0]));
+    ++s.round;
+    s.consumed = 0;
+}
+uint32_t NativeLink_Main1(uint8_t *advance, const uint16_t send[8], uint16_t recv[5][8])
+{
+    uint32_t status;
+    (void)send;
+    memset(recv, 0, 5 * 8 * sizeof(uint16_t));
+    if (!NativeLink_IsOpen()) return 0;
+    if (*advance == 2)
+    {
+        *advance = 0;
+        NativeLink_Abort();
+        return 0;
+    }
+    status = s.slot | (s.slot == 0 ? 0x20u : 0);
+    if (s.paired) status |= 2u << 2;
+    if (*advance == 1 && s.paired && !s.slot && !s.advance)
+    {
+        s.advance = 1; Queue(Event(NATIVE_LINK_ADVANCE));
+    }
+    if (s.paired) *advance = 0;
+    if (s.connected) status |= 0x40u;
+    if (s.inTick && s.round < s.nextRound && s.wire[s.round % ROUND_CAPACITY].received && !s.consumed)
+    {
+        memcpy(recv, s.wire[s.round % ROUND_CAPACITY].matrix, sizeof(s.wire[0].matrix));
+        s.consumed = 1;
+    }
+    else if (s.paired) status |= 0x100u;
+    return status;
+}
+#endif
diff --git a/src/world/party_autoheal.c b/src/world/party_autoheal.c
new file mode 100644
index 0000000000..817bac3ff1
--- /dev/null
+++ b/src/world/party_autoheal.c
@@ -0,0 +1,192 @@
+#ifdef PORTABLE
+#include "global.h"
+#include "battle.h"
+#include "battle_pike.h"
+#include "battle_pyramid.h"
+#include "event_data.h"
+#include "item.h"
+#include "link.h"
+#include "main.h"
+#include "overworld.h"
+#include "palette.h"
+#include "party_menu.h"
+#include "pokemon.h"
+#include "script.h"
+#include "field_specials.h"
+#include "platform/native_link.h"
+#include "platform/world_activity.h"
+#include "platform/world_coop.h"
+#include "platform/party_autoheal.h"
+#include "constants/battle_pyramid.h"
+#include "constants/flags.h"
+#include "constants/party_menu.h"
+#include "constants/vars.h"
+#include <string.h>
+
+/* Fixed stock HP/status consumables only. Excludes revives, Sacred Ash, PP/EV
+ * items, reusable flutes and the save-defined Enigma Berry effect. Berries are
+ * owned medicine too. Prices are stock purchase prices, not HP-per-money or a
+ * globally optimal shopping plan. Equal prices break by numeric item ID. */
+static const u16 sMedicines[] =
+{
+    ITEM_POTION, ITEM_ANTIDOTE, ITEM_BURN_HEAL, ITEM_ICE_HEAL,
+    ITEM_AWAKENING, ITEM_PARALYZE_HEAL, ITEM_FULL_RESTORE, ITEM_MAX_POTION,
+    ITEM_HYPER_POTION, ITEM_SUPER_POTION, ITEM_FULL_HEAL,
+    ITEM_FRESH_WATER, ITEM_SODA_POP, ITEM_LEMONADE, ITEM_MOOMOO_MILK,
+    ITEM_ENERGY_POWDER, ITEM_ENERGY_ROOT, ITEM_HEAL_POWDER,
+    ITEM_LAVA_COOKIE, ITEM_BERRY_JUICE,
+    ITEM_CHERI_BERRY, ITEM_CHESTO_BERRY, ITEM_PECHA_BERRY, ITEM_RAWST_BERRY,
+    ITEM_ASPEAR_BERRY, ITEM_ORAN_BERRY, ITEM_PERSIM_BERRY, ITEM_LUM_BERRY,
+    ITEM_SITRUS_BERRY
+};
+
+struct AutoHealPlan
+{
+    struct Pokemon before[PARTY_SIZE], after[PARTY_SIZE];
+    struct ItemSlot items[BAG_ITEMS_COUNT], berries[BAG_BERRIES_COUNT];
+    u16 owned[ARRAY_COUNT(sMedicines)], used[ARRAY_COUNT(sMedicines)];
+    u32 encryptionKey;
+    u8 count, changed;
+};
+
+bool8 WorldAutoHeal_Available(void)
+{
+    /* The ordinary Party menu itself pauses the field and locks its controls.
+     * Requiring unlocked controls or CB2_Overworld here would disable the real
+     * action. Its field-only return callback distinguishes it from scripted
+     * selections, trade and battle menus. The UI also checks its live callback.
+     * A local tag alone is not busy: only activity/encounter ownership blocks. */
+    return gSaveBlock1Ptr != NULL && gSaveBlock2Ptr != NULL
+        && gPartyMenu.menuType == PARTY_MENU_TYPE_FIELD
+        && gPartyMenu.action == PARTY_ACTION_CHOOSE_MON
+        && gPartyMenu.exitCallback == CB2_ReturnToFieldWithOpenMenu
+        && !gMain.inBattle && !gPaletteFade.active
+        && !ScriptContext_IsEnabled()
+        && !gWirelessCommType && !gReceivedRemoteLinkPlayers
+        && !IsOverworldLinkActive()
+        && !NativeLink_IsActive() && !WorldCoop_IsBattle()
+        && !WorldCoop_IsPrivateRewards()
+        && !WorldActivity_OwnsFieldInput() && !WorldActivity_IsEncounterPending()
+        && !InUnionRoom() && !InMultiPartnerRoom() && !InBattlePike()
+        && CurrentBattlePyramidLocation() == PYRAMID_LOCATION_NONE
+        && !FlagGet(FLAG_STORING_ITEMS_IN_PYRAMID_BAG)
+        && gPlayerPartyCount > 0 && gPlayerPartyCount <= PARTY_SIZE;
+}
+
+static bool8 TryMedicine(struct Pokemon *trial, u16 item, u8 slot)
+{
+    u16 hp = GetMonData(trial, MON_DATA_HP);
+    u32 status = GetMonData(trial, MON_DATA_STATUS);
+    u8 potential = gPotentialItemEffectBattler;
+    bool8 noEffect;
+
+    /* FALSE means applied. Even a TRUE/no-effect call can change friendship.
+     * All probes operate on a fresh local copy, never the private live party.
+     * These fixed effects out of battle only alter the copy and these globals. */
+    noEffect = PokemonUseItemEffects(trial, item, slot, 0, FALSE);
+    gPotentialItemEffectBattler = potential;
+    return !noEffect && (GetMonData(trial, MON_DATA_HP) > hp
+        || GetMonData(trial, MON_DATA_STATUS) != status);
+}
+
+static void BuildPlan(struct AutoHealPlan *plan)
+{
+    unsigned i, slot;
+    memset(plan, 0, sizeof(*plan));
+    plan->count = gPlayerPartyCount;
+    plan->encryptionKey = gSaveBlock2Ptr->encryptionKey;
+    memcpy(plan->before, gPlayerParty, sizeof(plan->before));
+    memcpy(plan->after, plan->before, sizeof(plan->after));
+    memcpy(plan->items, gSaveBlock1Ptr->bag.items, sizeof(plan->items));
+    memcpy(plan->berries, gSaveBlock1Ptr->bag.berries, sizeof(plan->berries));
+    for (i = 0; i < ARRAY_COUNT(sMedicines); i++)
+        plan->owned[i] = CountTotalItemQuantityInBag(sMedicines[i]);
+
+    /* Party-slot order, repeatedly taking the cheapest currently applicable
+     * owned unit. Partial healing is useful even when stock cannot finish. */
+    for (slot = 0; slot < plan->count; slot++)
+    {
+        struct Pokemon *mon = &plan->after[slot];
+        if (!GetMonData(mon, MON_DATA_SPECIES) || GetMonData(mon, MON_DATA_IS_EGG)
+            || !GetMonData(mon, MON_DATA_HP))
+            continue;
+        for (;;)
+        {
+            unsigned best = ARRAY_COUNT(sMedicines);
+            struct Pokemon bestMon;
+            for (i = 0; i < ARRAY_COUNT(sMedicines); i++)
+            {
+                struct Pokemon trial;
+                if (plan->used[i] >= plan->owned[i])
+                    continue;
+                if (best != ARRAY_COUNT(sMedicines)
+                    && (GetItemPrice(sMedicines[i]) > GetItemPrice(sMedicines[best])
+                        || (GetItemPrice(sMedicines[i]) == GetItemPrice(sMedicines[best])
+                            && sMedicines[i] > sMedicines[best])))
+                    continue;
+                trial = *mon;
+                if (TryMedicine(&trial, sMedicines[i], slot))
+                {
+                    best = i;
+                    bestMon = trial;
+                }
+            }
+            if (best == ARRAY_COUNT(sMedicines))
+                break;
+            *mon = bestMon;
+            plan->used[best]++;
+            plan->changed |= 1 << slot;
+        }
+    }
+}
+
+static bool8 CommitPlan(const struct AutoHealPlan *plan)
+{
+    unsigned i;
+    u16 secretFlags, secretItem;
+    /* No callbacks, frames or network polling between validation and commit.
+     * Validate full encrypted identities/state, reserves, quantities and the
+     * bag encryption key. No detached plan may overwrite a newer private party. */
+    if (!WorldAutoHeal_Available() || plan->count != gPlayerPartyCount
+        || plan->encryptionKey != gSaveBlock2Ptr->encryptionKey
+        || memcmp(plan->before, gPlayerParty, sizeof(plan->before))
+        || memcmp(plan->items, gSaveBlock1Ptr->bag.items, sizeof(plan->items))
+        || memcmp(plan->berries, gSaveBlock1Ptr->bag.berries, sizeof(plan->berries)))
+        return FALSE;
+    for (i = 0; i < ARRAY_COUNT(sMedicines); i++)
+        if (CountTotalItemQuantityInBag(sMedicines[i]) != plan->owned[i]
+            || plan->used[i] > plan->owned[i])
+            return FALSE;
+
+    /* Stock removal also records Secret Base item use. Restore its bookkeeping
+     * along with encrypted pocket bytes if any removal unexpectedly refuses. */
+    secretFlags = VarGet(VAR_SECRET_BASE_LOW_TV_FLAGS);
+    secretItem = VarGet(VAR_SECRET_BASE_LAST_ITEM_USED);
+    for (i = 0; i < ARRAY_COUNT(sMedicines); i++)
+    {
+        if (plan->used[i] && !RemoveBagItem(sMedicines[i], plan->used[i]))
+        {
+            memcpy(gSaveBlock1Ptr->bag.items, plan->items, sizeof(plan->items));
+            memcpy(gSaveBlock1Ptr->bag.berries, plan->berries, sizeof(plan->berries));
+            VarSet(VAR_SECRET_BASE_LOW_TV_FLAGS, secretFlags);
+            VarSet(VAR_SECRET_BASE_LAST_ITEM_USED, secretItem);
+            return FALSE;
+        }
+    }
+    for (i = 0; i < plan->count; i++)
+        if (plan->changed & (1 << i))
+            gPlayerParty[i] = plan->after[i];
+    return TRUE;
+}
+
+enum AutoHealResult WorldAutoHeal_Run(void)
+{
+    struct AutoHealPlan plan;
+    if (!WorldAutoHeal_Available())
+        return AUTO_HEAL_REFUSED;
+    BuildPlan(&plan);
+    if (!plan.changed)
+        return AUTO_HEAL_NOTHING;
+    return CommitPlan(&plan) ? AUTO_HEAL_USED : AUTO_HEAL_REFUSED;
+}
+#endif
diff --git a/src/world/player_control.c b/src/world/player_control.c
new file mode 100644
index 0000000000..fb4f864f80
--- /dev/null
+++ b/src/world/player_control.c
@@ -0,0 +1,375 @@
+#ifdef PORTABLE
+#include "platform/player_control.h"
+#include <string.h>
+#include <stdlib.h>
+#include <limits.h>
+#include <errno.h>
+#ifndef _WIN32
+#include <unistd.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
+
+#define REQUEST_CAP 8192
+#define RESPONSE_CAP 65536
+static struct {
+    int listener, client, dir;
+    char name[108], path[108], shot[PATH_MAX];
+    dev_t device;
+    ino_t inode;
+    char input[REQUEST_CAP], output[RESPONSE_CAP];
+    size_t used, size, sent;
+    unsigned id, remaining;
+    uint16_t buttons;
+    uint32_t frame;
+    unsigned long long deadline;
+    bool closeAfterWrite;
+    void (*state)(FILE *, uint32_t);
+    bool (*capture)(FILE *);
+} s = {.listener = -1, .client = -1, .dir = -1};
+
+static unsigned long long Now(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static void Disconnect(void)
+{
+    if (s.client >= 0) close(s.client);
+    s.client = -1;
+    s.used = s.size = s.sent = 0;
+    s.remaining = s.buttons = 0;
+    s.closeAfterWrite = false;
+}
+
+void PlayerControl_Close(void)
+{
+    struct stat st;
+    Disconnect();
+    if (s.listener >= 0) close(s.listener);
+    if (s.dir >= 0) {
+        if (!fstatat(s.dir, s.name, &st, AT_SYMLINK_NOFOLLOW)
+            && st.st_dev == s.device && st.st_ino == s.inode && S_ISSOCK(st.st_mode))
+            unlinkat(s.dir, s.name, 0);
+        close(s.dir);
+    }
+    s.listener = s.dir = -1;
+    s.inode = 0;
+}
+
+/* Walk from / without following any symlink, including intermediate components. */
+static int Parent(const char *path, char *name, size_t size)
+{
+    char copy[PATH_MAX], *part, *next, *end;
+    int fd, child;
+    if (!path || path[0] != '/' || strlen(path) >= sizeof(copy)) return -1;
+    strcpy(copy, path + 1);
+    fd = open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    part = strtok_r(copy, "/", &end);
+    if (!part) { close(fd); return -1; }
+    while ((next = strtok_r(NULL, "/", &end)) != NULL) {
+        if (!strcmp(part, ".") || !strcmp(part, "..")) { close(fd); return -1; }
+        child = openat(fd, part, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+        close(fd);
+        if (child < 0) return -1;
+        fd = child;
+        part = next;
+    }
+    if (!strcmp(part, ".") || !strcmp(part, "..") || strlen(part) >= size) {
+        close(fd); return -1;
+    }
+    strcpy(name, part);
+    return fd;
+}
+
+bool PlayerControl_Init(const char *path, const char *savePath,
+                        void (*state)(FILE *, uint32_t), bool (*shot)(FILE *))
+{
+    struct sockaddr_un addr;
+    struct stat profile, saveDir, existing;
+    char saveName[PATH_MAX];
+    int fd = -1, oldMask;
+    PlayerControl_Close();
+    if (!path) return true;
+    if (strlen(path) >= sizeof(addr.sun_path) || !state || !shot) goto fail;
+    s.dir = Parent(path, s.name, sizeof(s.name));
+    fd = Parent(savePath, saveName, sizeof(saveName));
+    if (s.dir < 0 || fd < 0 || fstat(s.dir, &profile) || fstat(fd, &saveDir)
+        || profile.st_dev != saveDir.st_dev || profile.st_ino != saveDir.st_ino
+        || profile.st_uid != geteuid() || (profile.st_mode & 0077)
+        || !strcmp(s.name, "screenshot.ppm") || !strcmp(saveName, "screenshot.ppm")
+        || !strcmp(s.name, saveName)) goto fail;
+    close(fd); fd = -1;
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    strcpy(addr.sun_path, path);
+    if (!fstatat(s.dir, s.name, &existing, AT_SYMLINK_NOFOLLOW)) {
+        struct stat checked;
+        int probe, result, error;
+        if (!S_ISSOCK(existing.st_mode) || existing.st_uid != geteuid()
+            || existing.st_nlink != 1) goto fail;
+        probe = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+        if (probe < 0) goto fail;
+        result = connect(probe, (struct sockaddr *)&addr, sizeof(addr));
+        error = errno;
+        close(probe);
+        /* Only a refused connection proves staleness. Recheck ownership and
+         * identity after probing so a replaced endpoint is never reclaimed. */
+        if (result != -1 || error != ECONNREFUSED
+            || fstatat(s.dir, s.name, &checked, AT_SYMLINK_NOFOLLOW)
+            || !S_ISSOCK(checked.st_mode) || checked.st_uid != geteuid()
+            || checked.st_nlink != 1 || checked.st_dev != existing.st_dev
+            || checked.st_ino != existing.st_ino
+            || unlinkat(s.dir, s.name, 0)) goto fail;
+    } else if (errno != ENOENT) goto fail;
+    strcpy(s.path, path);
+    strcpy(s.shot, path);
+    strcpy(strrchr(s.shot, '/') + 1, "screenshot.ppm");
+    /* Only printable unescaped paths are returned in the JSON protocol. */
+    for (const unsigned char *p = (const unsigned char *)s.shot; *p; p++)
+        if (*p < 32 || *p > 126 || *p == '"' || *p == '\\') goto fail;
+    s.listener = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (s.listener < 0 || fcntl(s.listener, F_SETFL, O_NONBLOCK)
+        || fcntl(s.listener, F_SETFD, FD_CLOEXEC)) goto fail;
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    strcpy(addr.sun_path, path);
+    oldMask = umask(0077);
+    int bound = bind(s.listener, (struct sockaddr *)&addr, sizeof(addr));
+    umask(oldMask);
+    if (bound) goto fail;
+    if (fstatat(s.dir, s.name, &existing, AT_SYMLINK_NOFOLLOW)) goto fail;
+    s.device = existing.st_dev; s.inode = existing.st_ino;
+    if (fchmodat(s.dir, s.name, 0600, 0) || listen(s.listener, 1)) goto fail;
+    s.state = state; s.capture = shot; s.frame = 0;
+    atexit(PlayerControl_Close);
+    return true;
+fail:
+    if (fd >= 0) close(fd);
+    PlayerControl_Close();
+    fprintf(stderr, "Invalid player control endpoint. Use an unused absolute socket beside an explicit save in its private profile directory.\n");
+    return false;
+}
+
+static void Space(const char **p)
+{
+    while (**p == ' ' || **p == '\t' || **p == '\r' || **p == '\n') ++*p;
+}
+static bool Token(const char **p, char c)
+{
+    Space(p);
+    if (**p != c) return false;
+    ++*p; return true;
+}
+static bool String(const char **p, char *out, size_t cap)
+{
+    size_t n = 0;
+    if (!Token(p, '"')) return false;
+    while (**p && **p != '"') {
+        unsigned char c = *(*p)++;
+        if (c < 32 || c > 126) return false;
+        if (c == '\\') {
+            c = *(*p)++;
+            if (!c) return false;
+            if (c == 'u') {
+                unsigned v = 0;
+                for (int i = 0; i < 4; i++) {
+                    char h = **p;
+                    if (!h) return false;
+                    ++*p;
+                    if (h >= '0' && h <= '9') v = v * 16 + h - '0';
+                    else if (h >= 'a' && h <= 'f') v = v * 16 + h - 'a' + 10;
+                    else if (h >= 'A' && h <= 'F') v = v * 16 + h - 'A' + 10;
+                    else return false;
+                }
+                if (v < 32 || v > 126) return false;
+                c = v;
+            } else if (c != '"' && c != '\\' && c != '/') return false;
+        }
+        if (n + 1 >= cap) return false;
+        out[n++] = c;
+    }
+    out[n] = 0;
+    return Token(p, '"');
+}
+static bool Number(const char **p, unsigned *out)
+{
+    unsigned n = 0;
+    Space(p);
+    if (**p < '0' || **p > '9') return false;
+    if (**p == '0' && (*p)[1] >= '0' && (*p)[1] <= '9') return false;
+    while (**p >= '0' && **p <= '9') {
+        unsigned d = *(*p)++ - '0';
+        if (n > (2147483647U - d) / 10) return false;
+        n = n * 10 + d;
+    }
+    *out = n; return true;
+}
+static bool Request(const char *p, unsigned *id, unsigned *frames, uint16_t *keys, char *op)
+{
+    static const char *names[] = {"A", "B", "SELECT", "START", "RIGHT", "LEFT", "UP", "DOWN", "R", "L"};
+    unsigned seen = 0;
+    *keys = 0; *id = 0; *frames = 0;
+    if (!Token(&p, '{')) return false;
+    do {
+        char key[16]; unsigned flag;
+        if (!String(&p, key, sizeof(key)) || !Token(&p, ':')) return false;
+        if (!strcmp(key, "id")) flag = 1;
+        else if (!strcmp(key, "op")) flag = 2;
+        else if (!strcmp(key, "frames")) flag = 4;
+        else if (!strcmp(key, "buttons")) flag = 8;
+        else return false;
+        if (seen & flag) return false;
+        seen |= flag;
+        if (flag == 1 && !Number(&p, id)) return false;
+        if (flag == 2 && !String(&p, op, 16)) return false;
+        if (flag == 4 && (!Number(&p, frames) || !*frames || *frames > 120)) return false;
+        if (flag == 8) {
+            if (!Token(&p, '[')) return false;
+            Space(&p);
+            if (*p != ']') do {
+                char button[16]; unsigned i;
+                if (!String(&p, button, sizeof(button))) return false;
+                for (i = 0; i < 10 && strcmp(button, names[i]); i++);
+                if (i == 10 || (*keys & (1 << i))) return false;
+                *keys |= 1 << i;
+            } while (Token(&p, ','));
+            if (!Token(&p, ']')) return false;
+        }
+    } while (Token(&p, ','));
+    if (!Token(&p, '}')) return false;
+    Space(&p);
+    if (*p || (seen & 3) != 3) return false;
+    if (!strcmp(op, "press")) return seen == 15;
+    return seen == 3 && (!strcmp(op, "observe") || !strcmp(op, "screenshot"));
+}
+static void Error(unsigned id, const char *error)
+{
+    s.size = snprintf(s.output, sizeof(s.output), "{\"id\":%u,\"ok\":false,\"error\":\"%s\"}\n", id, error);
+    s.sent = 0; s.deadline = Now() + 5000;
+}
+static void Reply(bool screenshot)
+{
+    FILE *file = fmemopen(s.output, sizeof(s.output), "w");
+    if (!file) { Error(s.id, "state_unavailable"); return; }
+    fprintf(file, "{\"id\":%u,\"ok\":true,\"state\":", s.id);
+    s.state(file, s.frame);
+    bool failed = fflush(file) != 0 || ferror(file);
+    long end = ftell(file);
+    if (!failed && end > 0 && end < RESPONSE_CAP) {
+        while (end && (s.output[end - 1] == '\n' || s.output[end - 1] == '\r'
+               || s.output[end - 1] == ' ' || s.output[end - 1] == '\t')) end--;
+        if (fseek(file, end, SEEK_SET)) failed = true;
+    }
+    if (screenshot) fprintf(file, ",\"screenshot\":\"%s\"", s.shot);
+    fputs("}\n", file);
+    long size = ftell(file);
+    failed = failed || ferror(file) || size < 0 || size >= RESPONSE_CAP - 1;
+    if (fclose(file)) failed = true;
+    if (failed) { Error(s.id, "state_too_large"); return; }
+    s.size = size; s.sent = 0; s.deadline = Now() + 5000;
+}
+static void Execute(void)
+{
+    char op[16]; unsigned id, frames; uint16_t keys;
+    bool valid = Request(s.input, &id, &frames, &keys, op);
+    if (s.remaining || s.size) {
+        /* A pipelined request cancels the hold rather than queueing unbounded work. */
+        s.remaining = s.buttons = 0;
+        if (s.sent) { Disconnect(); return; }
+        Error(id, "busy"); return;
+    }
+    if (!valid) { Error(id, "malformed"); return; }
+    s.id = id;
+    if (!strcmp(op, "press")) {
+        s.buttons = keys; s.remaining = frames; s.deadline = Now() + 5000;
+    } else {
+        if (!strcmp(op, "screenshot")) {
+            int fd = openat(s.dir, "screenshot.ppm", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+            /* Replace the fixed output without ever following an existing link. */
+            if (fd < 0 && errno == EEXIST) {
+                struct stat st;
+                if (!fstatat(s.dir, "screenshot.ppm", &st, AT_SYMLINK_NOFOLLOW)
+                    && S_ISREG(st.st_mode) && st.st_uid == geteuid() && st.st_nlink == 1
+                    && !unlinkat(s.dir, "screenshot.ppm", 0))
+                    fd = openat(s.dir, "screenshot.ppm", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+            }
+            if (fd < 0) { Error(id, "screenshot_unavailable"); return; }
+            FILE *f = fdopen(fd, "wb");
+            if (!f) { close(fd); Error(id, "screenshot_unavailable"); return; }
+            bool ok = s.capture(f);
+            if (fclose(f)) ok = false;
+            if (!ok) { Error(id, "screenshot_unavailable"); return; }
+        }
+        Reply(!strcmp(op, "screenshot"));
+    }
+}
+void PlayerControl_BeforeFrame(void)
+{
+    if (s.listener < 0) return;
+    int client = accept(s.listener, NULL, NULL);
+    if (client >= 0) {
+        if (s.client >= 0) {
+            const char busy[] = "{\"id\":null,\"ok\":false,\"error\":\"busy\"}\n";
+            send(client, busy, sizeof(busy) - 1, MSG_DONTWAIT | MSG_NOSIGNAL);
+            close(client);
+        } else if (fcntl(client, F_SETFL, O_NONBLOCK) || fcntl(client, F_SETFD, FD_CLOEXEC)) close(client);
+        else { s.client = client; s.deadline = Now() + 30000; }
+    }
+    if (s.client < 0) return;
+    if (Now() > s.deadline) { Disconnect(); return; }
+    /* One bounded receive and send per frame. No waiting for an agent. */
+    ssize_t n = recv(s.client, s.input + s.used, REQUEST_CAP - 1 - s.used, 0);
+    if (!n) { Disconnect(); return; }
+    if (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) { Disconnect(); return; }
+    if (n > 0) {
+        if (s.sent) { Disconnect(); return; }
+        bool first = s.used == 0;
+        s.used += n; s.input[s.used] = 0;
+        char *line = memchr(s.input, '\n', s.used);
+        if (memchr(s.input, 0, s.used)) { s.used = 0; Error(0, "malformed"); }
+        else if (line) {
+            if ((size_t)(line - s.input) + 1 != s.used) {
+                s.remaining = s.buttons = 0; Error(0, "busy");
+            } else { *line = 0; Execute(); }
+            s.used = 0;
+        } else if (s.used == REQUEST_CAP - 1) {
+            s.remaining = s.buttons = 0; s.used = 0; Error(0, "oversized");
+            s.closeAfterWrite = true;
+        } else if (first && !s.remaining && !s.size) s.deadline = Now() + 5000;
+    }
+    if (s.size) {
+        n = send(s.client, s.output + s.sent, s.size - s.sent, MSG_DONTWAIT | MSG_NOSIGNAL);
+        if (n > 0) {
+            s.sent += n;
+            if (s.sent == s.size) {
+                if (s.closeAfterWrite) { Disconnect(); return; }
+                s.sent = s.size = 0; s.deadline = Now() + 30000;
+            }
+        } else if (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) Disconnect();
+    }
+}
+void PlayerControl_AfterFrame(uint32_t frame)
+{
+    s.frame = frame;
+    if (s.remaining && !--s.remaining) { s.buttons = 0; Reply(false); }
+}
+uint16_t PlayerControl_Buttons(void) { return s.buttons; }
+#else
+bool PlayerControl_Init(const char *path, const char *savePath,
+                        void (*state)(FILE *, uint32_t), bool (*shot)(FILE *))
+{
+    (void)savePath; (void)state; (void)shot;
+    if (path) fprintf(stderr, "Player control requires Unix sockets.\n");
+    return path == NULL;
+}
+void PlayerControl_Close(void) {}
+void PlayerControl_BeforeFrame(void) {}
+void PlayerControl_AfterFrame(uint32_t frame) { (void)frame; }
+uint16_t PlayerControl_Buttons(void) { return 0; }
+#endif
+#endif
diff --git a/src/world/repeat_repel.c b/src/world/repeat_repel.c
new file mode 100644
index 0000000000..1a45cc9baf
--- /dev/null
+++ b/src/world/repeat_repel.c
@@ -0,0 +1,150 @@
+#ifdef PORTABLE
+/* Repel-only adaptation of RHH's pokeemerald-expansion src/sprays.c,
+ * c460a8661dfa0598ae25d42a968c690ecbf489c6, based on pret/pokeemerald.
+ * See upstream README.md and CREDITS.md for contributor credits. This is not
+ * a new licensing grant. Enumeration/menu flow is retained; native item IDs,
+ * script ownership and transactional consumption are platform adapters. */
+#include "global.h"
+#include "battle_pike.h"
+#include "battle_pyramid.h"
+#include "event_data.h"
+#include "field_specials.h"
+#include "item.h"
+#include "link.h"
+#include "main.h"
+#include "menu.h"
+#include "overworld.h"
+#include "palette.h"
+#include "script.h"
+#include "script_menu.h"
+#include "strings.h"
+#include "platform/native_link.h"
+#include "platform/repeat_repel.h"
+#include "platform/world_activity.h"
+#include "platform/world_coop.h"
+#include "constants/battle_pyramid.h"
+#include "constants/flags.h"
+#include "constants/vars.h"
+
+extern const u8 RepeatRepel_AfterBegin[];
+extern const u8 RepeatRepel_AfterDraw[];
+extern const u8 RepeatRepel_AfterCommit[];
+
+/* Stock IDs are Repel=86, Super=83, Max=84, not Expansion's contiguous IDs. */
+static const u16 sRepels[] = {ITEM_REPEL, ITEM_SUPER_REPEL, ITEM_MAX_REPEL};
+static struct
+{
+    bool8 active;
+    u8 count;
+    u16 items[ARRAY_COUNT(sRepels)];
+    struct SaveBlock1 *save1;
+    struct SaveBlock2 *save2;
+    struct WarpData location;
+} sRepeatRepel;
+
+static bool8 FieldIsSafe(void)
+{
+    /* Our own expiry script locks controls. Rejecting every enabled script
+     * would reject the genuine interaction; exact script operands identify it. */
+    return gSaveBlock1Ptr != NULL && gSaveBlock2Ptr != NULL
+        && gMain.callback2 == CB2_Overworld && !gMain.inBattle
+        && !gPaletteFade.active && ArePlayerFieldControlsLocked()
+        && GetTaskCount() < NUM_TASKS
+        && !gWirelessCommType && !gReceivedRemoteLinkPlayers
+        && !IsOverworldLinkActive() && !NativeLink_IsActive()
+        && !WorldCoop_IsBattle() && !WorldCoop_IsPrivateRewards()
+        && !WorldActivity_OwnsFieldInput() && !WorldActivity_IsEncounterPending()
+        && !InUnionRoom() && !InMultiPartnerRoom() && !InBattlePike()
+        && CurrentBattlePyramidLocation() == PYRAMID_LOCATION_NONE
+        && !FlagGet(FLAG_STORING_ITEMS_IN_PYRAMID_BAG)
+        && VarGet(VAR_REPEL_STEP_COUNT) == 0;
+}
+
+/* Expansion CountOrGetSprays, specialized to existing owned Repels only.
+ * Snapshot the offered identities, never infer a selection by live bag order. */
+static u8 CountOrGetSprays(u16 *items)
+{
+    u8 i, count = 0;
+    for (i = 0; i < ARRAY_COUNT(sRepels); i++)
+        if (CheckBagHasItem(sRepels[i], 1))
+            items[count++] = sRepels[i];
+    return count;
+}
+
+static bool8 FlowIsSafe(const u8 *scriptPtr)
+{
+    return sRepeatRepel.active && ScriptContext_IsAt(scriptPtr) && FieldIsSafe()
+        && gSaveBlock1Ptr == sRepeatRepel.save1
+        && gSaveBlock2Ptr == sRepeatRepel.save2
+        && gSaveBlock1Ptr->location.mapGroup == sRepeatRepel.location.mapGroup
+        && gSaveBlock1Ptr->location.mapNum == sRepeatRepel.location.mapNum;
+}
+
+void RepeatRepel_Begin(void)
+{
+    sRepeatRepel.active = FALSE;
+    sRepeatRepel.count = 0;
+    gSpecialVar_Result = 0;
+    if (!ScriptContext_IsAt(RepeatRepel_AfterBegin) || !FieldIsSafe())
+        return;
+    sRepeatRepel.save1 = gSaveBlock1Ptr;
+    sRepeatRepel.save2 = gSaveBlock2Ptr;
+    sRepeatRepel.location = gSaveBlock1Ptr->location;
+    sRepeatRepel.count = CountOrGetSprays(sRepeatRepel.items);
+    sRepeatRepel.active = sRepeatRepel.count != 0;
+    gSpecialVar_Result = sRepeatRepel.count;
+    /* GetSprayId in the no-persistent-last-item branch returns the first owned
+     * strength. Script buffers this name for the single-strength yes/no. */
+    if (sRepeatRepel.active)
+        gSpecialVar_0x8004 = sRepeatRepel.items[0];
+}
+
+void RepeatRepel_DrawMenu(void)
+{
+    struct MenuAction menuItems[ARRAY_COUNT(sRepels) + 1] = {0};
+    u8 i;
+    gSpecialVar_Result = FALSE;
+    if (!FlowIsSafe(RepeatRepel_AfterDraw))
+        return;
+    /* Printing the expiry text can yield frames. Offer only still-owned items. */
+    sRepeatRepel.count = CountOrGetSprays(sRepeatRepel.items);
+    if (sRepeatRepel.count == 0)
+        return;
+    for (i = 0; i < sRepeatRepel.count; i++)
+        menuItems[i].text = GetItemName(sRepeatRepel.items[i]);
+    menuItems[sRepeatRepel.count].text = gText_Cancel2;
+    /* Expansion DrawSprayMenu layout, native input/cleanup task. The actions
+     * are printed synchronously, so no task stores a stack pointer. */
+    gSpecialVar_Result = ScriptMenu_DrawRepelChoice(18,
+        10 - 2 * sRepeatRepel.count, menuItems, sRepeatRepel.count + 1);
+}
+
+void RepeatRepel_Commit(void)
+{
+    u16 selection = gSpecialVar_Result;
+    u16 item = ITEM_NONE, steps = 0;
+    u8 i;
+    bool8 valid = FlowIsSafe(RepeatRepel_AfterCommit);
+    /* One-shot even on failure. Cancel/out-of-range cannot become an item ID. */
+    sRepeatRepel.active = FALSE;
+    gSpecialVar_Result = FALSE;
+    if (!valid || selection >= sRepeatRepel.count)
+        return;
+    item = sRepeatRepel.items[selection];
+    for (i = 0; i < ARRAY_COUNT(sRepels); i++)
+        if (item == sRepels[i])
+            steps = GetItemHoldEffectParam(item);
+    if (!steps || !CheckBagHasItem(item, 1) || !RemoveBagItem(item, 1))
+        return;
+    /* No yields/callbacks between revalidation, successful removal and write. */
+    VarSet(VAR_REPEL_STEP_COUNT, steps);
+    gSpecialVar_0x8004 = item;
+    gSpecialVar_Result = TRUE;
+}
+
+void RepeatRepel_End(void)
+{
+    sRepeatRepel.active = FALSE;
+    sRepeatRepel.count = 0;
+}
+#endif
