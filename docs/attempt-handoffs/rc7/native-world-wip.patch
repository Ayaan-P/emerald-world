+bool8 WorldBridge_GeneratedCaveReady(void)
+{
+#if GENERATED_MAP_READY
+    return sWorld.connected && sWorld.caveAvailable && sWorld.caveState == CAVE_READY
+        && sWorld.snapshotAge <= 180;
+#else
