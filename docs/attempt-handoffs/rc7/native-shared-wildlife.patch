+
+bool8 StartSharedWildlifeBattle(u32 species, u32 level, u32 personality, u32 shiny)
+{
+    if (shiny > 1 || !CheckValidOWESpecies(species) || level < MIN_LEVEL || level > MAX_LEVEL)
+        return FALSE;
+    ClearNativeOWEEncounter(NULL);
+    ZeroEnemyPartyMons();
+    CreateMonWithIVs(&gParties[B_TRAINER_OPPONENT_A][0], species, level,
+        personality,
+        OTID_STRUCT_PLAYER_ID,USE_RANDOM_IVS);
+    SetMonData(&gParties[B_TRAINER_OPPONENT_A][0], MON_DATA_IS_SHINY, &shiny);
+    GiveMonInitialMoveset(&gParties[B_TRAINER_OPPONENT_A][0]);
+    BattleSetup_StartWildBattle();
+    return TRUE;
+}
