+u32 SpawnSharedWildlifeObject(u32 localId, u32 species, s32 x, s32 y, u32 personality, u32 shiny)
+{
+    struct ObjectEventTemplate template = {0};
+    bool32 female;
+    if (shiny > 1 || !CheckValidOWESpecies(species))
+        return OBJECT_EVENTS_COUNT;
+    female = GetGenderFromSpeciesAndPersonality(species,personality) == MON_FEMALE;
+    if (!CheckCanLoadOWE(species,female,shiny,x+MAP_OFFSET,y+MAP_OFFSET))
+        return OBJECT_EVENTS_COUNT;
+    template.localId=localId;
+    template.graphicsId=GetGraphicsIdForMon(species,shiny,female);
+    template.x=x; template.y=y;
+    template.elevation=MapGridGetElevationAt(x+MAP_OFFSET,y+MAP_OFFSET);
+    template.movementType=MOVEMENT_TYPE_NONE;
+    template.trainerType=TRAINER_TYPE_NONE;
+    return SpawnSpecialObjectEvent(&template);
