diff --git a/src/world/shared_wildlife.c b/src/world/shared_wildlife.c
new file mode 100644
index 0000000000000000000000000000000000000000..e15a1f86bf92c2bdc9f784d53651c82ff7e975e9
--- /dev/null
+++ b/src/world/shared_wildlife.c
@@ -0,0 +1,219 @@
+#ifdef PORTABLE
+#include "global.h"
+#include "main.h"
+#include "overworld.h"
+#include "palette.h"
+#include "script.h"
+#include "sprite.h"
+#include "fieldmap.h"
+#include "field_player_avatar.h"
+#include "event_object_movement.h"
+#include "platform/shared_wildlife.h"
+#include "platform/world_bridge.h"
+#include "platform/world_activity.h"
+#include "platform/overworld_encounters.h"
+#include "constants/event_objects.h"
+#include <limits.h>
+#include <string.h>
+
+/* Separate from trainer slots 160..199 and personal OWE slots 249..252. */
+#define SHARED_LOCALID 200
+#define SHARED_MARKER 0x5753
+struct SharedProjection {
+    char id[33];
+    unsigned object, sprite, group, num;
+};
+static struct SharedProjection sObjects[SHARED_WILDLIFE_MAX];
+static struct SharedWildlifeSnapshot sView;
+static unsigned sPhase, sWait, sFrame = UINT_MAX;
+static u16 sPreviousKeys;
+static bool8 sLocked;
+static char sEpoch[33], sId[33], sLease[33], sHandled[33];
+static const char *sStatus = "Shared Pokemon published by the host. A requests an encounter.";
+
+const char *SharedWildlife_Status(void) { return sStatus; }
+
+static bool8 Field(void)
+{
+    return gSaveBlock1Ptr && gSaveBlock2Ptr && gMain.callback1 == CB1_Overworld
+        && gMain.callback2 == CB2_Overworld && !gMain.inBattle
+        && !gPaletteFade.active && !ScriptContext_IsEnabled()
+        && !WorldActivity_OwnsFieldInput();
+}
+static bool8 Owned(unsigned i)
+{
+    const struct SharedProjection *r=&sObjects[i];
+    const struct ObjectEvent *o;
+    if (!r->id[0] || r->object>=OBJECT_EVENTS_COUNT || r->sprite>=MAX_SPRITES) return FALSE;
+    o=&gObjectEvents[r->object];
+    return o->active && !o->isPlayer && o->localId==SHARED_LOCALID+i
+        && o->mapGroup==r->group && o->mapNum==r->num && o->spriteId==r->sprite
+        && gSprites[r->sprite].inUse && gSprites[r->sprite].data[0]==(int)r->object
+        && gSprites[r->sprite].data[7]==SHARED_MARKER;
+}
+static void Remove(unsigned i)
+{
+    if (Owned(i)) RemoveObjectEvent(&gObjectEvents[sObjects[i].object]);
+    memset(&sObjects[i],0,sizeof(sObjects[i]));
+}
+void SharedWildlife_ClearSprites(void)
+{
+    unsigned i;
+    for(i=0;i<SHARED_WILDLIFE_MAX;++i) Remove(i);
+}
+static void Cancel(const char *status)
+{
+    if (sPhase && sLease[0])
+        WorldBridge_SharedWildlifeRequest(sPhase==2 ? 4 : 3,sEpoch,sId,sLease);
+    if (sLocked && Field()) {
+        UnlockPlayerFieldControls();
+        UnfreezeObjectEvents();
+    }
+    sLocked=FALSE; sPhase=sWait=0;
+    sEpoch[0]=sId[0]=sLease[0]=0;
+    sStatus=status;
+}
+static bool8 Facing(const struct SharedWildlifeMon *mon)
+{
+    struct ObjectEvent *p;
+    int dx=0,dy=0;
+    if (gPlayerAvatar.objectEventId>=OBJECT_EVENTS_COUNT) return FALSE;
+    p=&gObjectEvents[gPlayerAvatar.objectEventId];
+    if(!p->active || !p->isPlayer || p->mapGroup!=mon->group || p->mapNum!=mon->num) return FALSE;
+    switch(GetPlayerFacingDirection()) {
+    case DIR_SOUTH: dy=1; break;
+    case DIR_NORTH: dy=-1; break;
+    case DIR_WEST: dx=-1; break;
+    case DIR_EAST: dx=1; break;
+    default: return FALSE;
+    }
+    return p->currentCoords.x+dx==(int)mon->x+MAP_OFFSET
+        && p->currentCoords.y+dy==(int)mon->y+MAP_OFFSET;
+}
+static bool8 Blocked(unsigned slot, const struct SharedWildlifeMon *mon)
+{
+    unsigned i;
+    if (MapGridGetCollisionAt(mon->x+MAP_OFFSET,mon->y+MAP_OFFSET)) return TRUE;
+    for(i=0;i<OBJECT_EVENTS_COUNT;++i) {
+        const struct ObjectEvent *o=&gObjectEvents[i];
+        if (o->active && (o->localId==SHARED_LOCALID+slot
+            || (o->currentCoords.x==(int)mon->x+MAP_OFFSET && o->currentCoords.y==(int)mon->y+MAP_OFFSET))) return TRUE;
+    }
+    if(gMapHeader.events) for(i=0;i<gMapHeader.events->objectEventCount;++i)
+        if(gSaveBlock1Ptr->objectEventTemplates[i].localId==SHARED_LOCALID+slot) return TRUE;
+    return FALSE;
+}
+static void Project(void)
+{
+    unsigned i,j;
+    for(i=0;i<SHARED_WILDLIFE_MAX;++i) {
+        const struct SharedWildlifeMon *mon=NULL;
+        for(j=0;j<sView.count;++j) if(!strcmp(sObjects[i].id,sView.mons[j].id)) mon=&sView.mons[j];
+        if(!mon || mon->reserved || mon->group!=gSaveBlock1Ptr->location.mapGroup
+            || mon->num!=gSaveBlock1Ptr->location.mapNum || !Owned(i)) Remove(i);
+    }
+    for(j=0;j<sView.count;++j) {
+        const struct SharedWildlifeMon *mon=&sView.mons[j];
+        unsigned object;
+        if(mon->reserved || mon->group!=gSaveBlock1Ptr->location.mapGroup || mon->num!=gSaveBlock1Ptr->location.mapNum) continue;
+        for(i=0;i<SHARED_WILDLIFE_MAX;++i) if(!strcmp(sObjects[i].id,mon->id)) break;
+        if(i<SHARED_WILDLIFE_MAX) continue;
+        for(i=0;i<SHARED_WILDLIFE_MAX;++i) if(!sObjects[i].id[0] && !Blocked(i,mon)) break;
+        if(i==SHARED_WILDLIFE_MAX) continue;
+        object=SpawnSharedWildlifeObject(SHARED_LOCALID+i,mon->species,mon->x,mon->y,mon->personality,mon->shiny);
+        if(object>=OBJECT_EVENTS_COUNT) continue;
+        if(gObjectEvents[object].spriteId>=MAX_SPRITES) {
+            RemoveObjectEvent(&gObjectEvents[object]);
+            continue;
+        }
+        strcpy(sObjects[i].id,mon->id);
+        sObjects[i].object=object; sObjects[i].sprite=gObjectEvents[object].spriteId;
+        sObjects[i].group=mon->group; sObjects[i].num=mon->num;
+        gSprites[sObjects[i].sprite].data[7]=SHARED_MARKER;
+    }
+}
+void SharedWildlife_Update(u32 frame)
+{
+    bool8 have;
+    if(sFrame==frame) return;
+    sFrame=frame;
+    have=WorldBridge_SharedWildlifeSnapshot(&sView);
+    if(!have || !Field()) {
+        if(sPhase) Cancel(have ? "Shared encounter stopped before battle."
+            : "Connection lost. The host may retain this encounter.");
+        SharedWildlife_ClearSprites();
+        return;
+    }
+    if(sPhase) {
+        if(strcmp(sEpoch,sView.epoch) || ++sWait>300
+            || OverworldEncounters_UnavailableReason()!=NULL) {
+            Cancel("Shared encounter unavailable. Please try again.");
+            return;
+        }
+        if(sView.battleSeen && !strcmp(sId,sView.battle.id) && !strcmp(sLease,sView.battleLease)) {
+            if(!Facing(&sView.battle)) { Cancel("Shared encounter moved out of reach."); return; }
+            /* Consume the receipt locally BEFORE callbacks can change the scene.
+             * Duplicated snapshots can only acknowledge it, never restart it. */
+            strcpy(sHandled,sView.battleLease);
+            SharedWildlife_ClearSprites();
+            sPhase=sWait=0; sLocked=FALSE;
+            if(!StartSharedWildlifeBattle(sView.battle.species,sView.battle.level,sView.battle.personality,sView.battle.shiny)) {
+                sHandled[0]=0;
+                WorldBridge_SharedWildlifeRequest(4,sEpoch,sId,sLease);
+                UnlockPlayerFieldControls(); UnfreezeObjectEvents();
+                sStatus="Battle could not start. Returning the shared encounter.";
+            } else {
+                WorldBridge_SharedWildlifeRequest(2,sEpoch,sId,sLease);
+                sStatus="Shared encounter started.";
+            }
+            return;
+        }
+        if(sPhase==1 && !strcmp(sId,sView.leaseId)) {
+            strcpy(sLease,sView.lease);
+            if(WorldBridge_SharedWildlifeRequest(1,sEpoch,sId,sLease)) sPhase=2;
+        }
+        return;
+    }
+    if(sView.battleSeen) {
+        /* Only receipts already handed to battle are acknowledged as consumed.
+         * Late admission after cancellation can be returned explicitly. Silence
+         * or disconnect alone never grants the server permission to reoffer it. */
+        if(strcmp(sHandled,sView.battleLease)) {
+            sStatus="Canceled before battle. Returning the shared encounter.";
+            WorldBridge_SharedWildlifeRequest(4,sView.epoch,sView.battle.id,sView.battleLease);
+        } else WorldBridge_SharedWildlifeRequest(2,sView.epoch,sView.battle.id,sView.battleLease);
+    }
+    else if(sView.leaseId[0])
+        WorldBridge_SharedWildlifeRequest(3,sView.epoch,sView.leaseId,sView.lease);
+    if(ArePlayerFieldControlsLocked() || gPlayerAvatar.tileTransitionState) return;
+    Project();
+}
+u16 SharedWildlife_FilterInput(u16 keys)
+{
+    unsigned i,j;
+    u16 pressed=keys & ~sPreviousKeys;
+    sPreviousKeys=keys;
+    if(sPhase) {
+        if(pressed & B_BUTTON) Cancel("Shared encounter canceled.");
+        return 0;
+    }
+    if(!(keys&A_BUTTON) || !Field() || ArePlayerFieldControlsLocked()
+        || gPlayerAvatar.tileTransitionState || !WorldBridge_SharedWildlifeSnapshot(&sView)) return keys;
+    for(i=0;i<SHARED_WILDLIFE_MAX;++i) if(Owned(i))
+        for(j=0;j<sView.count;++j) {
+            const struct SharedWildlifeMon *mon=&sView.mons[j];
+            if(strcmp(sObjects[i].id,mon->id) || !Facing(mon)) continue;
+            /* Suppress normal A even when unavailable: a synthetic Pokemon has
+             * no map script and must never fall through to template lookup. */
+            if((pressed&A_BUTTON) && !mon->reserved && OverworldEncounters_UnavailableReason()==NULL
+                && WorldBridge_SharedWildlifeRequest(0,sView.epoch,mon->id,NULL)) {
+                strcpy(sEpoch,sView.epoch); strcpy(sId,mon->id); sLease[0]=0;
+                sPhase=1; sWait=0; sLocked=TRUE;
+                LockPlayerFieldControls(); FreezeObjectEvents(); StopPlayerAvatar();
+                sStatus="Waiting for shared encounter. B cancels.";
+            }
+            return keys & ~A_BUTTON;
+        }
+    return keys;
+}
+#endif
diff --git a/src/world/shared_wildlife_wire.c b/src/world/shared_wildlife_wire.c
new file mode 100644
index 0000000000000000000000000000000000000000..9faa6c09c63b3019a5325bf41c0797dd63e59e0e
--- /dev/null
+++ b/src/world/shared_wildlife_wire.c
@@ -0,0 +1,84 @@
+#ifdef PORTABLE
+#include "platform/shared_wildlife_wire.h"
+#include <limits.h>
+#include <string.h>
+
+static int HexId(const char *text)
+{
+    unsigned i;
+    if (strlen(text) != 32) return 0;
+    for (i = 0; i < 32; ++i)
+        if (!((text[i] >= '0' && text[i] <= '9') || (text[i] >= 'a' && text[i] <= 'f'))) return 0;
+    return 1;
+}
+static int Number(const char *text, unsigned *value)
+{
+    unsigned n = 0;
+    if (!*text || (text[0] == '0' && text[1])) return 0;
+    for (; *text; ++text) {
+        unsigned digit = (unsigned)(*text - '0');
+        if (digit > 9 || n > (UINT_MAX - digit) / 10) return 0;
+        n = n * 10 + digit;
+    }
+    *value = n;
+    return 1;
+}
+static int Mon(struct SharedWildlifeMon *mon, char **fields)
+{
+    unsigned values[8], i;
+    for (i = 0; i < 8; ++i) if (!Number(fields[i], &values[i])) return 0;
+    if (values[0] > 255 || values[1] > 255 || values[2] > 32767 || values[3] > 32767
+        || !values[4] || values[4] > 65535 || !values[5] || values[5] > 100 || values[7] > 1) return 0;
+    mon->group=values[0]; mon->num=values[1]; mon->x=values[2]; mon->y=values[3];
+    mon->species=values[4]; mon->level=values[5];
+    mon->personality=values[6]; mon->shiny=values[7];
+    return 1;
+}
+int SharedWildlifeWire_Line(struct SharedWildlifeSnapshot *out, unsigned count, char **tokens)
+{
+    unsigned i;
+    if (!count) return 0;
+    if (!strcmp(tokens[0], "WILDLIFE3")) {
+        if (count != 4 || out->seen || !HexId(tokens[1]) || !Number(tokens[2], &out->revision)
+            || !Number(tokens[3], &out->expected) || out->expected > SHARED_WILDLIFE_MAX) return 0;
+        strcpy(out->epoch, tokens[1]); out->seen = 1;
+        return 1;
+    }
+    if (!out->seen) return 0;
+    if (!strcmp(tokens[0], "WILDMON")) {
+        struct SharedWildlifeMon mon = {0};
+        if (count != 11 || out->count >= out->expected || !HexId(tokens[1]) || !Mon(&mon, tokens+2)) return 0;
+        if (!strcmp(tokens[10], "reserved")) mon.reserved = 1;
+        else if (strcmp(tokens[10], "available")) return 0;
+        strcpy(mon.id, tokens[1]);
+        for (i=0; i<out->count; ++i) {
+            const struct SharedWildlifeMon *old=&out->mons[i];
+            if (!strcmp(old->id,mon.id) || (old->group==mon.group && old->num==mon.num
+                && old->x==mon.x && old->y==mon.y)) return 0;
+        }
+        out->mons[out->count++] = mon;
+        return 1;
+    }
+    if (!strcmp(tokens[0], "WILDLEASE")) {
+        if (count != 3 || out->leaseId[0] || !HexId(tokens[1]) || !HexId(tokens[2])) return 0;
+        strcpy(out->leaseId,tokens[1]); strcpy(out->lease,tokens[2]);
+        return 1;
+    }
+    if (!strcmp(tokens[0], "WILDBATTLE")) {
+        if (count != 11 || out->battleSeen || !HexId(tokens[1]) || !HexId(tokens[2])
+            || !Mon(&out->battle,tokens+3)) return 0;
+        strcpy(out->battle.id,tokens[1]); strcpy(out->battleLease,tokens[2]); out->battleSeen=1;
+        return 1;
+    }
+    return 0;
+}
+int SharedWildlifeWire_Complete(const struct SharedWildlifeSnapshot *out)
+{
+    unsigned i;
+    if (!out->seen) return 1;
+    if (out->count != out->expected || (out->battleSeen && out->leaseId[0])) return 0;
+    for (i=0; i<out->count; ++i)
+        if (out->battleSeen && !strcmp(out->battle.id,out->mons[i].id)) return 0;
+    return 1;
+}
+#endif
