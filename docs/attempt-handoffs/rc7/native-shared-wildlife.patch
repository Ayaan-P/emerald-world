 u8 WorldCoop_StageSlot(u8 battler)
 {
     return (battler & BIT_SIDE) ? gBattlerPartyIndexes[battler]
         : (battler / 2) * MULTI_PARTY_SIZE + gBattlerPartyIndexes[battler];
 }

 static u8 StagedKnockOffMask(void)
 {
     u8 stage, result = 0;
     for (stage = 0; stage < PARTY_SIZE; ++stage)
         if (gBattleStruct->partyState[StageTrainer(stage)][stage % MULTI_PARTY_SIZE].isKnockedOff)
             result |= 1u << stage;
     return result;
 }

 static void SetStagedKnockOff(u8 stage, bool8 knockedOff)
 {
     gBattleStruct->partyState[StageTrainer(stage)][stage % MULTI_PARTY_SIZE].isKnockedOff = knockedOff;
 }

