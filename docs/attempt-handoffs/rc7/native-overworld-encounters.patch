 void SavePlayerParty(void)
 {
     int i;
     *GetSavedPlayerPartyCount() = gPartiesCount[B_TRAINER_PLAYER];
 
     for (i = 0; i < PARTY_SIZE; i++)
         SavePlayerPartyMon(i, &gParties[B_TRAINER_PLAYER][i]);
