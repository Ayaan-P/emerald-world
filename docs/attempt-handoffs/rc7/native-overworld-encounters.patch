+#include "constants/region_map_sections.h"
+
+/* Session-only opt-in. No save layout, world rule or multiplayer protocol changes.
+ * Expansion owns species selection, sprites, movement and battle creation. */
+static bool8 sEnabled;
+
+bool8 OverworldEncounters_Enabled(void)
+{
+    return sEnabled;
+}
+
+const char *OverworldEncounters_UnavailableReason(void)
+{
+    u32 i;
+    /* Enabled includes connecting and interrupted sessions, not just peers
+     * currently visible. A disconnected client must not become a solo owner. */
+    if (WorldBridge_Enabled())
+        return "Visible encounters are solo only. Leave the world in the launcher first.";
+    if (GeneratedMap_IsInside() || GeneratedMap_EntryPending())
+        return "Return from the generated area first.";
+    if (!gSaveBlock1Ptr || !gSaveBlock2Ptr)
+        return "Load your trainer first.";
+    if (GetSafariZoneFlag() || InBattlePike()
+        || CurrentBattlePyramidLocation() != PYRAMID_LOCATION_NONE
+        || gMapHeader.regionMapSectionId == MAPSEC_BATTLE_FRONTIER)
+        return "Leave the Safari Zone or Battle Frontier first.";
+    if (gMain.inBattle || IsOverworldLinkActive() || NativeLink_IsActive())
+        return "Finish your battle or link activity first.";
+    for (i = 0; i < PARTY_SIZE; ++i)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES)
+            && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG)
+            && GetMonData(&gPlayerParty[i], MON_DATA_HP))
+            return NULL;
+    return "You need a conscious Pokemon that is not an Egg.";
+}
+
+bool8 OverworldEncounters_Allowed(void)
+{
+    return sEnabled && OverworldEncounters_UnavailableReason() == NULL;
+}
+
+void OverworldEncounters_Toggle(void)
+{
+    if (!sEnabled && OverworldEncounters_UnavailableReason() != NULL)
+        return;
+    sEnabled = !sEnabled;
+    if (!sEnabled)
+        DespawnAllOverworldWildEncounters(OWE_GENERATED, 0);
+    else
+        SetMinimumOWESpawnTimer();
+}
+#endif
