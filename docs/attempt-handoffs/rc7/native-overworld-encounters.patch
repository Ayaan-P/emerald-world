 static void Close(void)
 {
     if (sMenu.window != WINDOW_NONE)
     {
         ClearStdWindowAndFrame(sMenu.window, TRUE);
         RemoveWindow(sMenu.window);
         sMenu.window = WINDOW_NONE;
