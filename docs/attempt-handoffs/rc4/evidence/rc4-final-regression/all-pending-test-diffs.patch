+            with self.assertRaisesRegex(ValueError, 'Mega Evolution requires modernSplit'):
+                publish(root, dict(value, rules=value['rules'] | {'modernSplit': False}))
+            self.assertEqual(read(root), value)
+
+
+if __name__ == '__main__':
+    unittest.main()
