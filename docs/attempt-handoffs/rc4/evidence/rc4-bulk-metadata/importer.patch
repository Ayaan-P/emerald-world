+    def compile_projection(self, rows):
+        keys=NUMERIC+['genderRatio','friendship','growthRate','bodyColor','itemCommon','itemRare','frontPicSize','backPicSize']
+        members=keys+['types[0]','types[1]','eggGroups[0]','eggGroups[1]','abilities[0]','abilities[1]','abilities[2]']
+        source=self.base+'\n#include "pokemon.h"\n#include "data.h"\n#include <stdio.h>\n'
+        source+='static const struct SpeciesInfo bulk[] = {\n'
+        for name, f in rows.items():
+            entries=[]
+            for k in keys+['types','eggGroups','abilities']:
+                if k not in f: continue
+                val=f[k]
+                if k in ('types','eggGroups'):
+                    val='{'+val[val.index('(')+1:-1]+'}'
+                entries.append('.'+k+' = '+val)
+            source+='{'+', '.join(entries)+'},\n'
+        source+='};\nint main(void){\n'
+        fmt=','.join(['%lld']*len(members))+'\\n'
+        source+='for(unsigned i=0;i<sizeof(bulk)/sizeof(bulk[0]);++i) printf("'+fmt+'", '+','.join('(long long)bulk[i].'+k for k in members)+');\nreturn 0;}\n'
+        (self.artifacts/'compiled_metadata.c').write_text(source)
+        exe=self.artifacts/'compiled_metadata'
+        p=subprocess.run(['gcc','-std=gnu99','-Werror','-iquote',str(DONOR/'include'),str(self.artifacts/'compiled_metadata.c'),'-o',str(exe)],text=True,capture_output=True)
