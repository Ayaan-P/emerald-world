+            if len(lines)<4 or lines[:2]!=['JASC-PAL','0100'] or not lines[2].isdigit(): raise ValueError('invalid JASC palette '+str(path))
+            color_count=int(lines[2])
+            if not 1<=color_count<=16 or len(lines)!=color_count+3: raise ValueError('invalid palette color count '+str(path))
+            colors=[list(map(int,line.split())) for line in lines[3:]]
+            if any(len(c)!=3 or any(v<0 or v>255 for v in c) for c in colors): raise ValueError('invalid palette RGB')
+            result['colors']=colors
