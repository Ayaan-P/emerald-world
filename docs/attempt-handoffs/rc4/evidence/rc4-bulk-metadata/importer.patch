+        compiled={name:dict(zip(members,map(int,line.split(',')))) for name,line in zip(rows,lines)}
+        self.scalar_conversions=[]
+        for name,f in rows.items():
+            for k in NUMERIC+['genderRatio','friendship']:
+                if k in f and int(f[k])!=compiled[name][k]:
+                    self.scalar_conversions.append({'name':name,'field':k,'expression_value':int(f[k]),'actual_struct_value':compiled[name][k]})
+                    f[k]=str(compiled[name][k])
+        (self.artifacts/'compiled_metadata.json').write_text(json.dumps(compiled,indent=2,sort_keys=True)+'\n')
+        return compiled
+    def assets(self,f):
+        result={}
+        for key,filename in [('frontPic','front.png'),('backPic','back.png'),('palette','normal.pal'),('shinyPalette','shiny.pal'),('iconSprite','icon.png'),('footprint','footprint.png')]:
+            symbol=self.choose(f.get(key,''))
+            rel=self.graphics.get(symbol)
+            if not rel: raise ValueError('unresolved graphics symbol '+key+':'+symbol)
+            p=(DONOR/rel).resolve()
+            if not p.is_relative_to(DONOR.resolve()) or not p.is_file(): raise ValueError('missing pinned asset '+str(p))
+            result[filename]=p
+        return result
+    def inspect_asset(self,path,kind):
+        from PIL import Image
+        if not hasattr(self,'asset_cache'): self.asset_cache={}
+        key=(path,kind)
+        if key in self.asset_cache: return self.asset_cache[key]
+        data=path.read_bytes()
+        result={'donor_path':str(path.relative_to(DONOR)) if path.is_relative_to(DONOR) else str(path), 'source_sha256':hashlib.sha256(data).hexdigest()}
+        if kind.endswith('.png'):
+            if data[:8]!=b'\x89PNG\r\n\x1a\n': raise ValueError('not PNG '+str(path))
+            try:
+                with Image.open(path) as im:
+                    im.load()
+                    if im.mode!='P': raise ValueError('indexed PNG required '+str(path))
+                    dimensions={'front.png':(64,(64,128)),'back.png':(64,(64,)),'icon.png':(32,(64,)),'footprint.png':(16,(16,))}
+                    width,heights=dimensions[kind]
+                    if im.width!=width or im.height not in heights: raise ValueError('asset dimensions '+str(path))
+                    maximum=max(im.tobytes())
+                    if maximum>(1 if kind=='footprint.png' else 15): raise ValueError('asset index overflow '+str(path))
+                    result.update(width=im.width,height=im.height,mode=im.mode,bit_depth=data[24],color_type=data[25],pixel_sha256=hashlib.sha256(im.tobytes()).hexdigest(),maximum_index=maximum,
+                                  first_frame_pixel_sha256=hashlib.sha256(im.crop((0,0,64,64)).tobytes()).hexdigest() if kind in ('front.png','back.png') else None,
