+            return [root/p for p in re.findall(r'INCGFX_U16\("([^"]+)"',text)]
+        donor_paths=paths(DONOR);native_paths=paths(ROOT)
+        if not 0<=index<len(donor_paths): raise ValueError('donor icon palette index')
+        record={'donor':self.inspect_asset(donor_paths[index],'normal.pal'),'index':index,'compatible':False}
