+"""Read-only pinned Gen9 preprocessing. No fabricated externs or fallback data."""
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+HERE=Path(__file__).resolve().parent
+ROOT=HERE.parents[1]
+DONOR=ROOT.parent/'expansion-foundation/engines/expansion-native'
+PIN='bb3fd057061cdd7e6a9e79b76abb41924ee44ecc'
+NUMERIC=('baseHP baseAttack baseDefense baseSpeed baseSpAttack baseSpDefense catchRate expYield eggCycles evYield_HP evYield_Attack evYield_Defense evYield_Speed evYield_SpAttack evYield_SpDefense height weight pokemonScale pokemonOffset trainerScale trainerOffset frontPicYOffset backPicYOffset enemyMonElevation iconPalIndex').split()
+
+def split_top(text, separator=','):
+    result=[]; start=0; stack=[]; quote=None; escape=False
+    for i,c in enumerate(text):
+        if quote:
+            if escape: escape=False
+            elif c=='\\': escape=True
+            elif c==quote: quote=None
+        elif c in '\"\'': quote=c
+        elif c in '({[': stack.append(c)
+        elif c in ')}]':
+            if not stack or '({['[')}]'.index(c)]!=stack.pop(): raise ValueError('unbalanced initializer')
+        elif c==separator and not stack: result.append(text[start:i].strip()); start=i+1
+    if stack or quote: raise ValueError('unterminated initializer')
+    result.append(text[start:].strip())
+    return [s for s in result if s]
+
+def fields(block):
+    if not block.startswith('{') or not block.endswith('}'): raise ValueError('initializer expected')
+    result={}
+    for entry in split_top(block[1:-1]):
+        m=re.fullmatch(r'\.(\w+)\s*=\s*(.*)',entry,re.S)
+        if not m: raise ValueError('unresolved initializer: '+entry[:150])
+        if m[1] in result: raise ValueError('duplicate field '+m[1])
+        result[m[1]]=m[2].strip()
+    return result
+
+def extract_blocks(text):
+    result={}
+    for m in re.finditer(r'\[(SPECIES_\w+)\]\s*=\s*\{',text):
+        start=m.end()-1; depth=0; quote=None; escape=False
+        for i in range(start,len(text)):
+            c=text[i]
+            if quote:
+                if escape: escape=False
+                elif c=='\\': escape=True
+                elif c==quote: quote=None
+            elif c in '\"\'': quote=c
+            elif c=='{': depth+=1
+            elif c=='}':
+                depth-=1
+                if depth==0:
+                    if m[1] in result: raise ValueError('duplicate species '+m[1])
+                    result[m[1]]=text[start:i+1]; break
+        else: raise ValueError('unterminated species')
+    return result
+
+def syntax_positions(text):
+    quote=None; escape=False
+    for i,c in enumerate(text):
+        if quote:
+            if escape: escape=False
+            elif c=='\\': escape=True
+            elif c==quote: quote=None
+        elif c in '\"\'': quote=c
+        else: yield i,c
+    if quote: raise ValueError('unterminated C string')
+
+class Domain:
+    def __init__(self, artifacts=None):
+        self.artifacts=Path(artifacts) if artifacts is not None else HERE
+        self.artifacts.mkdir(parents=True,exist_ok=True)
+        if subprocess.check_output(['git','rev-parse','HEAD'],cwd=DONOR,text=True).strip()!=PIN: raise ValueError('pin mismatch')
+        self.base='#include "global.h"\n#include "config/pokemon.h"\n#include "config/species_enabled.h"\n#include "constants/abilities.h"\n'
+        # Real pinned config first, one explicit generation profile everywhere.
+        macros=self.cpp(self.base,['-dM'])
+        configs=re.findall(r'^#define ((?:P_UPDATED_\w+|P_LVL_UP_LEARNSETS))\b',macros,re.M)
+        self.profile={k:9 for k in configs}
+        self.base+=''.join('#undef '+k+'\n#define '+k+' 9\n' for k in configs)
+        self.cache={}
+    def cpp(self,text,extra=()):
+        p=subprocess.run(['gcc','-E','-P','-iquote',str(DONOR/'include'),'-iquote',str(DONOR/'src'),'-iquote',str(DONOR/'src/data/pokemon'),*extra,'-x','c','-'],input=text,text=True,capture_output=True)
+        if p.returncode: raise ValueError(p.stderr[:5000])
+        return p.stdout
+    def preprocess(self,text):
+        macros = self.cpp(self.base, ['-dM'])
+        return self.cpp(macros+'\nBULK_DOMAIN_START\n'+text, ['-Werror=undef']).split('BULK_DOMAIN_START',1)[1]
+    def scalar(self,expr):
+        if expr not in self.cache:
+            self.evaluate([expr])
+        return self.cache[expr]
+    def evaluate(self,expressions):
+        expressions=list(dict.fromkeys(e for e in expressions if e not in self.cache))
+        if not expressions: return
+        # Restrict input to side-effect-free C integer expressions. Unknown symbols
+        # fail at compile time; no Python eval, guessed enum IDs or zero defaults.
+        for e in expressions:
+            if not re.fullmatch(r'[\w\s()+*/%?:<>=!&|~^.,-]+',e): raise ValueError('unsafe C expression '+e)
+        source=self.base+'\n#include <stdio.h>\nint main(void){\n'+''.join('printf("%lld\\n", (long long)('+e+'));\n' for e in expressions)+'return 0;}\n'
+        with tempfile.TemporaryDirectory(dir=self.artifacts) as tmp:
+            exe=Path(tmp)/'values'
+            p=subprocess.run(['gcc','-Werror','-Wno-error=overflow','-iquote',str(DONOR/'include'),'-x','c','-','-o',str(exe)],input=source,text=True,capture_output=True)
+            if p.returncode: raise ValueError(p.stderr[:5000])
+            p=subprocess.run([str(exe)],capture_output=True,text=True)
+            if p.returncode: raise ValueError('scalar execution failed')
+            values=[int(v) for v in p.stdout.splitlines()]
+            if len(values)!=len(expressions): raise ValueError('scalar result count')
+            self.cache.update(zip(expressions,values))
+    def choose(self,expr):
+        """Select C conditional arms using compiled actual configuration/enums."""
+        expr=expr.strip()
+        while expr.startswith('('):
+            depth=0; end=None
+            for i,c in syntax_positions(expr):
+                depth+=(c=='(')-(c==')')
+                if depth==0: end=i; break
+            if end!=len(expr)-1: break
+            expr=expr[1:-1].strip()
+        depth=0; question=None; nested=0
+        for i,c in syntax_positions(expr):
+            if c in '({[': depth+=1
+            elif c in ')}]': depth-=1
+            elif depth==0 and c=='?':
+                if question is None: question=i
+                else: nested+=1
+            elif depth==0 and c==':' and question is not None:
+                if nested: nested-=1
+                else:
+                    arm=expr[question+1:i] if self.scalar(expr[:question]) else expr[i+1:]
+                    return self.choose(arm)
+        if question is not None: raise ValueError('malformed conditional '+expr)
+        return expr
+    def catalog(self):
+        # Keep evolution descriptors textual for the existing strict serializer.
+        # All other donor templates/macros are expanded by GCC without stubs.
+        header=(DONOR/'src/data/pokemon/species_info.h').read_text()
+        marker='const struct SpeciesInfo gSpeciesInfo[]'
+        header=header.replace(marker,'#undef EVOLUTION\n#undef CONDITIONS\n'+marker)
+        text=self.preprocess(header)
+        (self.artifacts/'preprocessed-species.c').write_text(text)
+        raw=extract_blocks(text)
+        parsed={n:fields(b) for n,b in raw.items()}
+        descriptions=dict(re.findall(r'const u8 (g\w+)\[\]\s*=\s*_\((.*?)\);',text,re.S))
+        for f in parsed.values():
