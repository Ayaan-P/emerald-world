+"""Generic append-only ordinary encounter bindings. No runtime RNG or level policy."""
+import copy
+
+import json
+import re
+
+
+FIELDS = {'land_mons': 12, 'water_mons': 5}
+TRANSIENT = re.compile(r'_(?:MEGA(?:_[XY])?|PRIMAL|GMAX|ETERNAMAX|ASH|BATTLE_BOND|HERO|HERO_OF_MANY_BATTLES_UNUSED)$')
+
+
+def eligible(coverage):
+    rows = {r['name']: r for r in coverage['species']}
+    selected = set(coverage['playable_selection'])
+    excluded = {}
+    for name in sorted(selected):
+        r = rows[name]
+        source = r.get('resolved_species_source', '')
+        if (TRANSIENT.search(name) or re.search(r'\.(?:isMegaEvolution|isPrimalReversion|isGigantamax|isBattleOnly)\s*=\s*TRUE', source)):
+            excluded[name] = 'transient battle-only form is not an ordinary acquisition root'
+            continue
+        if (not r.get('battle_supported') or r.get('import_blockers')
+                or r.get('alias_of') or len(r.get('normal_abilities', [])) != 2
+                or r['normal_abilities'][0] == 'ABILITY_NONE'
+                or r.get('missing_normal_abilities') or r.get('missing_level_up_moves')
+                or not source or not r.get('level_up_moves')
+                or TRANSIENT.search(name)
+                or re.search(r'\.(?:isMegaEvolution|isPrimalReversion|isGigantamax|isBattleOnly)\s*=\s*TRUE', source)):
+            raise ValueError('selected species not static dependency-closed playable: ' + name)
+    return rows, selected - excluded.keys(), excluded
+
+
+def closure(rows, selected, bindings):
+    paths = {b['species']: {'root': dict(b), 'evolutions': []} for b in bindings if b['species'] in selected}
+    pending = list(paths)
+    for name in pending:
+        for edge in rows[name].get('supported_evolutions', []):
+            if edge['method'] != 'EVO_LEVEL' or not 1 <= edge['param'] <= 100:
+                raise ValueError('unsupported edge advertised as supported: ' + name)
+            target = edge['target']
+            if target in selected and target not in paths:
+                paths[target] = {'root': paths[name]['root'], 'evolutions': paths[name]['evolutions'] + [dict(source=name, **edge)]}
+                pending.append(target)
+    return paths
+
+
+def geometry(root):
+    data = json.loads((root/'src/data/wild_encounters.json').read_text())
+    encounters = next(g['encounters'] for g in data['wild_encounter_groups'] if g['label'] == 'gWildMonHeaders' and g['for_maps'])
+    catalog = {r['id']: r for p in (root/'data/maps').glob('*/map.json') for r in [json.loads(p.read_text())]}
+    # A map file and encounter header alone do not establish a player route.
+    # Conservatively require directed real connection/warp reachability from
+    # the established campaign root. Script-only transport is not invented.
+    reachable = {'MAP_ROUTE101'}
+    pending = ['MAP_ROUTE101']
+    for map_ in pending:
+        row = catalog[map_]
+        neighbors = [c['map'] for c in (row.get('connections') or [])]
+        neighbors += [w['dest_map'] for w in row.get('warp_events', [])]
+        for neighbor in neighbors:
+            if neighbor in catalog and neighbor not in reachable:
+                reachable.add(neighbor); pending.append(neighbor)
+    headers = []
+    keys = set()
+    seen_maps = set()
+    for i, row in enumerate(encounters):
+        if row['map'] not in catalog:
+            raise ValueError('wild map absent from real map catalog: ' + row['map'])
+        for field in ('land_mons', 'water_mons', 'fishing_mons', 'rock_smash_mons'):
+            info = row.get(field)
+            if not info or not info['encounter_rate']:
+                continue
+            originals = list(dict.fromkeys(m['species'] for m in info['mons']))
+            # GetCurrentMapWildMonHeaderId selects the first matching header by
+            # default. Altering Cave's event variants are capacity-checked but
+            # cannot establish an ordinary acquisition claim by themselves.
+            if row['map'] not in seen_maps and row['map'] in reachable:
+                keys.update((row['map'], s) for s in originals)
+            headers.append(dict(header=i, label=row['base_label'], map=row['map'], field=field,
+                                originals=originals, capacity=FIELDS.get(field),
+                                native_count=len(originals), campaign_connected=row['map'] in reachable))
+        seen_maps.add(row['map'])
+    return headers, sorted(keys)
+
+
+def annotate(headers, bindings, dex=None):
+    dex = dex or {}
+    table = {(b['map'], b['original_species']): b['species'] for b in bindings}
+    result = []
+    for h in headers:
+        extras = list(dict.fromkeys(table[(h['map'], s)] for s in h['originals'] if (h['map'], s) in table))
+        extras = [s for s in extras if s not in h['originals']]
+        native_dex = list(dict.fromkeys(dex.get(s, 'NATIONAL_DEX_' + s[8:]) for s in h['originals']))
+        extra_dex = [dex.get(s, s) for s in extras]
+        if h['capacity'] is not None and (len(set(extra_dex)) != len(extra_dex) or set(native_dex) & set(extra_dex)):
+            raise ValueError('DexNav national-number dedup would hide target on ' + h['map'] + ':' + h['field'])
+        row = dict(h, extras=extras, native_dex=native_dex, extra_dex=extra_dex,
+                   total=len(native_dex) + len(extras),
+                   dexnav_supported=h['field'] in FIELDS)
+        if row['capacity'] is not None and row['total'] > row['capacity']:
+            raise ValueError('DexNav capacity overflow: ' + json.dumps(row, sort_keys=True))
+        result.append(row)
+    return result
+
+
+def generate(coverage, root, previous=None):
+    rows, selected, excluded = eligible(coverage)
+    dex = {}
+    for n, row in rows.items():
+        match = re.search(r'\.natDexNum\s*=\s*(NATIONAL_DEX_\w+)', row.get('resolved_species_source', ''))
+        if match:
+            dex[n] = match[1]
+    headers, keys = geometry(root)
+    seed = copy.deepcopy(coverage['implemented_acquisition_roots'][:7])
+    if len(seed) != 7:
+        raise ValueError('expected seven established bindings')
+    bindings = copy.deepcopy(previous['bindings'] if previous else seed)
+    if bindings[:7] != seed:
+        raise ValueError('established binding changed')
+    used = set()
+    targets = set()
+    for b in bindings:
+        key = b['map'], b['original_species']
+        if key not in keys or key in used or b['species'] not in selected or b['species'] in targets:
+            raise ValueError('invalid persisted binding, never silently reassign: ' + str(b))
+        used.add(key); targets.add(b['species'])
+    annotate(headers, bindings, dex)
+    paths = closure(rows, selected, bindings)
+    # A selected child emitted via EVO_LEVEL needs no duplicate wild root.
+    # Prefer sources before their descendants; a strongly connected component
+    # without a predecessor gets exactly one deterministic root.
+    while selected - paths.keys():
+        missing = selected - paths.keys()
+        incoming = {e['target'] for n in missing for e in rows[n].get('supported_evolutions', []) if e['target'] in missing}
+        name = min(missing - incoming or missing, key=lambda n: (rows[n]['engine_id'], n))
+        candidates = []
+        for key in keys:
+            if key in used:
+                continue
+            matching = [h for h in headers if h['map'] == key[0] and key[1] in h['originals']]
+            # Prefer existing searchable land, then surf, then ordinary-only
+            # fishing/rock keys. No synthetic Surf/DexNav pool is constructed.
+            rank = min((0 if h['field'] == 'land_mons' else 1 if h['field'] == 'water_mons' else 2) for h in matching)
+            candidates.append((rank, key))
+        found = None
+        for _, (map_, original) in sorted(candidates):
+            b = dict(map=map_, original_species=original, species=name,
+                     rule='WORLD_RULE_EXPANDED_ROSTER',
+                     resolver='src/platform/expanded_species.c:ExpandedSpecies_ResolveEncounter')
+            try:
+                annotate(headers, bindings + [b], dex)
+            except ValueError:
+                continue
+            found = b
+            break
+        if found is None:
+            raise ValueError('existing-key/DexNav geometry exhausted: ' + json.dumps(dict(
+                selected=len(selected), remaining=len(missing), roots_bound=len(bindings),
+                native_keys=len(keys), headers=len(headers), used_keys=len(used),
+                coverage=annotate(headers, bindings, dex)), sort_keys=True))
+        bindings.append(found); used.add((found['map'], found['original_species']))
+        paths = closure(rows, selected, bindings)
+    header_coverage = annotate(headers, bindings, dex)
+    return dict(schema_version=1, bindings=bindings,
+                playable_selection=coverage['playable_selection'], excluded_selection=excluded,
+                obtainable_selection=[n for n in coverage['playable_selection'] if n in paths],
+                acquisition_paths=paths, header_coverage=header_coverage,
+                geometry=dict(native_keys=len(keys), native_headers=len({h['header'] for h in headers}),
+                              field_headers=len(headers), bound_keys=len(bindings),
+                              searchable_field_headers=sum(h['capacity'] is not None for h in headers)),
+                support_limits={'proof':'Generated bindings and compiled seams, not actual gameplay proof.',
+                    'levels':'Existing source-slot natural rolls, unchanged.',
+                    'fishing_rock':'Ordinary acquisition only unless the same key really occurs in land/water. No synthetic DexNav environments.',
+                    'capacity':'All real alternate headers checked, land 12 and water 5. No truncation, base entries preserved.',
+                    'assignment':'Append-only persisted bindings; removed/invalid old entries fail closed instead of reshuffling.',
+                    'map_reachability':'Conservative directed real warp/connection closure from Route101; unused and script-only destinations are not allocated. All alternate headers are still capacity-checked.',
+                    'evolution':'Only selected targets via emitted EVO_LEVEL edges. Other selected forms may be ordinary roots.'})
+
+
+def resolver(bindings):
+    lines = ['u16 ExpandedSpecies_ResolveEncounter(u16 species, u8 mapGroup, u8 mapNum)', '{',
+             '    /* Pure generated lookup. Natural levels and MORE RNG remain in the caller. */',
+             '    if (!WorldRules_Enabled(WORLD_RULE_EXPANDED_ROSTER))', '        return species;']
+    for b in bindings:
+        lines += ['#ifdef ' + b['species'],
+                  '    if (mapGroup == MAP_GROUP(' + b['map'] + ') && mapNum == MAP_NUM(' + b['map'] + ')',
+                  '        && species == ' + b['original_species'] + ' && ExpandedSpecies_IsPlayable(' + b['species'] + '))',
+                  '        return ' + b['species'] + ';', '#endif']
+    return '\n'.join(lines + ['    return species;', '}']) + '\n'
+
+
+def emit_acquisition(coverage, root, out):
+    """Importer hook: advertise acquisition only after emitting actual policy."""
+    relative = 'tools/expanded/acquisition_manifest.json'
+    prior = next((p for p in (out/relative, root/relative) if p.is_file()), None)
+    result = generate(coverage, root, json.loads(prior.read_text()) if prior else None)
+    runtime = (root/'src/platform/expanded_species.c').read_text()
+    start = runtime.index('u16 ExpandedSpecies_ResolveEncounter(')
+    brace = runtime.index('{', start)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (runtime[end] == '{') - (runtime[end] == '}')
+        end += 1
+    generated_runtime = runtime[:start] + resolver(result['bindings']).rstrip() + runtime[end:]
+    files = {relative: json.dumps(result, indent=2) + '\n',
+             'src/platform/expanded_species.c': generated_runtime}
+    for relative, text in files.items():
+        path = out/relative
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text)
+    coverage['obtainable_selection'] = result['obtainable_selection']
+    coverage['implemented_acquisition_roots'] = result['bindings']
+    coverage['acquisition_excluded_selection'] = result['excluded_selection']
+    coverage['support_limits']['acquisition'] = 'Generated append-only native map/original-species bindings plus emitted EVO_LEVEL closure. Ordinary MORE retains native species. Fishing/rock-only keys are not Surf DexNav pools. Compiled seams are not native gameplay proof.'
+    for row in coverage['species']:
+        row['obtainable'] = row['name'] in result['acquisition_paths']
+        row['acquisition_path'] = result['acquisition_paths'].get(row['name'])
+    return result
