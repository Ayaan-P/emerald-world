--- /dev/null
+++ b/src/platform/normal_abilities.c
@@ -0,0 +1,52 @@
+#ifdef PORTABLE
+#include "global.h"
+#include "battle.h"
+#include "battle_main.h"
+#include "battle_anim.h"
+#include "item.h"
+#include "constants/abilities.h"
+#include "constants/item.h"
+#include "platform/normal_abilities.h"
+
+/* Frisk's switch-in callback runs to completion before another ability starts.
+ * Keep the iteration in transient script state, never in save/party structs. */
+static u8 sFriskNext;
+
+bool8 NormalAbilities_NextFrisk(void)
+{
+    u8 owner = gBattleScripting.battler;
+    while (sFriskNext < gBattlersCount)
+    {
+        u8 target = sFriskNext++;
+        if (GetBattlerSide(target) == GetBattlerSide(owner)
+         || (gAbsentBattlerFlags & (1 << target)) || !gBattleMons[target].hp
+         || !gBattleMons[target].item)
+            continue;
+        gEffectBattler = target;
+        gPotentialItemEffectBattler = target;
+        gLastUsedItem = gBattleMons[target].item;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+bool8 NormalAbilities_BeginFrisk(u8 battler)
+{
+    if (gBattleMons[battler].ability != ABILITY_FRISK || !gBattleMons[battler].hp
+     || (gAbsentBattlerFlags & (1 << battler)))
+        return FALSE;
+    sFriskNext = 0;
+    gBattleScripting.battler = battler;
+    return NormalAbilities_NextFrisk();
+}
+
+u16 NormalAbilities_BerryThreshold(u8 battler, u16 item, u8 divisor)
+{
+    /* Donor bb3fd057 ShouldApplyPinchBerry: only pinch berries, not healing
+     * amounts, PP, or non-berry held effects. Preserve all stock divisors. */
+    if (divisor > 2 && divisor <= 4 && GetItemPocket(item) == POCKET_BERRIES
+     && gBattleMons[battler].ability == ABILITY_GLUTTONY)
+        divisor = 2;
+    return gBattleMons[battler].maxHP / divisor;
+}
+#endif
