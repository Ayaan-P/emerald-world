+#ifdef PORTABLE
+/* Resolve queued forms before ordering moves. Ability scripts use the normal
+ * callback stack and return here, rather than skipping their battle effects. */
+static bool8 TryMegaEvolutionBeforeTurn(void)
+{
+    if (!MEGA_FEATURE_READY) return FALSE;
+    if (gBattleControllerExecFlags) return TRUE;
+    if (gBattleOutcome) return FALSE;
+    while (sMegaTurnBattler < gBattlersCount && sMegaTurnBattler < MAX_BATTLERS_COUNT)
+    {
+        u8 battler = sMegaTurnBattler;
+        gActiveBattler = battler;
+        switch (sMegaTurnPhase)
+        {
+        case 0:
+        {
+            u8 oldAbility = gBattleMons[battler].ability;
+            if (gChosenActionByBattler[battler] != B_ACTION_USE_MOVE || gProtectStructs[battler].noValidMoves)
+            {
+                MegaGame_CancelQueue(battler);
+                sMegaTurnBattler++;
+                break;
+            }
+            if (!MegaGame_Apply(battler))
+            {
+                sMegaTurnBattler++;
+                break;
+            }
+            MegaGame_RefreshSprite(battler);
+            sMegaTurnAbilityChanged = oldAbility != gBattleMons[battler].ability;
+            sMegaTurnPhase = 1;
+            MegaGame_PublishForm(battler, MEGA_WIRE_ACTIVATE);
+            return TRUE;
+        }
+        case 1:
+            /* The normal callback stack resumes only after print/wait/end3.
+             * Link form ACKs drain at the entry guard before this script. */
+            sMegaTurnPhase = 4;
+            gBattleScripting.battler = battler;
+            BattleScriptPushCursorAndCallback(BattleScript_MegaEvolved);
+            return TRUE;
+        case 4:
+            if (!sMegaTurnAbilityChanged)
+            {
+                sMegaTurnPhase = 0;
+                sMegaTurnBattler++;
+                break;
+            }
+            gSpecialStatuses[battler].intimidatedMon = FALSE;
+            gSpecialStatuses[battler].traced = FALSE;
+            gStatuses3[battler] &= ~(STATUS3_INTIMIDATE_POKES | STATUS3_TRACE);
+            sMegaTurnPhase = 2;
+            if (AbilityBattleEffects(ABILITYEFFECT_ON_SWITCHIN, battler, 0, 0, 0)) return TRUE;
+            break;
+        case 2:
+            if (AbilityBattleEffects(ABILITYEFFECT_INTIMIDATE1, 0, 0, 0, 0)) return TRUE;
+            sMegaTurnPhase = 3;
+            break;
+        case 3:
+            if (AbilityBattleEffects(ABILITYEFFECT_TRACE, 0, 0, 0, 0)) return TRUE;
+            sMegaTurnPhase = 0;
+            sMegaTurnBattler++;
+            break;
+        }
+    }
+    return FALSE;
+}
+#endif
