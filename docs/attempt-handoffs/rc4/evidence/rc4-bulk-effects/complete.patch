--- a/data/battle_scripts_1.s
+++ b/data/battle_scripts_1.s
@@ -235,6 +235,8 @@ gBattleScriptsForMoveEffects::
 .ifdef PORTABLE
 	ptrvalue BattleScript_EffectDefSpDefDownHit         /* EFFECT_DEF_SPDEF_DOWN_HIT */
 	ptrvalue BattleScript_EffectSelfSpeedDownHit        /* EFFECT_SELF_SPEED_DOWN_HIT */
+	ptrvalue BattleScript_EffectAttackAccuracyUp        /* EFFECT_ATTACK_ACCURACY_UP */
+	ptrvalue BattleScript_EffectAttackSpAtkUp           /* EFFECT_ATTACK_SPATK_UP */
 .endif
 
 BattleScript_EffectHit::
@@ -2698,6 +2700,45 @@ BattleScript_CantLowerMultipleStats::
 	waitmessage B_WAIT_TIME_LONG
 	goto BattleScript_MoveEnd
 
+
+.ifdef PORTABLE
+// RC4 private paired boosts begin
+// Native paired +1 user boosts. Reuse ChangeStatBuffs through statbuffchange,
+// including independent caps, Snatch redirection and normal move-end ownership.
+.macro rc4_pair_up first, second, mask
+	attackcanceler
+	attackstring
+	ppreduce
+	jumpifstat BS_ATTACKER, CMP_LESS_THAN, \first, MAX_STAT_STAGE, .Lpair_anim\@
+	jumpifstat BS_ATTACKER, CMP_EQUAL, \second, MAX_STAT_STAGE, BattleScript_CantRaiseMultipleStats
+.Lpair_anim\@:
+	attackanimation
+	waitanimation
+	setbyte sSTAT_ANIM_PLAYED, FALSE
+	playstatchangeanimation BS_ATTACKER, \mask, 0
+	setstatchanger \first, 1, FALSE
+	statbuffchange MOVE_EFFECT_AFFECTS_USER | STAT_CHANGE_ALLOW_PTR, .Lpair_second\@
+	jumpifbyte CMP_EQUAL, cMULTISTRING_CHOOSER, B_MSG_STAT_WONT_INCREASE, .Lpair_second\@
+	printfromtable gStatUpStringIds
+	waitmessage B_WAIT_TIME_LONG
+.Lpair_second\@:
+	setstatchanger \second, 1, FALSE
+	statbuffchange MOVE_EFFECT_AFFECTS_USER | STAT_CHANGE_ALLOW_PTR, .Lpair_end\@
+	jumpifbyte CMP_EQUAL, cMULTISTRING_CHOOSER, B_MSG_STAT_WONT_INCREASE, .Lpair_end\@
+	printfromtable gStatUpStringIds
+	waitmessage B_WAIT_TIME_LONG
+.Lpair_end\@:
+	goto BattleScript_MoveEnd
+.endm
+
+BattleScript_EffectAttackAccuracyUp::
+	rc4_pair_up STAT_ATK, STAT_ACC, BIT_ATK | BIT_ACC
+
+BattleScript_EffectAttackSpAtkUp::
+	rc4_pair_up STAT_ATK, STAT_SPATK, BIT_ATK | BIT_SPATK
+// RC4 private paired boosts end
+.endif
+
 BattleScript_EffectCosmicPower::
 	attackcanceler
 	attackstring
