+                with self.assertRaisesRegex(ValueError, 'RULES'):
+                    WorldClient(server.socket_path, 'alice', a['token'])
+                from world.rules import make
+                wrong = make(rules['world_id'], rules['version'] + 1, rules['rules'])
+                with self.assertRaisesRegex(ValueError, 'RULES'):
