diff --git a/asm/macros/event.inc b/asm/macros/event.inc
index e88ceb723..6cfa33ea7 100644
--- a/asm/macros/event.inc
+++ b/asm/macros/event.inc
@@ -153,7 +153,11 @@

 	@ Changes the value of destination to value.
 	.macro setvar destination:req, value:req, warn=TRUE
+#if defined(PORTABLE) && EW_REGION_STATE
+	.if \warn && ((\value >= VARS_START && \value <= VARS_END) || (\value >= SPECIAL_VARS_START && \value <= SPECIAL_VARS_END) || (EW_REGION_STATE && \value >= KANTO_VARS_START && \value < KANTO_VARS_START + KANTO_VARS_COUNT))
+#else
 	.if \warn && ((\value >= VARS_START && \value <= VARS_END) || (\value >= SPECIAL_VARS_START && \value <= SPECIAL_VARS_END))
+#endif
 	.warning "setvar with a value that might be a VAR_ constant; did you mean copyvar instead?"
 	.endif
 	.byte SCR_OP_SETVAR
@@ -177,7 +181,11 @@

 	@ Copies the value of source into destination.
 	.macro copyvar destination:req, source:req, warn=TRUE
+#if defined(PORTABLE) && EW_REGION_STATE
+	.if \warn && !((\source >= VARS_START && \source <= VARS_END) || (\source >= SPECIAL_VARS_START && \source <= SPECIAL_VARS_END) || (EW_REGION_STATE && \source >= KANTO_VARS_START && \source < KANTO_VARS_START + KANTO_VARS_COUNT))
+#else
 	.if \warn && !((\source >= VARS_START && \source <= VARS_END) || (\source >= SPECIAL_VARS_START && \source <= SPECIAL_VARS_END))
+#endif
 	.warning "copyvar with a value that is not a VAR_ constant; did you mean setvar instead?"
 	.endif
 	.byte SCR_OP_COPYVAR
@@ -259,7 +267,11 @@
 	@ Generic compare macro which attempts to deduce argument types based on their values
 	@ Any values between VARS_START to VARS_END and SPECIAL_VARS_START to SPECIAL_VARS_END are considered event variable identifiers
 	.macro compare var:req, arg:req
+#if defined(PORTABLE) && EW_REGION_STATE
+		.if ((\arg >= VARS_START && \arg <= VARS_END) || (\arg >= SPECIAL_VARS_START && \arg <= SPECIAL_VARS_END) || (EW_REGION_STATE && \arg >= KANTO_VARS_START && \arg < KANTO_VARS_START + KANTO_VARS_COUNT))
+#else
 		.if ((\arg >= VARS_START && \arg <= VARS_END) || (\arg >= SPECIAL_VARS_START && \arg <= SPECIAL_VARS_END))
+#endif
 			compare_var_to_var \var, \arg
 		.else
 			compare_var_to_value \var, \arg
