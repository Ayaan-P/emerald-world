diff --git a/tests/rc8/region_content.c b/tests/rc8/region_content.c
new file mode 100644
index 000000000..a9ff4c9e1
--- /dev/null
+++ b/tests/rc8/region_content.c
@@ -0,0 +1,163 @@
+/* Real script interpreter, command handlers, event bank and game save hooks.
+ * Bytecode comes from the upstream scripts. Only map preview/object display
+ * adapters are replaced; no renderer, overworld walking or sockets run. */
+#define main OriginalSaveTests
+#include "region_state_save.c"
+#undef main
+#include "src/script.c"
+#include "src/scrcmd.c"
+#include "constants/script_commands.h"
+
+struct MapHeader gMapHeader;
+static const struct MapLayout kanto = {.isFrlg = TRUE};
+static const struct MapLayout hoenn = {.isFrlg = FALSE};
+extern const u8 TestMapScripts[], TestCompareRegional[];
+static unsigned positionCalls, movementCalls;
+static s16 objectX, objectY;
+
+void AssertfCrashScreen(const void *return0, const char *format, ...)
+{ (void)return0; (void)format; assert(0); }
+
+void MapPreview_SetFlag(u16 flag) { FlagSet(flag); }
+void SetObjEventTemplateCoords(u8 localId, s16 x, s16 y)
+{
+    assert(localId == 1);
+    objectX = x; objectY = y; positionCalls++;
+}
+void SetObjEventTemplateMovementType(u8 localId, u8 movement)
+{
+    assert(localId == 1);
+    (void)movement;
+    movementCalls++;
+}
+bool8 FuncIsActiveTask(TaskFunc func) { (void)func; return FALSE; }
+void Task_WarpAndLoadMap(u8 taskId) { (void)taskId; assert(0); }
+
+static bool8 InvalidCommand(struct ScriptContext *ctx)
+{
+    (void)ctx;
+    assert(!"Unexpected command in selected upstream script");
+    return TRUE;
+}
+ScrCmdFunc gScriptCmdTable[256] = {
+    [0 ... 255] = InvalidCommand,
+    [SCR_OP_END] = ScrCmd_end,
+    [SCR_OP_RETURN] = ScrCmd_return,
+    [SCR_OP_GOTO] = ScrCmd_goto,
+    [SCR_OP_CALL] = ScrCmd_call,
+    [SCR_OP_GOTO_IF] = ScrCmd_goto_if,
+    [SCR_OP_CALL_IF] = ScrCmd_call_if,
+    [SCR_OP_SETVAR] = ScrCmd_setvar,
+    [SCR_OP_SETFLAG] = ScrCmd_setflag,
+    [SCR_OP_CLEARFLAG] = ScrCmd_clearflag,
+    [SCR_OP_CHECKFLAG] = ScrCmd_checkflag,
+    [SCR_OP_COMPARE_VAR_TO_VALUE] = ScrCmd_compare_var_to_value,
+    [SCR_OP_COMPARE_VAR_TO_VAR] = ScrCmd_compare_var_to_var,
+    [SCR_OP_SETWORLDMAPFLAG] = ScrCmd_setworldmapflag,
+    [SCR_OP_SETOBJECTXYPERM] = ScrCmd_setobjectxyperm,
+    [SCR_OP_SETOBJECTMOVEMENTTYPE] = ScrCmd_setobjectmovementtype,
+};
+__asm__(".global gScriptCmdTableEnd\n.set gScriptCmdTableEnd, gScriptCmdTable + 256*8");
+
+static void Enter(bool8 isKanto)
+{
+    gMapHeader.mapLayout = isKanto ? &kanto : &hoenn;
+    gMapHeader.mapScripts = isKanto ? TestMapScripts : NULL;
+    RunOnTransitionMapScript();
+}
+
+static void LoadStory(const char *path)
+{
+    save_file_shutdown();
+    memset(&block1, 0xAA, sizeof block1);
+    flash_init();
+    assert(save_file_init(path) == SAVE_FILE_OK);
+    assert(save_file_load() == SAVE_FILE_OK);
+    UpdateSaveAddresses();
+    assert(TryLoadSaveSlot(FULL_SAVE_SLOT, gRamSaveSectorLocations) == SAVE_STATUS_OK);
+}
+
+int main(void)
+{
+    char directory[] = "/tmp/ew-kanto-story-XXXXXX";
+    assert(mkdtemp(directory));
+    char a[256], b[256];
+    snprintf(a, sizeof a, "%s/a.sav", directory);
+    snprintf(b, sizeof b, "%s/b.sav", directory);
+    ProgramFlashByte = NativeFlash.programFlashByte;
+    EraseFlashSector = NativeFlash.eraseFlashSector;
+    flash_init();
+    assert(save_file_init(a) == SAVE_FILE_OK);
+    InitEventData();
+    Save_ResetSaveCounters();
+    UpdateSaveAddresses();
+    VarSet(VAR_LITTLEROOT_TOWN_STATE, 6);
+    FlagSet(FLAG_SYS_POKEDEX_GET);
+    FlagSet(FLAG_BADGE01_GET);
+    const struct SaveBlock1 before = block1;
+    Enter(FALSE);
+    assert(!FlagGet(FLAG_KANTO_STORY_INITIALIZED));
+    assert(VarGet(VAR_MASSAGE_COOLDOWN_STEP_COUNTER) == 0);
+    Enter(TRUE);
+    assert(FlagGet(FLAG_KANTO_STORY_INITIALIZED));
+    assert(FlagGet(FLAG_HIDE_OAK_IN_PALLET_TOWN));
+    assert(FlagGet(FLAG_HIDE_BILL_HUMAN_SEA_COTTAGE));
+    assert(FlagGet(FLAG_KANTO_HIDE_DEOXYS));
+    assert(!FlagGet(FLAG_HIDE_DEOXYS));
+    assert(FlagGet(FLAG_HIDE_SAFFRON_CITY_POKECENTER_SABRINA_JOURNALS));
+    assert(FlagGet(FLAG_WORLD_MAP_PALLET_TOWN));
+    assert(VarGet(VAR_MASSAGE_COOLDOWN_STEP_COUNTER) == 500);
+    assert(positionCalls == 1 && movementCalls == 1 && objectX == 5 && objectY == 15);
+    assert(memcmp(&block1, &before, sizeof block1) == 0);
+
+    /* A real Pallet callback advances only this trainer's regional scene. */
+    FlagSet(FLAG_PALLET_LADY_NOT_BLOCKING_SIGN);
+    FlagSet(FLAG_OPENED_START_MENU);
+    FlagClear(FLAG_HIDE_OAK_IN_PALLET_TOWN);
+    VarSet(VAR_MASSAGE_COOLDOWN_STEP_COUNTER, 123);
+    Enter(TRUE);
+    assert(VarGet(VAR_MAP_SCENE_PALLET_TOWN_SIGN_LADY) == 2);
+    assert(!FlagGet(FLAG_HIDE_OAK_IN_PALLET_TOWN));
+    assert(VarGet(VAR_MASSAGE_COOLDOWN_STEP_COUNTER) == 123);
+    assert(memcmp(&block1, &before, sizeof block1) == 0);
+
+    struct ScriptContext ctx;
+    VarSet(VAR_MAP_SCENE_PALLET_TOWN_OAK, 7);
+    VarSet(VAR_MAP_SCENE_VIRIDIAN_CITY_OLD_MAN, 7);
+    InitScriptContext(&ctx, gScriptCmdTable, gScriptCmdTableEnd);
+    SetupBytecodeScript(&ctx, TestCompareRegional);
+    assert(!RunScriptCommand(&ctx) && ctx.comparisonResult == 1);
+    assert(WriteSaveSectorOrSlot(FULL_SAVE_SLOT, gRamSaveSectorLocations) == SAVE_STATUS_OK);
+    assert(save_file_store() == SAVE_FILE_OK);
+
+    LoadStory(a);
+    Enter(TRUE);
+    assert(!FlagGet(FLAG_HIDE_OAK_IN_PALLET_TOWN));
+    assert(VarGet(VAR_MAP_SCENE_PALLET_TOWN_SIGN_LADY) == 2);
+    assert(VarGet(VAR_MASSAGE_COOLDOWN_STEP_COUNTER) == 123);
+    assert(memcmp(&block1, &before, sizeof block1) == 0);
+
+    save_file_shutdown();
+    flash_init();
+    assert(save_file_init(b) == SAVE_FILE_OK);
+    InitEventData();
+    Save_ResetSaveCounters();
+    Enter(TRUE);
+    assert(FlagGet(FLAG_HIDE_OAK_IN_PALLET_TOWN));
+    assert(VarGet(VAR_MAP_SCENE_PALLET_TOWN_SIGN_LADY) == 0);
+    assert(VarGet(VAR_MASSAGE_COOLDOWN_STEP_COUNTER) == 500);
+    assert(WriteSaveSectorOrSlot(FULL_SAVE_SLOT, gRamSaveSectorLocations) == SAVE_STATUS_OK);
+    assert(save_file_store() == SAVE_FILE_OK);
+    LoadStory(a);
+    Enter(TRUE);
+    assert(!FlagGet(FLAG_HIDE_OAK_IN_PALLET_TOWN));
+    assert(VarGet(VAR_MAP_SCENE_PALLET_TOWN_SIGN_LADY) == 2);
+    LoadStory(b);
+    Enter(TRUE);
+    assert(FlagGet(FLAG_HIDE_OAK_IN_PALLET_TOWN));
+    assert(VarGet(VAR_MAP_SCENE_PALLET_TOWN_SIGN_LADY) == 0);
+    save_file_shutdown();
+    unlink(a); unlink(b); rmdir(directory);
+    puts("Upstream Kanto defaults, Pallet callbacks, comparison, persistence and trainer isolation passed");
+    return OriginalSaveTests();
+}
diff --git a/tests/rc8/region_state_save.c b/tests/rc8/region_state_save.c
new file mode 100644
index 000000000..defcfd93b
--- /dev/null
+++ b/tests/rc8/region_state_save.c
@@ -0,0 +1,160 @@
+/* Compile the actual game save/event-data translation units. The only game
+ * adapter below connects ProgramFlashSectorAndVerify to the real native flash
+ * driver and injects one failed sector. No scripts, renderer, or sockets run.
+ */
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include "src/save.c"
+#include "src/event_data.c"
+#include "platform/flash.h"
+#include "platform/save_file.h"
+#include "platform/save_extension.h"
+#include "platform/region_state.h"
+
+static struct SaveBlock1 block1;
+static struct SaveBlock2 block2;
+static struct PokemonStorage storage;
+struct SaveBlock1 *gSaveBlock1Ptr = &block1;
+struct SaveBlock2 *gSaveBlock2Ptr = &block2;
+struct PokemonStorage *gPokemonStoragePtr = &storage;
+struct SaveBlock3 gSaveblock3;
+u16 *const gSpecialVars[22] = {0};
+u16 (*ProgramFlashByte)(u16, u32, u8);
+u16 (*EraseFlashSector)(u16);
+static bool failSectorZero;
+
+u32 ProgramFlashSectorAndVerify(u16 sector, u8 *data)
+{
+    const struct SaveSector *const save = (const struct SaveSector *)data;
+    if (failSectorZero && save->id == SECTOR_ID_SAVEBLOCK2)
+        return 1;
+    return NativeFlash.programFlashSector(sector, data);
+}
+
+static void SetProgress(u16 hoenn, u16 kanto)
+{
+    assert(VarSet(VAR_LITTLEROOT_TOWN_STATE, hoenn));
+    FlagSet(FLAG_SYS_POKEDEX_GET); /* Shared system flag stays in SaveBlock1. */
+    const struct SaveBlock1 before = block1;
+    assert(VarSet(VAR_MAP_SCENE_PALLET_TOWN_OAK, kanto));
+    FlagSet(FLAG_HIDE_OAK_IN_PALLET_TOWN);
+    assert(VarSet(KANTO_VARS_START + KANTO_VARS_COUNT - 1, 0xBEEF));
+    FlagSet(KANTO_FLAGS_START + KANTO_FLAGS_COUNT - 1);
+    assert(memcmp(&before, &block1, sizeof block1) == 0);
+}
+
+static void CheckProgress(u16 hoenn, u16 kanto)
+{
+    assert(VarGet(VAR_LITTLEROOT_TOWN_STATE) == hoenn);
+    assert(VarGet(VAR_MAP_SCENE_PALLET_TOWN_OAK) == kanto);
+    assert(FlagGet(FLAG_HIDE_OAK_IN_PALLET_TOWN));
+    assert(FlagGet(FLAG_SYS_POKEDEX_GET));
+    assert(VarGet(KANTO_VARS_START + KANTO_VARS_COUNT - 1) == 0xBEEF);
+    assert(FlagGet(KANTO_FLAGS_START + KANTO_FLAGS_COUNT - 1));
+    assert(GetVarPointer(VAR_LITTLEROOT_TOWN_STATE) == &block1.vars[0x50]);
+    assert(GetVarPointer(VAR_MAP_SCENE_PALLET_TOWN_OAK) != &block1.vars[0x50]);
+    assert(GetFlagPointer(FLAG_SYS_POKEDEX_GET) == &block1.flags[FLAG_SYS_POKEDEX_GET / 8]);
+}
+
+static void ColdLoad(const char *path, u16 hoenn, u16 kanto)
+{
+    save_file_shutdown();
+    memset(&block1, 0xAA, sizeof block1);
+    memset(&block2, 0xAA, sizeof block2);
+    memset(&storage, 0xAA, sizeof storage);
+    memset(&gSaveblock3, 0xAA, sizeof gSaveblock3);
+    assert(save_file_init(path) == SAVE_FILE_OK);
+    assert(save_file_load() == SAVE_FILE_OK);
+    const u8 status = TryLoadSaveSlot(FULL_SAVE_SLOT, gRamSaveSectorLocations);
+    assert(status == SAVE_STATUS_OK || status == SAVE_STATUS_ERROR);
+    CheckProgress(hoenn, kanto);
+}
+
+int main(void)
+{
+    char directory[] = "/tmp/ew-region-hooks-XXXXXX";
+    assert(mkdtemp(directory) != NULL);
+    char a[256], b[256];
+    assert(snprintf(a, sizeof a, "%s/a.sav", directory) > 0);
+    assert(snprintf(b, sizeof b, "%s/b.sav", directory) > 0);
+    ProgramFlashByte = NativeFlash.programFlashByte;
+    EraseFlashSector = NativeFlash.eraseFlashSector;
+    flash_init();
+    assert(save_file_init(a) == SAVE_FILE_OK);
+    InitEventData();
+    assert(region_state_var(KANTO_VARS_START - 1) == NULL);
+    assert(region_state_var(KANTO_VARS_START + KANTO_VARS_COUNT) == NULL);
+    assert(region_state_flag(KANTO_FLAGS_START - 1) == NULL);
+    assert(region_state_flag(KANTO_FLAGS_START + KANTO_FLAGS_COUNT) == NULL);
+    Save_ResetSaveCounters();
+    UpdateSaveAddresses();
+    SetProgress(7, 2);
+    ClearTempFieldEventData();
+    CheckProgress(7, 2);
+    assert(WriteSaveSectorOrSlot(FULL_SAVE_SLOT, gRamSaveSectorLocations) == SAVE_STATUS_OK);
+    assert(save_file_store() == SAVE_FILE_OK);
+    SetProgress(99, 99); /* Live edits are not saved just by flushing the file. */
+    assert(save_file_store() == SAVE_FILE_OK);
+    ColdLoad(a, 7, 2);
+
+    SetProgress(8, 3);
+    assert(WriteSaveSectorOrSlot(FULL_SAVE_SLOT, gRamSaveSectorLocations) == SAVE_STATUS_OK);
+    assert(gSaveCounter == 2);
+    assert(save_file_store() == SAVE_FILE_OK);
+    /* Power loss during a same-counter link update, before its signature. */
+    SetProgress(88, 88);
+    assert(HandleReplaceSector(0, gRamSaveSectorLocations) == SAVE_STATUS_OK);
+    assert(save_file_store() == SAVE_FILE_OK);
+    ColdLoad(a, 7, 2);
+    assert(gSaveCounter == 1);
+    SetProgress(8, 3);
+    gDamagedSaveSectors = 0;
+    assert(WriteSaveSectorOrSlot(FULL_SAVE_SLOT, gRamSaveSectorLocations) == SAVE_STATUS_OK);
+    assert(save_file_store() == SAVE_FILE_OK);
+    SetProgress(9, 4);
+    failSectorZero = true;
+    assert(WriteSaveSectorOrSlot(FULL_SAVE_SLOT, gRamSaveSectorLocations) == SAVE_STATUS_ERROR);
+    failSectorZero = false;
+    assert(save_file_store() == SAVE_FILE_OK);
+    ColdLoad(a, 8, 3); /* The actual slot recovery chose counter 2. */
+    assert(gSaveCounter == 2);
+
+    /* Same-counter SAVE_LINK-style replacement and deferred signatures. */
+    SetProgress(10, 5);
+    gDamagedSaveSectors = 0;
+    for (unsigned i = 0; i <= SECTOR_ID_SAVEBLOCK1_END; i++)
+        assert(HandleReplaceSector(i, gRamSaveSectorLocations) == SAVE_STATUS_OK);
+    for (unsigned i = 0; i <= SECTOR_ID_SAVEBLOCK1_END; i++)
+        assert(WriteSectorSignatureByte_NoOffset(i, gRamSaveSectorLocations) == SAVE_STATUS_OK);
+    assert(save_file_store() == SAVE_FILE_OK);
+    ColdLoad(a, 10, 5);
+
+    /* A second trainer profile starts empty and keeps a separate archive. */
+    flash_init();
+    assert(save_file_init(b) == SAVE_FILE_OK);
+    assert(save_file_load() == SAVE_FILE_NEW);
+    InitEventData();
+    assert(VarGet(VAR_MAP_SCENE_PALLET_TOWN_OAK) == 0);
+    assert(!FlagGet(FLAG_HIDE_OAK_IN_PALLET_TOWN));
+    Save_ResetSaveCounters();
+    SetProgress(21, 22);
+    assert(WriteSaveSectorOrSlot(FULL_SAVE_SLOT, gRamSaveSectorLocations) == SAVE_STATUS_OK);
+    assert(save_file_store() == SAVE_FILE_OK);
+    ColdLoad(a, 10, 5);
+    ColdLoad(b, 21, 22);
+
+    /* An archive for the wrong counter fails closed through the real load hook. */
+    assert(region_state_capture(3));
+    assert(TryLoadSaveSlot(FULL_SAVE_SLOT, gRamSaveSectorLocations) == SAVE_STATUS_CORRUPT);
+    assert(GetVarPointer(VAR_MAP_SCENE_PALLET_TOWN_OAK) == NULL);
+    assert(!VarSet(VAR_MAP_SCENE_PALLET_TOWN_OAK, 88));
+    InitEventData();
+    assert(VarGet(VAR_MAP_SCENE_PALLET_TOWN_OAK) == 0);
+    assert(!FlagGet(FLAG_HIDE_OAK_IN_PALLET_TOWN));
+    save_file_shutdown();
+    assert(unlink(a) == 0 && unlink(b) == 0 && rmdir(directory) == 0);
+    puts("Actual save/event-data hooks: normal, cold load, fallback, link, profiles, corruption, new game passed");
+    return 0;
+}
