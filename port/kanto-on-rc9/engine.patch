new file mode 100644
index 000000000..c7cf71f48
--- /dev/null
+++ b/include/constants/region_state.h
@@ -0,0 +1,41 @@
+#ifndef GUARD_CONSTANTS_REGION_STATE_H
+#define GUARD_CONSTANTS_REGION_STATE_H
+
+/* Experimental native cohort only. No default or GBA save layout changes. */
+#ifndef EW_REGION_STATE
+#define EW_REGION_STATE 0
+#endif
+#if EW_REGION_STATE && !defined(PORTABLE)
+#error EW_REGION_STATE requires the native portable engine
+#endif
+
+#ifndef EW_KANTO_CONTENT
+#define EW_KANTO_CONTENT 0
+#endif
+#if EW_KANTO_CONTENT && (!EW_REGION_STATE || !defined(PORTABLE))
+#error EW_KANTO_CONTENT requires native regional progression
+#endif
+
+/* Outside the original FRLG flags. Persisted only in the extension bank. */
+#define FLAG_KANTO_STORY_INITIALIZED 0x1FFF
+/* This name exists in both regions. Never replace its Hoenn definition. */
+#define FLAG_KANTO_HIDE_DEOXYS KANTO_SCENE_FLAG(0x099)
+
+#define KANTO_VARS_START 0x5000
+#define KANTO_VARS_COUNT 0x100
+#define KANTO_FLAGS_START 0x1000
+#define KANTO_FLAGS_COUNT 0x1000
+
+/* These are named mappings, not a runtime reinterpretation of overlapping
+ * Emerald IDs. Shared system flags (Dex, badges, etc.) are unchanged.
+ * Named FireRed state uses the original FireRed IDs in its own bank.
+ */
+#if EW_REGION_STATE
+#define KANTO_SCENE_VAR(id) (KANTO_VARS_START + (id) - 0x4000)
+#define KANTO_SCENE_FLAG(id) (KANTO_FLAGS_START + (id))
+#else
+#define KANTO_SCENE_VAR(id) (id)
+#define KANTO_SCENE_FLAG(id) 0
+#endif
+
+#endif
