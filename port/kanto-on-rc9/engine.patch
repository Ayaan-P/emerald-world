diff --git a/platform/region_state.c b/platform/region_state.c
new file mode 100644
index 000000000..34fa47c5e
--- /dev/null
+++ b/platform/region_state.c
@@ -0,0 +1,65 @@
+#include "region_state.h"
+#include "save_extension.h"
+
+#include <string.h>
+
+#define FLAGS_SIZE (KANTO_FLAGS_COUNT / 8)
+#define PAYLOAD_SIZE (KANTO_VARS_COUNT * 2 + FLAGS_SIZE)
+_Static_assert(PAYLOAD_SIZE <= SAVE_EXTENSION_PAYLOAD_MAX, "Regional state fits the native extension");
+
+static uint16_t vars[KANTO_VARS_COUNT];
+static uint8_t flags[FLAGS_SIZE];
+static bool ready;
+
+void region_state_new_game(void)
+{
+    memset(vars, 0, sizeof vars);
+    memset(flags, 0, sizeof flags);
+    ready = true;
+}
+
+uint16_t *region_state_var(uint16_t id)
+{
+    if (!ready || id < KANTO_VARS_START || id >= KANTO_VARS_START + KANTO_VARS_COUNT)
+        return NULL;
+    return &vars[id - KANTO_VARS_START];
+}
+
+uint8_t *region_state_flag(uint16_t id)
+{
+    if (!ready || id < KANTO_FLAGS_START || id >= KANTO_FLAGS_START + KANTO_FLAGS_COUNT)
+        return NULL;
+    return &flags[(id - KANTO_FLAGS_START) / 8];
+}
+
+bool region_state_capture(uint32_t counter)
+{
+    if (!ready)
+        return false;
+    uint8_t payload[PAYLOAD_SIZE];
+    for (unsigned i = 0; i < KANTO_VARS_COUNT; i++) {
+        payload[2 * i] = (uint8_t)vars[i];
+        payload[2 * i + 1] = (uint8_t)(vars[i] >> 8);
+    }
+    memcpy(payload + KANTO_VARS_COUNT * 2, flags, sizeof flags);
+    return save_extension_capture(counter, REGION_STATE_SCHEMA, payload, sizeof payload);
+}
+
+bool region_state_restore(uint32_t counter)
+{
+    uint8_t payload[PAYLOAD_SIZE];
+    size_t size = 0;
+    const enum save_extension_status status = save_extension_restore(counter, REGION_STATE_SCHEMA,
+                                                                      payload, sizeof payload, &size);
+    region_state_new_game();
+    if (status == SAVE_EXTENSION_ABSENT)
+        return true; /* A legacy save has never had regional progression. */
+    if (status != SAVE_EXTENSION_OK || size != sizeof payload) {
+        ready = false; /* No stale state and no writes after a failed restore. */
+        return false;
+    }
+    for (unsigned i = 0; i < KANTO_VARS_COUNT; i++)
+        vars[i] = (uint16_t)((uint16_t)payload[2 * i] | (uint16_t)payload[2 * i + 1] << 8);
+    memcpy(flags, payload + KANTO_VARS_COUNT * 2, sizeof flags);
+    return true;
+}
diff --git a/platform/region_state.h b/platform/region_state.h
new file mode 100644
index 000000000..c44027a35
--- /dev/null
+++ b/platform/region_state.h
@@ -0,0 +1,19 @@
+#ifndef REGION_STATE_H
+#define REGION_STATE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "constants/region_state.h"
+
+#define REGION_STATE_SCHEMA UINT32_C(0x4B4E5401)
+
+/* Current trainer's working state. New game clears this, not the archived
+ * fallback save. save_file init/load/shutdown isolate different profiles.
+ */
+void region_state_new_game(void);
+uint16_t *region_state_var(uint16_t id);
+uint8_t *region_state_flag(uint16_t id);
+bool region_state_capture(uint32_t counter);
+bool region_state_restore(uint32_t counter);
+
+#endif
diff --git a/platform/save_extension.c b/platform/save_extension.c
new file mode 100644
index 000000000..bf679e2ec
--- /dev/null
+++ b/platform/save_extension.c
@@ -0,0 +1,127 @@
+#include "save_extension.h"
+
+#include <string.h>
+
+static const uint8_t magic[8] = {'E', 'W', 'S', 'X', '0', '0', '0', '1'};
+
+struct snapshot {
+    uint32_t counter;
+    uint32_t schema;
+    size_t size;
+    uint8_t payload[SAVE_EXTENSION_PAYLOAD_MAX];
+};
+
+static struct snapshot snapshots[SAVE_EXTENSION_SLOTS];
+
+static uint32_t get_u32(const uint8_t *bytes)
+{
+    return (uint32_t)bytes[0] | (uint32_t)bytes[1] << 8 | (uint32_t)bytes[2] << 16
+           | (uint32_t)bytes[3] << 24;
+}
+
+static void put_u32(uint8_t *bytes, uint32_t value)
+{
+    for (unsigned i = 0; i < 4; i++)
+        bytes[i] = (uint8_t)(value >> (8u * i));
+}
+
+void save_extension_reset(void)
+{
+    memset(snapshots, 0, sizeof snapshots);
+}
+
+bool save_extension_has_schema(uint32_t schema)
+{
+    for (unsigned i = 0; i < SAVE_EXTENSION_SLOTS; i++)
+        if (snapshots[i].size != 0 && snapshots[i].schema == schema)
+            return true;
+    return false;
+}
+
+bool save_extension_capture(uint32_t counter, uint32_t schema, const void *payload, size_t size)
+{
+    if (schema == 0 || payload == NULL || size == 0 || size > SAVE_EXTENSION_PAYLOAD_MAX)
+        return false;
+    struct snapshot *const slot = &snapshots[counter % SAVE_EXTENSION_SLOTS];
+    memcpy(slot->payload, payload, size);
+    slot->counter = counter;
+    slot->schema = schema;
+    slot->size = size;
+    return true;
+}
+
+enum save_extension_status save_extension_restore(uint32_t counter, uint32_t schema,
+                                                  void *payload, size_t capacity, size_t *size)
+{
+    if (schema == 0 || payload == NULL || size == NULL)
+        return SAVE_EXTENSION_BAD_ARGUMENT;
+    const struct snapshot *const slot = &snapshots[counter % SAVE_EXTENSION_SLOTS];
+    if (slot->size == 0)
+        return SAVE_EXTENSION_ABSENT;
+    if (slot->counter != counter || slot->schema != schema)
+        return SAVE_EXTENSION_MISMATCH;
+    if (capacity < slot->size)
+        return SAVE_EXTENSION_BAD_ARGUMENT;
+    memcpy(payload, slot->payload, slot->size);
+    *size = slot->size;
+    return SAVE_EXTENSION_OK;
+}
+
+size_t save_extension_encoded_size(void)
+{
+    size_t size = 0;
+    for (unsigned i = 0; i < SAVE_EXTENSION_SLOTS; i++)
+        size += snapshots[i].size;
+    return size == 0 ? 0 : sizeof magic + SAVE_EXTENSION_SLOTS * 12u + size;
+}
+
+bool save_extension_encode(uint8_t *bytes, size_t size)
+{
+    if (bytes == NULL || size == 0 || size != save_extension_encoded_size())
+        return false;
+    memcpy(bytes, magic, sizeof magic);
+    size_t offset = sizeof magic;
+    for (unsigned i = 0; i < SAVE_EXTENSION_SLOTS; i++) {
+        const struct snapshot *const slot = &snapshots[i];
+        put_u32(bytes + offset, slot->counter);
+        put_u32(bytes + offset + 4, slot->schema);
+        put_u32(bytes + offset + 8, (uint32_t)slot->size);
+        memcpy(bytes + offset + 12, slot->payload, slot->size);
+        offset += 12 + slot->size;
+    }
+    return true;
+}
+
+bool save_extension_decode(const uint8_t *bytes, size_t size)
+{
+    if (bytes == NULL || size < sizeof magic || size > SAVE_EXTENSION_ENCODED_MAX
+        || memcmp(bytes, magic, sizeof magic) != 0)
+        return false;
+    size_t offsets[SAVE_EXTENSION_SLOTS];
+    size_t offset = sizeof magic;
+    bool present = false;
+    for (unsigned i = 0; i < SAVE_EXTENSION_SLOTS; i++) {
+        if (size - offset < 12)
+            return false;
+        const uint32_t counter = get_u32(bytes + offset);
+        const uint32_t schema = get_u32(bytes + offset + 4);
+        const uint32_t length = get_u32(bytes + offset + 8);
+        if (length > SAVE_EXTENSION_PAYLOAD_MAX || length > size - offset - 12)
+            return false;
+        if (length == 0 ? counter != 0 || schema != 0 : schema == 0 || counter % SAVE_EXTENSION_SLOTS != i)
+            return false;
+        present |= length != 0;
+        offsets[i] = offset;
+        offset += 12 + length;
+    }
+    if (!present || offset != size)
+        return false;
+    save_extension_reset();
+    for (unsigned i = 0; i < SAVE_EXTENSION_SLOTS; i++) {
+        const uint8_t *const record = bytes + offsets[i];
+        const uint32_t length = get_u32(record + 8);
+        if (length != 0)
+            (void)save_extension_capture(get_u32(record), get_u32(record + 4), record + 12, length);
+    }
+    return true;
+}
