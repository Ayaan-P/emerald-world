diff --git a/platform/test/test_save_extension.c b/platform/test/test_save_extension.c
new file mode 100644
index 000000000..d943f4f98
--- /dev/null
+++ b/platform/test/test_save_extension.c
@@ -0,0 +1,108 @@
+#include "ptest.h"
+#include "save_extension.h"
+
+static uint8_t encoded[SAVE_EXTENSION_ENCODED_MAX];
+static uint8_t payload[SAVE_EXTENSION_PAYLOAD_MAX];
+static uint8_t restored[SAVE_EXTENSION_PAYLOAD_MAX];
+
+PTEST(empty_state_keeps_legacy_format)
+{
+    save_extension_reset();
+    size_t size = 99;
+    PT_ASSERT_EQ_U32(save_extension_encoded_size(), 0);
+    PT_ASSERT_EQ_INT(save_extension_restore(1, 1, restored, sizeof restored, &size), SAVE_EXTENSION_ABSENT);
+    PT_ASSERT_EQ_U32(size, 99);
+    PT_ASSERT(!save_extension_encode(encoded, 0));
+}
+
+PTEST(full_capacity_snapshots_are_independent_and_round_trip)
+{
+    save_extension_reset();
+    memset(payload, 0x12, sizeof payload);
+    PT_ASSERT(save_extension_capture(1, 7, payload, sizeof payload));
+    memset(payload, 0x34, sizeof payload);
+    PT_ASSERT(save_extension_capture(2, 7, payload, sizeof payload));
+    memset(payload, 0x56, sizeof payload); /* Unsaved edits cannot change a capture. */
+    const size_t length = save_extension_encoded_size();
+    PT_ASSERT_EQ_U32(length, SAVE_EXTENSION_ENCODED_MAX);
+    PT_ASSERT(save_extension_encode(encoded, length));
+    save_extension_reset();
+    PT_ASSERT(save_extension_decode(encoded, length));
+    size_t size = 0;
+    PT_ASSERT_EQ_INT(save_extension_restore(1, 7, restored, sizeof restored, &size), SAVE_EXTENSION_OK);
+    PT_ASSERT_EQ_U32(size, sizeof restored);
+    for (size_t i = 0; i < size; i++)
+        PT_ASSERT_EQ_U32(restored[i], 0x12);
+    PT_ASSERT_EQ_INT(save_extension_restore(2, 7, restored, sizeof restored, &size), SAVE_EXTENSION_OK);
+    for (size_t i = 0; i < size; i++)
+        PT_ASSERT_EQ_U32(restored[i], 0x34);
+}
+
+PTEST(counter_schema_and_capacity_fail_without_modifying_output)
+{
+    save_extension_reset();
+    PT_ASSERT(save_extension_capture(3, 9, "first", 6));
+    memset(restored, 0x55, sizeof restored);
+    size_t size = 123;
+    PT_ASSERT_EQ_INT(save_extension_restore(1, 9, restored, sizeof restored, &size), SAVE_EXTENSION_MISMATCH);
+    PT_ASSERT_EQ_INT(save_extension_restore(3, 10, restored, sizeof restored, &size), SAVE_EXTENSION_MISMATCH);
+    PT_ASSERT_EQ_INT(save_extension_restore(3, 9, restored, 5, &size), SAVE_EXTENSION_BAD_ARGUMENT);
+    PT_ASSERT_EQ_U32(size, 123);
+    PT_ASSERT_EQ_U32(restored[0], 0x55);
+    PT_ASSERT(!save_extension_capture(3, 0, "bad", 4));
+    PT_ASSERT(!save_extension_capture(3, 9, NULL, 4));
+    PT_ASSERT(!save_extension_capture(3, 9, payload, SAVE_EXTENSION_PAYLOAD_MAX + 1));
+    PT_ASSERT(!save_extension_capture(3, 9, payload, 0));
+    PT_ASSERT_EQ_INT(save_extension_restore(3, 9, restored, sizeof restored, &size), SAVE_EXTENSION_OK);
+    PT_ASSERT_MEM_EQ(restored, "first", 6);
+}
+
+PTEST(counter_wrap_preserves_the_other_recovery_slot)
+{
+    save_extension_reset();
+    PT_ASSERT(save_extension_capture(UINT32_MAX, 1, "before", 7));
+    PT_ASSERT(save_extension_capture(0, 1, "after", 6));
+    size_t size = 0;
+    PT_ASSERT_EQ_INT(save_extension_restore(UINT32_MAX, 1, restored, sizeof restored, &size), SAVE_EXTENSION_OK);
+    PT_ASSERT_MEM_EQ(restored, "before", 7);
+    PT_ASSERT_EQ_INT(save_extension_restore(0, 1, restored, sizeof restored, &size), SAVE_EXTENSION_OK);
+    PT_ASSERT_MEM_EQ(restored, "after", 6);
+}
+
+PTEST(every_truncation_is_rejected_without_replacing_existing_state)
+{
+    save_extension_reset();
+    PT_ASSERT(save_extension_capture(2, 3, "abc", 4));
+    PT_ASSERT(save_extension_capture(3, 3, "def", 4));
+    const size_t size = save_extension_encoded_size();
+    PT_ASSERT(save_extension_encode(encoded, size));
+    for (size_t end = 0; end < size; end++)
+        PT_ASSERT(!save_extension_decode(encoded, end));
+    size_t restored_size = 0;
+    PT_ASSERT_EQ_INT(save_extension_restore(3, 3, restored, sizeof restored, &restored_size), SAVE_EXTENSION_OK);
+    PT_ASSERT_MEM_EQ(restored, "def", 4);
+}
+
+PTEST(invalid_versions_lengths_slots_and_trailing_bytes_are_rejected)
+{
+    save_extension_reset();
+    PT_ASSERT(save_extension_capture(2, 3, "abc", 4));
+    const size_t size = save_extension_encoded_size();
+    PT_ASSERT(save_extension_encode(encoded, size));
+    encoded[7] = '2';
+    PT_ASSERT(!save_extension_decode(encoded, size));
+    PT_ASSERT(save_extension_encode(encoded, size));
+    encoded[8] = 3; /* Odd counter in the even slot. */
+    PT_ASSERT(!save_extension_decode(encoded, size));
+    PT_ASSERT(save_extension_encode(encoded, size));
+    memset(encoded + 16, 0xff, 4);
+    PT_ASSERT(!save_extension_decode(encoded, size));
+    PT_ASSERT(save_extension_encode(encoded, size));
+    encoded[size] = 0;
+    PT_ASSERT(!save_extension_decode(encoded, size + 1));
+    PT_ASSERT(save_extension_encode(encoded, size));
+    encoded[24] = 1; /* Empty slot with nonzero counter. */
+    PT_ASSERT(!save_extension_decode(encoded, size));
+}
+
+PTEST_MAIN()
