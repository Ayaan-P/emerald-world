+/* Optional native save payloads, owned by the currently open trainer profile.
+ * No disk I/O here: save_file writes these with the flash image atomically.
+ * Capture only a successful game-save snapshot, never live unsaved state.
+ * Restore with the counter selected by the game's normal slot recovery.
+ * Schemas belong to callers and must change if their payload layout changes.
+ */
+#ifndef SAVE_EXTENSION_H
+#define SAVE_EXTENSION_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define SAVE_EXTENSION_SLOTS 2u
+#define SAVE_EXTENSION_PAYLOAD_MAX 8192u
+#define SAVE_EXTENSION_ENCODED_MAX (8u + SAVE_EXTENSION_SLOTS * (12u + SAVE_EXTENSION_PAYLOAD_MAX))
+
+enum save_extension_status {
+    SAVE_EXTENSION_OK,
+    SAVE_EXTENSION_ABSENT,       /* A legacy slot has no regional state. */
+    SAVE_EXTENSION_MISMATCH,     /* Never pair another counter/schema's data. */
+    SAVE_EXTENSION_BAD_ARGUMENT,
+};
+
+void save_extension_reset(void);
+bool save_extension_has_schema(uint32_t schema);
+bool save_extension_capture(uint32_t counter, uint32_t schema, const void *payload, size_t size);
+enum save_extension_status save_extension_restore(uint32_t counter, uint32_t schema,
+                                                  void *payload, size_t capacity, size_t *size);
+/* Zero means no extension: ordinary profiles keep the version-1 file format. */
+size_t save_extension_encoded_size(void);
+bool save_extension_encode(uint8_t *bytes, size_t size);
+/* Validate the whole input before replacing state; rejects trailing bytes. */
+bool save_extension_decode(const uint8_t *bytes, size_t size);
+
+#endif
