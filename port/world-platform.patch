diff --git a/include/platform/settings.h b/include/platform/settings.h
new file mode 100644
index 0000000000..33b1a61de0
--- /dev/null
+++ b/include/platform/settings.h
@@ -0,0 +1,32 @@
+#ifndef GUARD_PLATFORM_SETTINGS_H
+#define GUARD_PLATFORM_SETTINGS_H
+
+#include <stdbool.h>
+#include <SDL2/SDL.h>
+#include "gba/types.h"
+
+struct Settings
+{
+    int scale;
+    bool fullscreen;
+};
+
+extern struct Settings gSettings;
+
+// Reads the settings file. If it doesn't exist, it gets written with the defaults.
+void LoadSettings(const char *path);
+
+// Opens and closes controllers as they come and go
+void Input_HandleEvent(const SDL_Event *event);
+// The GBA buttons held on the keyboard and the controllers, as KEYINPUT bits
+u16 Input_GetButtons(bool *speedUp);
+// Includes every loaded game and fast-forward binding, not just defaults.
+bool Input_KeyIsBound(SDL_Scancode key);
+
+// The headless test mode's keyboard and controller. Input names are "key:" and
+// a key, or "pad:" and a controller input, like in the settings file.
+void Input_ReleaseTestInputs(void);
+bool Input_PressTestInput(const char *name);
+u16 Input_GetTestButtons(void);
+
+#endif // GUARD_PLATFORM_SETTINGS_H
diff --git a/platform/input.c b/platform/input.c
index 9def3ef3f3..d4cea199df 100644
--- a/platform/input.c
+++ b/platform/input.c
@@ -326,3 +326,12 @@ int input_handle_event(const union SDL_Event *event)
         close_controller(event->cdevice.which);
     return 0;
 }
+
+bool Input_KeyIsBound(SDL_Scancode key)
+{
+    if (key <= SDL_SCANCODE_UNKNOWN || key >= SDL_NUM_SCANCODES) return false;
+    struct input_keymap map = state.initialised ? state.keymap : input_default_keymap();
+    for (size_t i = 0; i < INPUT_BUTTON_COUNT; ++i)
+        if (map.scancodes[i] == key) return true;
+    return false;
+}
