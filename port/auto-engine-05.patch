+        for (j = 0; j < MULTI_PARTY_SIZE && sCoop.roster.staged[j] != i; j++);
+        if (j == MULTI_PARTY_SIZE && MonValid(&sCoop.working[i], FALSE)
+         && !GetMonData(&sCoop.working[i], MON_DATA_IS_EGG)
+         && GetMonData(&sCoop.working[i], MON_DATA_HP)) return TRUE;
+    }
+    return FALSE;
+}
