@@ -0,0 +1,32 @@
+#ifdef PORTABLE
+#include "global.h"
+#include "platform/world_rules_wire.h"
+#include <string.h>
+
+static bool8 ParseUnsigned(const char *text, unsigned maximum, unsigned *value)
+{
+    unsigned n = 0;
+    if (!text || !*text) return FALSE;
+    while (*text) {
+        unsigned d;
+        if (*text < '0' || *text > '9') return FALSE;
+        d = (unsigned)(*text++ - '0');
+        if (d > maximum || n > (maximum - d) / 10) return FALSE;
+        n = n * 10 + d;
+    }
+    *value = n;
+    return TRUE;
+}
+
+bool8 WorldRules_ParseWire(unsigned count, char **tokens, unsigned *revision, unsigned *enabled, unsigned *seed)
+{
+    unsigned r, e, s;
+    if (count != 5 || !tokens || !revision || !enabled || !seed || !tokens[0] || !tokens[1]
+     || strcmp(tokens[0], "RULES") || strcmp(tokens[1], "1")
+     || !ParseUnsigned(tokens[2], 2147483647U, &r)
+     || !ParseUnsigned(tokens[3], 1, &e)
+     || !ParseUnsigned(tokens[4], 20, &s) || s == 0) return FALSE;
+    *revision = r; *enabled = e; *seed = s;
+    return TRUE;
+}
+#endif
