@@ -0,0 +1,223 @@
+/* Real atomic files and flash backend, no game, SDL calls, or sockets. */
+// deps: save_file.c gba_memmap.c flash.c
+#include "save_file_fixture.h"
+#include "save_extension.h"
+
+static uint8_t extended_file[FILE_BYTES + 8 + SAVE_EXTENSION_ENCODED_MAX];
+
+static bool read_extended(const char *path, size_t *size)
+{
+    FILE *const file = fopen(path, "rb");
+    if (file == NULL)
+        return false;
+    *size = fread(extended_file, 1, sizeof extended_file, file);
+    const bool ok = !ferror(file) && fgetc(file) == EOF;
+    return fclose(file) == 0 && ok;
+}
+
+PTEST(extended_file_cold_load_restores_both_counter_snapshots_and_original_flash)
+{
+    struct scratch scratch;
+    PT_ASSERT(scratch_create(&scratch));
+    set_image(0x11);
+    PT_ASSERT_EQ_INT(save_file_init(scratch.path), SAVE_FILE_OK);
+    PT_ASSERT(save_extension_capture(8, 1, "Kanto before", 13));
+    PT_ASSERT(save_extension_capture(9, 1, "Kanto after", 12));
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_OK);
+    size_t size = 0;
+    PT_ASSERT(read_extended(scratch.path, &size));
+    PT_ASSERT_MEM_EQ(extended_file, "PENSAV2\0", 8);
+    PT_ASSERT_EQ_U32(get_u32le(extended_file + 8), 2);
+    PT_ASSERT_MEM_EQ(extended_file + HEADER_BYTES, expected_image, CHIP_BYTES);
+    save_file_shutdown();
+    flash_erase_image();
+    PT_ASSERT_EQ_INT(save_file_init(scratch.path), SAVE_FILE_OK);
+    PT_ASSERT_EQ_INT(save_file_load(), SAVE_FILE_OK);
+    PT_ASSERT(image_is_expected());
+    uint8_t payload[32];
+    /* The game can select the older slot after an interrupted newer save. */
+    PT_ASSERT_EQ_INT(save_extension_restore(8, 1, payload, sizeof payload, &size), SAVE_EXTENSION_OK);
+    PT_ASSERT_MEM_EQ(payload, "Kanto before", 13);
+    PT_ASSERT_EQ_INT(save_extension_restore(9, 1, payload, sizeof payload, &size), SAVE_EXTENSION_OK);
+    PT_ASSERT_MEM_EQ(payload, "Kanto after", 12);
+    PT_ASSERT_EQ_INT(save_extension_restore(7, 1, payload, sizeof payload, &size), SAVE_EXTENSION_MISMATCH);
+    save_file_shutdown();
+    PT_ASSERT(scratch_remove(&scratch));
+}
+
+PTEST(trainer_profiles_do_not_inherit_each_others_extension)
+{
+    struct scratch a, b;
+    PT_ASSERT(scratch_create(&a));
+    PT_ASSERT(scratch_create(&b));
+    set_image(0x22);
+    PT_ASSERT_EQ_INT(save_file_init(a.path), SAVE_FILE_OK);
+    PT_ASSERT(save_extension_capture(1, 1, "trainer A", 10));
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_OK);
+    PT_ASSERT_EQ_INT(save_file_init(b.path), SAVE_FILE_OK);
+    PT_ASSERT_EQ_INT(save_file_load(), SAVE_FILE_NEW);
+    PT_ASSERT_EQ_U32(save_extension_encoded_size(), 0);
+    PT_ASSERT(save_extension_capture(1, 1, "trainer B", 10));
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_OK);
+    PT_ASSERT_EQ_INT(save_file_init(a.path), SAVE_FILE_OK);
+    PT_ASSERT_EQ_INT(save_file_load(), SAVE_FILE_OK);
+    char payload[16];
+    size_t size = 0;
+    PT_ASSERT_EQ_INT(save_extension_restore(1, 1, payload, sizeof payload, &size), SAVE_EXTENSION_OK);
+    PT_ASSERT_MEM_EQ(payload, "trainer A", 10);
+    PT_ASSERT_EQ_INT(save_file_init(b.path), SAVE_FILE_OK);
+    PT_ASSERT_EQ_INT(save_file_load(), SAVE_FILE_OK);
+    PT_ASSERT_EQ_INT(save_extension_restore(1, 1, payload, sizeof payload, &size), SAVE_EXTENSION_OK);
+    PT_ASSERT_MEM_EQ(payload, "trainer B", 10);
+    save_file_shutdown();
+    PT_ASSERT(scratch_remove(&a));
+    PT_ASSERT(scratch_remove(&b));
+}
+
+PTEST(legacy_load_is_empty_and_legacy_store_stays_byte_identical)
+{
+    struct scratch scratch;
+    PT_ASSERT(scratch_create(&scratch));
+    set_image(0x33);
+    build_file(native_pointer_bits(), SAVE_FILE_LAYOUT_ID);
+    PT_ASSERT(write_file(scratch.path, file_bytes, FILE_BYTES));
+    PT_ASSERT_EQ_INT(save_file_init(scratch.path), SAVE_FILE_OK);
+    PT_ASSERT(save_extension_capture(2, 1, "not from this file", 19));
+    PT_ASSERT_EQ_INT(save_file_load(), SAVE_FILE_OK);
+    PT_ASSERT_EQ_U32(save_extension_encoded_size(), 0);
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_OK);
+    size_t size = 0;
+    PT_ASSERT(read_extended(scratch.path, &size));
+    PT_ASSERT_EQ_U32(size, FILE_BYTES);
+    PT_ASSERT_MEM_EQ(extended_file, file_bytes, FILE_BYTES);
+    save_file_shutdown();
+    PT_ASSERT(scratch_remove(&scratch));
+}
+
+PTEST(failed_atomic_replace_keeps_the_prior_extension)
+{
+    struct scratch scratch;
+    PT_ASSERT(scratch_create(&scratch));
+    set_image(0x44);
+    PT_ASSERT_EQ_INT(save_file_init(scratch.path), SAVE_FILE_OK);
+    PT_ASSERT(save_extension_capture(1, 1, "old", 4));
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_OK);
+    PT_ASSERT(save_extension_capture(2, 1, "new", 4));
+    PT_ASSERT(tsup_make_directory(scratch.tmp));
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_ERR_IO);
+    PT_ASSERT(tsup_remove_directory(scratch.tmp));
+    save_file_shutdown();
+    PT_ASSERT_EQ_INT(save_file_init(scratch.path), SAVE_FILE_OK);
+    PT_ASSERT_EQ_INT(save_file_load(), SAVE_FILE_OK);
+    char payload[8];
+    size_t size = 0;
+    PT_ASSERT_EQ_INT(save_extension_restore(1, 1, payload, sizeof payload, &size), SAVE_EXTENSION_OK);
+    PT_ASSERT_MEM_EQ(payload, "old", 4);
+    PT_ASSERT_EQ_INT(save_extension_restore(2, 1, payload, sizeof payload, &size), SAVE_EXTENSION_ABSENT);
+    save_file_shutdown();
+    PT_ASSERT(scratch_remove(&scratch));
+}
+
+PTEST(corrupt_extension_is_erased_in_memory_and_never_overwritten)
+{
+    struct scratch scratch;
+    PT_ASSERT(scratch_create(&scratch));
+    set_image(0x55);
+    PT_ASSERT_EQ_INT(save_file_init(scratch.path), SAVE_FILE_OK);
+    PT_ASSERT(save_extension_capture(1, 1, "state", 6));
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_OK);
+    size_t size = 0;
+    PT_ASSERT(read_extended(scratch.path, &size));
+    extended_file[size - 1] ^= 1;
+    const uint32_t corrupt_crc = save_file_crc32(extended_file, size);
+    PT_ASSERT(write_file(scratch.path, extended_file, size));
+    PT_ASSERT_EQ_INT(save_file_load(), SAVE_FILE_CORRUPT);
+    PT_ASSERT(image_is_erased());
+    PT_ASSERT_EQ_U32(save_extension_encoded_size(), 0);
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_REFUSED);
+    PT_ASSERT(read_extended(scratch.path, &size));
+    PT_ASSERT_EQ_U32(save_file_crc32(extended_file, size), corrupt_crc);
+    save_file_shutdown();
+    PT_ASSERT(scratch_remove(&scratch));
+}
+
+PTEST(full_capacity_extension_survives_cold_load)
+{
+    static uint8_t payload[SAVE_EXTENSION_PAYLOAD_MAX];
+    static uint8_t restored[SAVE_EXTENSION_PAYLOAD_MAX];
+    struct scratch scratch;
+    PT_ASSERT(scratch_create(&scratch));
+    set_image(0x66);
+    PT_ASSERT_EQ_INT(save_file_init(scratch.path), SAVE_FILE_OK);
+    memset(payload, 0xA5, sizeof payload);
+    PT_ASSERT(save_extension_capture(2, 1, payload, sizeof payload));
+    memset(payload, 0x5A, sizeof payload);
+    PT_ASSERT(save_extension_capture(3, 1, payload, sizeof payload));
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_OK);
+    save_file_shutdown();
+    PT_ASSERT_EQ_INT(save_file_init(scratch.path), SAVE_FILE_OK);
+    PT_ASSERT_EQ_INT(save_file_load(), SAVE_FILE_OK);
+    size_t size = 0;
+    PT_ASSERT_EQ_INT(save_extension_restore(3, 1, restored, sizeof restored, &size), SAVE_EXTENSION_OK);
+    PT_ASSERT_EQ_U32(size, sizeof payload);
+    PT_ASSERT_MEM_EQ(restored, payload, sizeof payload);
+    memset(payload, 0xA5, sizeof payload);
+    PT_ASSERT_EQ_INT(save_extension_restore(2, 1, restored, sizeof restored, &size), SAVE_EXTENSION_OK);
+    PT_ASSERT_MEM_EQ(restored, payload, sizeof payload);
+    save_file_shutdown();
+    PT_ASSERT(scratch_remove(&scratch));
+}
+
+PTEST(unknown_extension_version_and_bad_lengths_cannot_be_overwritten)
+{
+    struct scratch scratch;
+    PT_ASSERT(scratch_create(&scratch));
+    set_image(0x77);
+    PT_ASSERT_EQ_INT(save_file_init(scratch.path), SAVE_FILE_OK);
+    PT_ASSERT(save_extension_capture(1, 1, "state", 6));
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_OK);
+    size_t size = 0;
+    PT_ASSERT(read_extended(scratch.path, &size));
+    put_u32le(extended_file + 8, 3);
+    PT_ASSERT(write_file(scratch.path, extended_file, size));
+    PT_ASSERT_EQ_INT(save_file_load(), SAVE_FILE_CORRUPT);
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_REFUSED);
+    put_u32le(extended_file + 8, 2);
+    const uint32_t length = get_u32le(extended_file + FILE_BYTES);
+    put_u32le(extended_file + FILE_BYTES, UINT32_MAX);
+    PT_ASSERT(write_file(scratch.path, extended_file, size));
+    PT_ASSERT_EQ_INT(save_file_load(), SAVE_FILE_CORRUPT);
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_REFUSED);
+    put_u32le(extended_file + FILE_BYTES, length);
+    extended_file[FILE_BYTES + 8 + 7] = '2'; /* Unknown inner schema, correct CRC. */
+    put_u32le(extended_file + FILE_BYTES + 4, save_file_crc32(extended_file + FILE_BYTES + 8, length));
+    PT_ASSERT(write_file(scratch.path, extended_file, size));
+    PT_ASSERT_EQ_INT(save_file_load(), SAVE_FILE_CORRUPT);
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_REFUSED);
+    save_file_shutdown();
+    PT_ASSERT(scratch_remove(&scratch));
+}
+
+PTEST(foreign_pointer_width_retains_width_independent_extension)
+{
+    struct scratch scratch;
+    PT_ASSERT(scratch_create(&scratch));
+    set_image(0x88);
+    PT_ASSERT_EQ_INT(save_file_init(scratch.path), SAVE_FILE_OK);
+    PT_ASSERT(save_extension_capture(1, 4, "portable", 9));
+    PT_ASSERT_EQ_INT(save_file_store(), SAVE_FILE_OK);
+    size_t size = 0;
+    PT_ASSERT(read_extended(scratch.path, &size));
+    put_u32le(extended_file + POINTER_BITS_OFFSET, other_pointer_bits());
+    PT_ASSERT(write_file(scratch.path, extended_file, size));
+    save_file_shutdown();
+    PT_ASSERT_EQ_INT(save_file_init(scratch.path), SAVE_FILE_OK);
+    PT_ASSERT_EQ_INT(save_file_load(), SAVE_FILE_FOREIGN_LAYOUT);
+    char payload[16];
+    PT_ASSERT_EQ_INT(save_extension_restore(1, 4, payload, sizeof payload, &size), SAVE_EXTENSION_OK);
+    PT_ASSERT_MEM_EQ(payload, "portable", 9);
+    save_file_shutdown();
+    PT_ASSERT(scratch_remove(&scratch));
+}
+
+PTEST_MAIN()
